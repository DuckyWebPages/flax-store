---
import BaseLayout from "../layouts/BaseLayout.astro";
const title = "Checkout Canceled";
---
<BaseLayout>
  <main style="max-width: 680px; margin: 40px auto; padding: 0 16px; text-align:center;">
    <h1>{title}</h1>
    <p>Your checkout was canceled. Your cart is still saved.</p>
    <p><a href="/products">Back to products</a></p>
  </main>
</BaseLayout>
