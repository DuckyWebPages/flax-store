---
import BaseLayout from '@/layouts/BaseLayout.astro';
const pageTitle = 'Home — ';
---

<BaseLayout>
  <Fragment slot="title">{pageTitle}</Fragment>

  <!-- === Category Bar (centered heading) === -->
  <section class="category-bar" aria-label="Shop by category">
    <div class="cat-wrap">
      <h2 class="cat-heading">Top Selling Products</h2>
      <div class="cat-grid">
        <a href="/products/flax-hull-lignans" class="cat-item">
          <span class="cat-thumb"><img src="/images/flaxhull.png" alt="Flax Hull Lignans" /></span>
          <span class="cat-label">Flax Hull Lignans</span>
        </a>
        <a href="/products/ocean-cleanse" class="cat-item">
          <span class="cat-thumb"><img src="/images/oceancleanse.png" alt="Ocean Cleanse" /></span>
          <span class="cat-label">Ocean Cleanse</span>
        </a>
        <a href="/products/essiac-tea" class="cat-item">
          <span class="cat-thumb"><img src="/images/essiac-tea.png" alt="Essiac Tea" /></span>
          <span class="cat-label">Essiac Tea</span>
        </a>
        <a href="/products/zeolite" class="cat-item">
          <span class="cat-thumb"><img src="/images/zeolite.png" alt="Aftershot" /></span>
          <span class="cat-label">Aftershot &amp; Zeolite</span>
        </a>
        <a href="/products/essential-oils" class="cat-item">
          <span class="cat-thumb"><img src="/images/eoils.png" alt="Essential Oils" /></span>
          <span class="cat-label">Essential Oils</span>
        </a>
        <a href="/products/other-products" class="cat-item">
          <span class="cat-thumb"><img src="/images/otherprods.png" alt="Other Products" /></span>
          <span class="cat-label">Other Products</span>
        </a>
      </div>
    </div>
  </section>

  <!-- === HERO (logo pinned to top; card directly under) === -->
  <section class="hero" aria-label="Flax Lignan Health hero">
    <img class="hero-bg" src="/images/hero-1600x.jpg?v=3" alt="Sunrise over flax field with farm in the distance" />

    <!-- Pinned logo -->
    <img src="/images/flh-logo-3.png" alt="Flax Lignan Health" class="hero-logo" decoding="async" loading="eager" />

    <!-- Copy card UNDER the logo -->
    <div class="hero-card">
      <p class="hero-text">
        Your research-driven source for natural products promoting health, vitality and immune system support.
        The original FHL Flax Hull Lignans found in international trials around the world.
        Fresh from the USA North Dakota farm to your home. <br />
        <strong>Order online or call <a href="tel:18177106918">817-710-6918</a>.</strong>
      </p>
      <nav class="home-shop-cta" aria-label="Shop">
        <a href="/products" class="cta-btn">Shop</a>
      </nav>
    </div>
  </section>

  <!-- === Constant Contact Signup Banner === -->
  <section class="signup-banner">
    <a href="https://lp.constantcontactpages.com/sl/DjPeNBz" target="_blank" rel="noopener">
      <img src="/images/coupon1.jpg" alt="Sign up for our newsletter" />
    </a>
  </section>

  <style>
    /* ------ Controls ------ */
    :root{
      --hero-logo-h: clamp(220px, 26vw, 360px);  /* BIG on desktop, scales down */
      --hero-gap: 16px;                           /* gap between logo & card */
    }

    /* ===== Category Bar ===== */
    .category-bar{ background:#fff; border-bottom:1px solid #e5e7eb; padding:12px 0; }
    .cat-wrap{ width:min(1200px, 92vw); margin:0 auto; display:flex; flex-direction:column; gap:16px; }
    .cat-heading{ margin:0; font:700 1.6rem/1 var(--font-head); text-align:center; color:#0f172a; } /* centered */
    .cat-grid{ display:grid; grid-template-columns: repeat(6, 1fr); gap:clamp(10px, 2vw, 24px); align-items:center; justify-items:center; }
    .cat-item{ display:flex; flex-direction:column; align-items:center; gap:.6rem; text-decoration:none; color:#0f172a; transition: transform .18s ease; }
    .cat-item:hover{ transform: translateY(-4px); }
    .cat-thumb{ width: clamp(96px, 10vw, 140px); height: clamp(96px, 10vw, 140px); border-radius:50%; overflow:hidden; box-shadow:0 2px 6px rgba(0,0,0,.10); background:#fff; }
    .cat-thumb img{ width:100%; height:100%; object-fit:cover; display:block; }
    @media (max-width:1024px){ .cat-grid{ grid-template-columns: repeat(3, 1fr);} }
    @media (max-width:640px){ .cat-grid{ grid-template-columns: repeat(2, 1fr);} }

    /* ===== Hero (simplified) ===== */
    .hero{
      position:relative; isolation:isolate; overflow:hidden;
      min-height:clamp(520px, 68vh, 900px);
      /* SIMPLE TRICK: pad the top by the logo height + small gap */
      padding: calc(var(--hero-logo-h) + var(--hero-gap)) 12px 48px;
      border-bottom:1px solid #e5e7eb; text-align:center; background:transparent;
    }
    .hero-bg{
      position:absolute; inset:0; width:100%; height:100%;
      object-fit:cover; object-position:center 60%; z-index:-1;
    }

    /* Pin the logo to the very top of the hero */
    .hero-logo{
      position:absolute; top:0; left:50%; transform:translateX(-50%);
      height:var(--hero-logo-h); width:auto; display:block; margin:0;
    }

    /* Card naturally sits below because of hero padding */
    .hero-card{
      width:min(64%, 760px); margin:0 auto;
      background:rgba(255,255,255,.85);
      -webkit-backdrop-filter:blur(6px); backdrop-filter:blur(6px);
      border-radius:12px; padding:14px 18px;
      box-shadow:0 8px 22px rgba(0,0,0,.12);
      color:#0f172a; text-align:center;
    }
    .hero-text{ margin:4px 0 10px; line-height:1.3; }

    .home-shop-cta{ margin-top:10px; display:flex; justify-content:center; }
    .cta-btn{
      display:inline-flex; align-items:center; justify-content:center;
      min-width:140px; padding:12px 18px;
      font:700 16px/1 Inter,system-ui,sans-serif;
      color:#fff; background:#111827; border-radius:9999px;
      box-shadow:0 6px 18px rgba(0,0,0,.18); text-decoration:none;
      transition:transform .08s ease, opacity .15s ease;
    }
    .cta-btn:hover{ opacity:.92; transform:translateY(-1px); }

    @media (max-width:768px){
      :root{ --hero-logo-h: clamp(140px, 36vw, 220px); }
      .hero-card{ width:92%; padding:12px 14px; }
      .hero-text{ font-size:.95rem; }
    }

    /* ===== Signup banner ===== */
    .signup-banner{ margin:20px auto; max-width:1536px; text-align:center; }
    .signup-banner img{ width:100%; height:auto; max-height:260px; object-fit:cover; cursor:pointer; box-shadow:0 2px 6px rgba(0,0,0,.15); transition: transform .18s ease, opacity .18s ease; }
    .signup-banner img:hover{ transform:translateY(-2px); opacity:.95; }
    @media (max-width:640px){ .signup-banner img{ max-height:160px; } }
  </style>
</BaseLayout>
