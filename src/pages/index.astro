---
import BaseLayout from '@/layouts/BaseLayout.astro';
const pageTitle = 'Home — ';
---

<BaseLayout>
  <Fragment slot="title">{pageTitle}</Fragment>

  <!-- === Category Bar (full-width, taller, with heading) === -->
  <section class="category-bar" aria-label="Shop by category">
    <div class="cat-wrap">
      <h2 class="cat-heading">Top Selling Products</h2>
      <div class="cat-grid">
        <a href="/products/flax-hull-lignans" class="cat-item">
          <span class="cat-thumb">
            <img src="/images/flaxhull.png" alt="Flax Hull Lignans" />
          </span>
          <span class="cat-label">Flax Hull Lignans</span>
        </a>

        <a href="/products/ocean-cleanse" class="cat-item">
          <span class="cat-thumb">
            <img src="/images/oceancleanse.png" alt="Ocean Cleanse" />
          </span>
          <span class="cat-label">Ocean Cleanse</span>
        </a>

        <a href="/products/essiac-tea" class="cat-item">
          <span class="cat-thumb">
            <img src="/images/essiac-tea.png" alt="Essiac Tea" />
          </span>
          <span class="cat-label">Essiac Tea</span>
        </a>

        <a href="/products/zeolite" class="cat-item">
          <span class="cat-thumb">
            <img src="/images/zeolite.png" alt="Aftershot" />
          </span>
          <span class="cat-label">Aftershot &amp; Zeolite</span>
        </a>

        <a href="/products/essential-oils" class="cat-item">
          <span class="cat-thumb">
            <img src="/images/eoils.png" alt="Essential Oils" />
          </span>
          <span class="cat-label">Essential Oils</span>
        </a>

        <a href="/products/other-products" class="cat-item">
          <span class="cat-thumb">
            <img src="/images/otherprods.png" alt="Other Products" />
          </span>
          <span class="cat-label">Other Products</span>
        </a>
      </div>
    </div>
  </section>

  <!-- === Hero with new image === -->
  <section class="hero" aria-label="Flax Lignan Health hero">
    <img class="hero-bg" src="/images/hero-1600x.jpg?v=3" alt="Sunrise over flax field with farm in the distance" />

    <div class="hero-inner">
      <div class="hero-card">
        <h1 class="site-title">Flax Lignan Health</h1>
        <p>
          Your research-driven source for natural products promoting health, vitality and immune system support. The original FHL Flax Hull Lignans found in international trials around the world. Fresh from the USA North Dakota farm to your home. <br />
          <strong>Order online or call <a href="tel:18177106918">817-710-6918</a>.</strong>
        </p>

        <nav class="home-shop-cta" aria-label="Shop">
          <a href="/products" class="cta-btn">Shop</a>
        </nav>
      </div>
    </div>
  </section>

  <style>
    /* ===== Category Bar ===== */
    .category-bar{
      background:#fff;
      min-height:300px;
      display:flex;
      align-items:flex-start;
      border-bottom:1px solid #e5e7eb;
      padding-top:20px;
      padding-bottom:20px;
    }
    .cat-wrap{
      width:min(1200px, 92vw);
      margin:0 auto;
      display:flex;
      flex-direction:column;
      gap:20px;
    }
    .cat-heading{
      font-size:1.5rem;
      font-weight:700;
      text-align:center;
      margin:0;
    }
    .cat-grid{
      display:grid;
      grid-template-columns: repeat(6, 1fr);
      gap:clamp(10px, 2vw, 28px);
      align-items:center;
      justify-items:center;
    }
    .cat-item{
      display:flex;
      flex-direction:column;
      align-items:center;
      gap:.6rem;
      text-decoration:none;
      color:inherit;
      transform: translateY(0);
      transition: transform .18s ease, filter .18s ease;
      will-change: transform;
    }
    .cat-item:hover,
    .cat-item:focus-visible{
      transform: translateY(-4px);
    }
    .cat-thumb{
      width: clamp(106px, 12vw, 168px);
      height: clamp(106px, 12vw, 168px);
      border-radius:50%;
      overflow:hidden;
      box-shadow:0 2px 6px rgba(0,0,0,.10);
      display:block;
    }
    .cat-thumb img{
      width:100%;height:100%;object-fit:cover;display:block;
    }
    .cat-label{
      font-size:1rem;font-weight:600;text-align:center;line-height:1.2;
    }
    @media (max-width: 1024px){
      .cat-grid{ grid-template-columns: repeat(3, 1fr); }
      .category-bar{ min-height: 340px; }
    }
    @media (max-width: 640px){
      .cat-grid{ grid-template-columns: repeat(2, 1fr); }
      .category-bar{ min-height: 380px; }
    }

    /* ===== Hero ===== */
    .hero{
      position:relative;isolation:isolate;overflow:hidden;
      min-height:clamp(420px,62vh,680px);
      padding:28px 16px 56px;
      border-bottom:1px solid #e5e7eb;display:block;
    }
    .hero-bg{
      position:absolute;
      inset:0;
      width:100%;
      height:100%;
      object-fit:cover;
      object-position:center 60%; /* adjust vertical framing */
      z-index:-1;
    }
    /* ===== Hero (only the changed bits) ===== */
.hero-inner{
  position:relative;
  max-width:1100px;
  margin:0 auto;
  z-index:1;
  display:flex;
  align-items:center;
  justify-content:center;
  min-height:clamp(360px,54vh,600px);
}

.hero-card{
  display:inline-block;
  width:75%;
  max-width:720px;
  background:rgba(255,255,255,.62);
  -webkit-backdrop-filter:blur(8px);
  backdrop-filter:blur(8px);
  border-radius:14px;
  padding:16px 20px;
  box-shadow:0 6px 18px rgba(0,0,0,.10);
  text-align:center;
  z-index:2;                 /* make sure it’s above the bg */
}

.home-shop-cta{
  display:flex;              /* center the CTA row */
  justify-content:center;
  margin-top:16px;           /* more separation from paragraph */
}

.cta-btn{
  display:inline-flex; align-items:center; justify-content:center;
  min-width:140px;           /* a bit wider so it doesn’t collapse */
  padding:12px 18px;
  font:700 16px/1 Inter,system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  color:#fff; background:#111827;
  text-decoration:none; border:0; border-radius:9999px;
  box-shadow:0 6px 18px rgba(0,0,0,.18);
  position:relative; z-index:3;   /* ensure above any backdrop effects */
  user-select:none; -webkit-tap-highlight-color:transparent; white-space:nowrap;
  transition:transform .08s ease, opacity .15s ease;
}
.cta-btn:hover{opacity:.92; transform:translateY(-1px)}

@media (max-width:768px){
  .hero-card{width:92%; max-width:none; padding:14px 16px; border-radius:12px}
  .home-shop-cta{margin-top:14px}
  .cta-btn{width:100%; max-width:320px}  /* tidy on phones */
}

  </style>
</BaseLayout>
