---
import BaseLayout from '@/layouts/BaseLayout.astro';
const pageTitle = 'Home — ';
---

<BaseLayout>
  <Fragment slot="title">{pageTitle}</Fragment>

  <!-- === Category Bar (full-width, with heading) === -->
  <section class="category-bar" aria-label="Shop by category">
    <div class="cat-wrap">
      <h2 class="cat-heading">Top Selling Products</h2>
      <div class="cat-grid">
        <a href="/products/flax-hull-lignans" class="cat-item">
          <span class="cat-thumb"><img src="/images/flaxhull.png" alt="Flax Hull Lignans" /></span>
          <span class="cat-label">Flax Hull Lignans</span>
        </a>
        <a href="/products/ocean-cleanse" class="cat-item">
          <span class="cat-thumb"><img src="/images/oceancleanse.png" alt="Ocean Cleanse" /></span>
          <span class="cat-label">Ocean Cleanse</span>
        </a>
        <a href="/products/essiac-tea" class="cat-item">
          <span class="cat-thumb"><img src="/images/essiac-tea.png" alt="Essiac Tea" /></span>
          <span class="cat-label">Essiac Tea</span>
        </a>
        <a href="/products/zeolite" class="cat-item">
          <span class="cat-thumb"><img src="/images/zeolite.png" alt="Aftershot" /></span>
          <span class="cat-label">Aftershot &amp; Zeolite</span>
        </a>
        <a href="/products/essential-oils" class="cat-item">
          <span class="cat-thumb"><img src="/images/eoils.png" alt="Essential Oils" /></span>
          <span class="cat-label">Essential Oils</span>
        </a>
        <a href="/products/other-products" class="cat-item">
          <span class="cat-thumb"><img src="/images/otherprods.png" alt="Other Products" /></span>
          <span class="cat-label">Other Products</span>
        </a>
      </div>
    </div>
  </section>

 <!-- === Hero (logo pinned to top; card sits below it) === -->
<section class="hero" aria-label="Flax Lignan Health hero">
  <img class="hero-bg" src="/images/hero-1600x.jpg?v=3" alt="Sunrise over flax field with farm in the distance" />

  <!-- Logo pinned to the very top of the hero -->
  <div class="hero-brand">
    <img
      src="/images/flh-logo-3.png"
      alt="Flax Lignan Health"
      class="hero-logo"
      decoding="async"
      loading="eager"
    />
  </div>

  <!-- Copy card underneath the logo -->
  <div class="hero-inner">
    <div class="hero-card">
      <p class="hero-text">
        Your research-driven source for natural products promoting health, vitality and immune system support.
        The original FHL Flax Hull Lignans found in international trials around the world.
        Fresh from the USA North Dakota farm to your home. <br />
        <strong>Order online or call <a href="tel:18177106918">817-710-6918</a>.</strong>
      </p>

      <nav class="home-shop-cta" aria-label="Shop">
        <a href="/products" class="cta-btn">Shop</a>
      </nav>
    </div>
  </div>
</section>

<style>
  :root{
    /* control the logo height once, everything else follows */
    --hero-logo-h: 180px;
  }

  /* ===== Hero ===== */
  .hero{
    position:relative; isolation:isolate; overflow:hidden;
    min-height:clamp(520px,72vh,880px);
    padding:0 12px 40px; border-bottom:1px solid #e5e7eb;
    text-align:center; background:transparent;
  }
  .hero-bg{
    position:absolute; inset:0; width:100%; height:100%;
    object-fit:cover; object-position:center 60%; z-index:-2;
  }

  /* Pin logo to top edge of the hero */
  .hero-brand{
    position:absolute;
    top:8px;               /* <- at the very top */
    left:50%; transform:translateX(-50%);
    z-index:5;
  }
  .hero-logo{
    height:var(--hero-logo-h);
    width:auto; display:block; margin:0;
  }

  /* Push the card down by logo height + gap so it never overlaps */
  .hero-inner{
    display:flex; flex-direction:column; align-items:center;
    padding-top:calc(var(--hero-logo-h) + 20px);  /* <- replaces previous margin-top */
  }

  .hero-card{
    width:min(64%, 760px);
    background:rgba(255,255,255,.85);
    -webkit-backdrop-filter:blur(6px); backdrop-filter:blur(6px);
    border-radius:12px;
    padding:14px 18px;
    box-shadow:0 8px 22px rgba(0,0,0,.12);
    text-align:center; color:#0f172a;
  }
  .hero-text{ margin:4px 0 10px; line-height:1.3; }

  .home-shop-cta{ margin-top:10px; display:flex; justify-content:center; }
  .cta-btn{
    display:inline-flex; align-items:center; justify-content:center;
    min-width:140px; padding:12px 18px;
    font:700 16px/1 Inter,system-ui,sans-serif;
    color:#fff; background:#111827; border-radius:9999px;
    box-shadow:0 6px 18px rgba(0,0,0,.18); text-decoration:none;
    transition:transform .08s ease, opacity .15s ease;
  }
  .cta-btn:hover{ opacity:.92; transform:translateY(-1px); }

  @media (max-width:768px){
    :root{ --hero-logo-h: 120px; }          /* smaller on phones */
    .hero-card{ width:92%; padding:12px 14px; }
    .hero-text{ font-size:.95rem; }
  }
</style>

</BaseLayout>
