---
import BaseLayout from '@/layouts/BaseLayout.astro';
const pageTitle = 'Home — ';
---

<BaseLayout>
  <Fragment slot="title">{pageTitle}</Fragment>

  <!-- === Category Bar (full-width, taller, with heading) === -->
  <section class="category-bar" aria-label="Shop by category">
    <!-- ... your category markup unchanged ... -->
  </section>

  <!-- === Hero with new image === -->
  <section class="hero" aria-label="Flax Lignan Health hero">
    <img class="hero-bg" src="/images/hero-1600x.jpg?v=3" alt="Sunrise over flax field with farm in the distance" />

    <div class="hero-inner">
      <div class="hero-card">
        <h1 class="site-title">Flax Lignan Health</h1>
        <p>
          Your research-driven source for natural products promoting health, vitality and immune system support. The original FHL Flax Hull Lignans found in international trials around the world. Fresh from the USA North Dakota farm to your home. <br />
          <strong>Order online or call <a href="tel:18177106918">817-710-6918</a>.</strong>
        </p>

        <nav class="home-shop-cta" aria-label="Shop">
          <a href="/products" class="cta-btn">Shop</a>
        </nav>
      </div>
    </div>
  </section>

  <!-- === Footer Green Bar === -->
  <div class="green-bar">
    <p>Footer content goes here (contact info, links, etc.)</p>
  </div>

  <style>
    /* (your existing Category + Hero CSS unchanged) */

    /* Footer green bar */
    .green-bar{
      width:100%;
      background-color: rgb(15, 48, 14);
      color:#fff;           /* text will be white on top */
      min-height:120px;     /* adjust height as needed */
      display:flex;
      align-items:center;
      justify-content:center;
      padding:20px;
    }
  </style>
</BaseLayout>
