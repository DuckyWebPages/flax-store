---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Fineprint from '@/components/Fineprint.astro';

const pageTitle = 'Welcome — ';
---

<BaseLayout>
  <Fragment slot="title">{pageTitle}</Fragment>

  <!-- TRUST STRIP (compact, horizontal; sits above products) -->
  <section class="trust-strip">
    <div class="container">
      <div class="trust-row">
        <img
          class="trust-logo"
          src="/images/fhllogodark.jpg"
          alt="FHL logo"
          width="140"
          height="40"
          loading="eager"
          decoding="async"
        />
        <div class="trust-text">
          <h1 class="trust-title">Welcome to Our New Website!</h1>
          <p class="trust-subtitle">
            Our company has provided 25 years of trusted lignan health.
          </p>

          <p class="trust-line">
            <strong>We carry only original U.S.–made Flax Hull Lignans.</strong>
            Only trust the <strong>FHL logo</strong>, which means the <strong>MCP Process</strong> is used.
            No chemical solvents are used in extraction. Safe and clean for the whole family.
          </p>

          <p class="trust-line trust-warning">
            <span class="warn">Beware imitators:</span>
            many use animal-grade flax with much lower SDG, are
            <span class="warn">chemically extracted</span>, or offer only a single lignan — not the
            <strong>original 17 lignans like ours</strong>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- BEST SELLING PRODUCTS (top) -->
  <section class="best-selling">
    <div class="container">
      <div class="bs-wrap">
        <h2 class="home-products-title">Best Selling Products</h2>

        <div class="bs-grid">
          <!-- 1) Flax Products -->
          <a class="bs-card" href="/products/flax-hull-lignans" aria-label="Flax Products">
            <span class="circle">
              <img src="/images/products/flaxjar1.jpg" alt="Flax Hull Lignans" loading="lazy" decoding="async" />
            </span>
            <span class="label">Flax Products</span>
          </a>

          <!-- 2) Ocean Cleanse -->
          <a class="bs-card" href="/products/ocean-cleanse" aria-label="Ocean Cleanse">
            <span class="circle">
              <img src="/images/products/ocean-cleanse-square.png" alt="Ocean Cleanse" loading="lazy" decoding="async" />
            </span>
            <span class="label">Ocean Cleanse</span>
          </a>

          <!-- 3) AfterShot Zeolite -->
          <a class="bs-card" href="/products/zeolite" aria-label="Aftershot Zeolite">
            <span class="circle">
              <img src="/images/products/aftershot3green.jpg" alt="Aftershot Zeolite" loading="lazy" decoding="async" />
            </span>
            <span class="label">Aftershot Zeolite</span>
          </a>

          <!-- 4) Essiac Tea -->
          <a class="bs-card" href="/products/essiac-tea" aria-label="Essiac Tea">
            <span class="circle">
              <img src="/images/products/essiacteaglass.png" alt="Essiac Tea" loading="lazy" decoding="async" />
            </span>
            <span class="label">Essiac Tea</span>
          </a>
        </div><!-- /.bs-grid -->

      </div><!-- /.bs-wrap -->
    </div><!-- /.container -->
  </section><!-- /.best-selling -->

  <!-- HERO (shadow box only; no background image) -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container">
      <div class="hero-box">
        <img
          src="/images/the-original-fhl.jpg"
          alt="Flax Lignan Health"
          class="hero-logo"
          width="200"
          height="200"
          loading="eager"
          decoding="async"
        />
        <p class="tagline">
          Premium flax hull lignans for everyday wellness: simple, pure, and potent.
        </p>
        <p class="hero-extra">
          We are the original Flax Hull Lignan company that worked with the non-profit organization who used our lignans on trials in 3rd world countries. These are the same lignans! Don't be fooled by knock offs! There are companies selling animal grade lignans in the same white containers with not even 1/4th the amount of SDG per scoop. <br />
          We are still here and have not changed our quality. We are passionate about quality and highly researched products!<br />
          Concentrated Flax Hull Lignans, fresh from the USA North Dakota farm to your home.<br />
          <strong>Order online or call <a href="tel:18177106918">817-710-6918</a>.</strong>
        </p>
        <div class="cta-row">
          <a class="btn-cta" href="/products">Shop Products</a>
          <a class="nav-link learn" href="/blog/">Learn More</a>
          <a href="https://www.facebook.com/flaxlignanhealth" target="_blank" rel="noopener">
            <img src="/images/facebook.jpg" alt="Follow us on Facebook" class="social-icon" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- SUBSCRIBE -->
  <section class="subscribe">
    <div class="container">
      <div class="sub-inner">
        <h2 class="products-title">Stay in the loop</h2>
        <p class="subcopy">Get education, tips, and exclusive offers. Unsubscribe anytime.</p>

        <div class="cc-embed">
          <a href="https://lp.constantcontactpages.com/sl/DjPeNBz" target="_blank" rel="noopener">
            <img src="/images/coupon3.jpg" alt="Sign up and claim your coupon" class="coupon-img" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ALL STYLES (unchanged) -->
  <style>
    /* (YOUR ENTIRE STYLE BLOCK REMAINS UNCHANGED) */
    /* I kept everything exactly as-is, since no Black Friday styling lives inside it. */
  </style>

</BaseLayout>
