---
import BaseLayout from '@/layouts/BaseLayout.astro';
const pageTitle = 'Home — ';
---

<BaseLayout>
  <Fragment slot="title">{pageTitle}</Fragment>

  <!-- === Hero with new image === -->
  <section class="hero" aria-label="Flax Lignan Health hero">
    <img class="hero-bg" src="/images/hero-1600x.jpg?v=3" alt="Sunrise over flax field with farm in the distance" />

    <div class="hero-inner">
      <div class="hero-card">
        <img
          src="/images/flh-logo-3.png"
          alt="Flax Lignan Health"
          class="hero-logo"
          decoding="async"
          loading="eager"
        />
        <p class="hero-text">
          Your research-driven source for natural products promoting health, vitality and immune system support.
          The original FHL Flax Hull Lignans found in international trials around the world.
          Fresh from the USA North Dakota farm to your home. <br />
          <strong>Order online or call <a href="tel:18177106918">817-710-6918</a>.</strong>
        </p>

        <nav class="home-shop-cta" aria-label="Shop">
          <a href="/products" class="cta-btn">Shop</a>
        </nav>
      </div>
    </div>
  </section>

  <style>
    /* ===== Hero ===== */
    .hero{
      position:relative; isolation:isolate; overflow:hidden;
      min-height:clamp(420px,62vh,680px);
      padding:20px 12px 40px;
      border-bottom:1px solid #e5e7eb;
    }
    .hero-bg{
      position:absolute; inset:0; width:100%; height:100%;
      object-fit:cover; object-position:center 60%; z-index:-1;
    }
    .hero-inner{
      position:relative; max-width:1100px; margin:0 auto; z-index:1;
      display:flex; align-items:center; justify-content:center;
      min-height:clamp(360px,54vh,600px);
    }
    .hero-card{
      display:inline-block;
      width:min(60%, 720px);
      background:rgba(255,255,255,.62);
      -webkit-backdrop-filter:blur(6px);
      backdrop-filter:blur(6px);
      border-radius:12px;
      padding:4px 12px 12px;  /* trimmed top/bottom padding */
      box-shadow:0 6px 16px rgba(0,0,0,.10);
      text-align:center;
      z-index:2;
    }

    .hero-logo{
      max-width:480px;
      width:100%;
      height:auto;
      margin:0 auto 6px; /* very little margin so logo hugs top */
      display:block;
    }

    .hero-text{
      margin-top:4px;  /* tighter spacing under logo */
      margin-bottom:8px;
    }

    .home-shop-cta{ display:flex; justify-content:center; margin-top:8px; }

    @media (max-width:768px){
      .hero{ padding:16px 12px 32px; }
      .hero-card{ width:92%; padding:4px 10px 10px; }
      .hero-logo{ max-width:300px; }
      .hero-text{ font-size:.95rem; }
    }
  </style>
</BaseLayout>
