---
// FILE: src/pages/index.astro
import BaseLayout from '@/layouts/BaseLayout.astro';
const pageTitle = 'Welcome — ';
---

<BaseLayout>
  <Fragment slot="title">{pageTitle}</Fragment>

  <!-- HERO (full-width background image with white overlay box) -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>

    <div class="hero-shell">
      <div class="hero-box">
        <h1 class="site-title">Flax Lignan Health</h1>

        <p class="tagline">
          Premium flax hull lignans for everyday wellness—simple, pure, and potent.
        </p>

        <p class="hero-extra">
          Your research-driven source for natural products promoting health, vitality and immune system support.<br />
          The original FHL Flax Hull Lignans found in international trials around the world.<br />
          Fresh from the USA North Dakota farm to your home.<br />
          <strong>Order online or call <a href="tel:18177106918">817-710-6918</a>.</strong>
        </p>

        <div class="cta-row">
          <a class="btn-cta" href="/products">Shop Products</a>
          <a class="nav-link learn" href="/blog/">Learn More</a>
        </div>
      </div>
    </div>
  </section>

  <!-- BEST SELLING PRODUCTS (5 circles in a connected white box) -->
  <section class="best-selling">
    <div class="bs-wrap">
      <h2 class="products-title">Best Selling Products</h2>

      <div class="bs-grid">
        <!-- 1) Flax Products -->
        <a class="bs-card" href="/products?cat=flax" aria-label="Flax Products">
          <span class="circle">
            <img src="/images/categories/flaxlignan-3jars-2025.jpg" alt="Flax Products" loading="lazy" />
          </span>
          <span class="label">Flax Products</span>
        </a>

        <!-- 2) Ocean Cleanse -->
        <a class="bs-card" href="/products?cat=ocean-cleanse" aria-label="Ocean Cleanse">
          <span class="circle">
            <img src="/images/categories/ocean-cleanse-3jars-3035.jpg" alt="Ocean Cleanse" loading="lazy" />
          </span>
          <span class="label">Ocean Cleanse</span>
        </a>

        <!-- 3) Aftershot Zeolite -->
        <a class="bs-card" href="/products?cat=aftershot-zeolite" aria-label="Aftershot Zeolite">
          <span class="circle">
            <img src="/images/categories/zeolite.png" alt="Aftershot Zeolite" loading="lazy" />
          </span>
          <span class="label">Aftershot Zeolite</span>
        </a>

        <!-- 4) Essiac Tea -->
        <a class="bs-card" href="/products?cat=essiac-tea" aria-label="Essiac Tea">
          <span class="circle">
            <img src="/images/categories/essiac-tea.png" alt="Essiac Tea" loading="lazy" />
          </span>
          <span class="label">Essiac Tea</span>
        </a>

        <!-- 5) Essential Oils -->
        <a class="bs-card" href="/products?cat=essential-oils" aria-label="Essential Oils">
          <span class="circle">
            <img src="/images/categories/eoils.png" alt="Essential Oils" loading="lazy" />
          </span>
          <span class="label">Essential Oils</span>
        </a>
      </div>
    </div>
  </section>

  <!-- SUBSCRIBE (coupon image links to Constant Contact) -->
  <section class="subscribe">
    <div class="sub-inner">
      <h2 class="products-title">Stay in the loop</h2>
      <p class="subcopy">Get education, tips, and exclusive offers. Unsubscribe anytime.</p>

      <div class="cc-embed">
        <!-- Replace the href with your actual Constant Contact form URL -->
        <a href="https://YOUR-CONSTANT-CONTACT-FORM-URL" target="_blank" rel="noopener">
          <img src="/images/coupon1.jpg" alt="Sign up and claim your coupon" class="coupon-img" />
        </a>
      </div>
    </div>
  </section>

  <style>
    :root { --ink:#0f172a; --muted:#334155; }

    /* =========================
       HERO (background image)
       ========================= */
    .hero{
      position: relative;
      min-height: 440px;
      display: grid;
      place-items: center;
      margin: 0 0 18px 0;
    }
    /* Background image */
    .hero-bg{
      position:absolute; inset:0;
      background:
        linear-gradient(to bottom, rgba(0,0,0,.2), rgba(0,0,0,.25)),
        url('/images/hero-1600x.jpg') center / cover no-repeat;
      z-index: 0;
    }
    /* Shell centers content and gives side padding */
    .hero-shell{
      position: relative; z-index: 1;
      width: 100%;
      max-width: 1100px;
      padding: 0 16px;
      display: grid; justify-items: start;
    }
    /* White overlay box */
    .hero-box{
      background: rgba(255,255,255,.96);
      border: 1px solid #e5e7eb;
      border-radius: 16px;
      box-shadow: 0 12px 28px rgba(0,0,0,.12);
      padding: 22px 22px 18px;
      max-width: 720px;
      backdrop-filter: blur(2px);
    }

    .site-title { margin:0 0 6px 0; }
    .tagline { margin:0; font-size:1.08rem; color:var(--muted); }
    .hero-extra {
      font-size: 1rem;
      line-height: 1.45;
      color:#1f2937;
      margin: 0.75rem 0 1rem;
    }
    .hero-extra a { color: inherit; text-decoration: none; border-bottom: 1px dotted #475569; }
    .hero-extra a:hover { border-bottom-style: solid; }

    .cta-row { display:flex; gap:12px; align-items:center; margin-top:6px; }
    .learn { font-weight:600; }

    /* =========================
       BEST SELLING
       ========================= */
    .best-selling { max-width:1100px; margin:14px auto 48px; padding:0 16px; }
    .bs-wrap {
      background:#fff; border-radius:16px; box-shadow:0 8px 18px rgba(0,0,0,.06);
      border:1px solid #e5e7eb; padding:18px;
    }
    .bs-wrap .products-title { margin:0 0 10px 4px; }
    .bs-grid {
      display:grid; gap:12px;
      grid-template-columns: repeat(5, 1fr);
    }
    @media (max-width: 980px){ .bs-grid{ grid-template-columns: repeat(3, 1fr); } }
    @media (max-width: 520px){ .bs-grid{ grid-template-columns: repeat(2, 1fr); } }

    .bs-card {
      display:grid; gap:8px; place-items:center; text-align:center;
      padding:12px; border-radius:12px; text-decoration:none; color:inherit;
      transition: transform .08s ease, box-shadow .15s ease, background .15s ease;
    }
    .bs-card:hover { background:#f8fafc; transform: translateY(-1px); box-shadow:0 10px 20px rgba(0,0,0,.05); }

    .circle {
      width: 150px; height: 150px; border-radius: 50%; overflow: hidden; display: block;
      background:#f8fafc; border:6px solid #f1f5f9;
    }
    .circle img { width:100%; height:100%; object-fit: cover; object-position:center; display:block; }
    .label { font-weight:700; letter-spacing:.01em; }

    /* =========================
       SUBSCRIBE / COUPON
       ========================= */
    .subscribe{ max-width:1100px; margin:0 auto 64px; padding:0 16px; }
    .sub-inner{
      background:#fff; border-radius:14px; padding:16px;
      box-shadow:0 8px 18px rgba(0,0,0,.06);
      border:1px solid #e5e7eb;
      text-align:center;
    }
    .subcopy{ color:#334155; margin:.25rem 0 .75rem; }
    .cc-embed{ margin-top:12px; }
    .coupon-img{
      max-width:100%;
      height:auto;
      border-radius:12px;
      box-shadow:0 6px 12px rgba(0,0,0,.08);
      transition: transform .15s ease;
    }
    .coupon-img:hover{ transform: scale(1.02); }
  </style>
</BaseLayout>
