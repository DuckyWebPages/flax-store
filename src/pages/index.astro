---
import BaseLayout from '@/layouts/BaseLayout.astro';
const pageTitle = 'Welcome — ';
---

<BaseLayout>
  <Fragment slot="title">{pageTitle}</Fragment>

  <section class="hero">
    <div class="hero-inner">
      <h1 class="site-title">Flax Lignan Health</h1>
      <p class="tagline">
        Premium flax hull lignans for everyday wellness—simple, pure, and potent.
      </p>
      <div class="cta-row">
        <a class="btn-cta" href="/products">Shop Products</a>
        <a class="nav-link learn" href="/blog/">Learn More</a>
      </div>
    </div>
  </section>

  <style>
    .hero {
      padding: 40px 16px 24px;
      max-width: 1100px; margin: 0 auto;
      background: rgba(255,255,255,.9);
      border-radius: 14px;
    }
    .hero-inner { display: grid; gap: 14px; }
    .site-title { margin: 0; }
    .tagline { margin: 0; font-size: 1.1rem; color: #334155; }
    .cta-row { display: flex; gap: 12px; align-items: center; margin-top: 6px; }
    .learn { font-weight: 600; }
  </style>
</BaseLayout>
