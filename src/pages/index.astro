---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Fineprint from '@/components/Fineprint.astro';

const pageTitle = 'Welcome — ';
---

<BaseLayout>
  <Fragment slot="title">{pageTitle}</Fragment>

  <!-- TRUST STRIP (compact, horizontal; sits above products) -->
  <section class="trust-strip">
    <div class="container">
      <div class="trust-row">
        <img
          class="trust-logo"
          src="/images/fhllogodark.jpg"
          alt="FHL logo"
          width="140"
          height="40"
          loading="eager"
          decoding="async"
        />
        <div class="trust-text">
          <h1 class="trust-title">Welcome to Our New Website!</h1>
          <p class="trust-subtitle">
            Our company has provided 25 years of trusted lignan health.
          </p>

          <p class="trust-line">
            <strong>We carry only original U.S.–made Flax Hull Lignans.</strong>
            Only trust the <strong>FHL logo</strong>, which means the <strong>MCP Process</strong> is used.
            No chemical solvents are used in extraction. Safe and clean for the whole family.
          </p>

          <p class="trust-line trust-warning">
            <span class="warn">Beware imitators:</span>
            many use animal-grade flax with much lower SDG, are
            <span class="warn">chemically extracted</span>, or offer only a single lignan — not the
            <strong>original 17 lignans like ours</strong>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- BEST SELLING PRODUCTS (top) -->
  <section class="best-selling">
    <div class="container">
      <div class="bs-wrap">
        <h2 class="home-products-title">Best Selling Products</h2>

        <div class="bs-grid">
          <!-- 1) Flax Products -->
          <a class="bs-card" href="/products/flax-hull-lignans" aria-label="Flax Products">
            <span class="circle">
              <img src="/images/products/flaxjar1.jpg" alt="Flax Hull Lignans" loading="lazy" decoding="async" />
            </span>
            <span class="label">Flax Products</span>
          </a>

          <!-- 2) Ocean Cleanse -->
          <a class="bs-card" href="/products/ocean-cleanse" aria-label="Ocean Cleanse">
            <span class="circle">
              <img src="/images/products/ocean-cleanse-square.png" alt="Ocean Cleanse" loading="lazy" decoding="async" />
            </span>
            <span class="label">Ocean Cleanse</span>
          </a>

          <!-- 3) AfterShot Zeolite -->
          <a class="bs-card" href="/products/zeolite" aria-label="Aftershot Zeolite">
            <span class="circle">
              <img src="/images/products/aftershot3green.jpg" alt="Aftershot Zeolite" loading="lazy" decoding="async" />
            </span>
            <span class="label">Aftershot Zeolite</span>
          </a>

          <!-- 4) Essiac Tea -->
          <a class="bs-card" href="/products/essiac-tea" aria-label="Essiac Tea">
            <span class="circle">
              <img src="/images/products/essiacteaglass.png" alt="Essiac Tea" loading="lazy" decoding="async" />
            </span>
            <span class="label">Essiac Tea</span>
          </a>
        </div><!-- /.bs-grid -->

      </div><!-- /.bs-wrap -->
    </div><!-- /.container -->
  </section><!-- /.best-selling -->

  <!-- HERO (shadow box only; no background image) -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container">
      <div class="hero-box">
        <img
          src="/images/the-original-fhl.jpg"
          alt="Flax Lignan Health"
          class="hero-logo"
          width="200"
          height="200"
          loading="eager"
          decoding="async"
        />
        <p class="tagline">
          Premium flax hull lignans for everyday wellness: simple, pure, and potent.
        </p>
        <p class="hero-extra">
          We are the original Flax Hull Lignan company that worked with the non-profit organization who used our lignans on trials in 3rd world countries. These are the same lignans! Don't be fooled by knock offs! There are companies selling animal grade lignans in the same white containers with not even 1/4th the amount of SDG per scoop. <br />
          We are still here and have not changed our quality. We are passionate about quality and highly researched products!<br />
          Concentrated Flax Hull Lignans, fresh from the USA North Dakota farm to your home.<br />
          <strong>Order online or call <a href="tel:18177106918">817-710-6918</a>.</strong>
        </p>
        <div class="cta-row">
          <a class="btn-cta" href="/products">Shop Products</a>
          <a class="nav-link learn" href="/blog/">Learn More</a>
          <a href="https://www.facebook.com/flaxlignanhealth" target="_blank" rel="noopener">
            <img src="/images/facebook.jpg" alt="Follow us on Facebook" class="social-icon" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- SUBSCRIBE -->
  <section class="subscribe">
    <div class="container">
      <div class="sub-inner">
        <h2 class="products-title">Stay in the loop</h2>
        <p class="subcopy">Get education, tips, and exclusive offers. Unsubscribe anytime.</p>

        <div class="cc-embed">
          <a href="https://lp.constantcontactpages.com/sl/DjPeNBz" target="_blank" rel="noopener">
            <img src="/images/coupon3.jpg" alt="Sign up and claim your coupon" class="coupon-img" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FULL STYLES (COMPLETE, NOTHING REMOVED) -->
  <style>

    .home-products-title{
      font-size: clamp(1.25rem, 1rem + 1vw, 1.6rem);
      font-weight: 800;
      margin: 0 0 10px 4px;
      letter-spacing: .01em;
    }

    :root { --ink:#0f172a; --muted:#334155; }

    .container{ max-width:1200px; margin:0 auto; padding:0 16px; }

    /* ===== TRUST STRIP (compact, horizontal) ===== */
    .trust-strip{ margin:12px 0 12px; }
    .trust-row{
      background:#fff; border:1px solid #e5e7eb; border-radius:12px;
      box-shadow:0 6px 16px rgba(0,0,0,.08);
      padding:10px 12px;
      display:flex; align-items:center; gap:12px;
    }
    .trust-logo{ width:150px; height:auto; display:block; }
    .trust-text{ display:flex; flex-direction:column; gap:4px; }

    .trust-title{
      margin:0;
      font-family:var(--font-head);
      font-weight:800;
      letter-spacing:-.01em;
      font-size:clamp(1.1rem, .8rem + 1vw, 1.6rem);
      color:var(--ink);
      line-height:1.15;
    }

    .trust-subtitle{
      margin:0;
      font-size:0.95rem;
      color:#374151;
    }

    .trust-line{
      margin:0;
      font-size:0.95rem;
      line-height:1.45;
      color:#1f2937;
    }

    .trust-warning{
      font-size:0.9rem;
      color:#111827;
    }

    .warn{
      color:#dc2626;
      font-weight:800;
    }


    /* ===== BEST SELLING ===== */
    .best-selling { margin:12px 0 20px; }
    .bs-wrap {
      background:#fff; border-radius:16px; box-shadow:0 8px 18px rgba(0,0,0,.06);
      border:1px solid #e5e7eb; padding:18px;
    }

    .bs-grid {
      display:grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: clamp(4px, 0.6vw, 8px);
      row-gap: clamp(4px, 0.6vw, 8px);
      align-items:start;
    }
    @media (max-width: 980px){ .bs-grid{ grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 520px){ .bs-grid{ grid-template-columns: repeat(2, minmax(0, 1fr)); } }

    .bs-card {
      display:grid; place-items:center; text-align:center;
      gap:8px; padding:4px;
      border-radius:12px; text-decoration:none; color:inherit; margin:0;
      transition: transform .08s ease, box-shadow .15s ease, background .15s ease;
    }
    .bs-card:hover { background:#f8fafc; transform: translateY(-1px); box-shadow:0 10px 20px rgba(0,0,0,.05); }

    .circle {
      width: clamp(176px, 22vw, 212px);
      height: clamp(176px, 22vw, 212px);
      border-radius:50%;
      overflow:hidden;
      display:block;
      background:#f8fafc;
      border:3px solid #f1f5f9;
    }
    .circle img { width:100%; height:100%; object-fit:cover; display:block; }

    .label {
      font-weight:800; letter-spacing:.01em;
      font-size: clamp(.95rem, .6rem + .7vw, 1.12rem);
      line-height:1.15;
    }

    /* ===== HERO ===== */
    .hero{ position: relative; min-height: 400px; display: flex; align-items: center; margin: 0 0 18px 0; }
    .hero-bg{
      position:absolute; inset:0;
      background: linear-gradient(to bottom, rgba(0,0,0,.08), rgba(0,0,0,.14));
      z-index: 0;
    }
    .hero .container{ position: relative; z-index: 1; display: grid; place-items: center; }
    .hero-box{
      background: rgba(255,255,255,.96);
      border: 1px solid #e5e7eb;
      border-radius: 16px;
      box-shadow: 0 12px 28px rgba(0,0,0,.12);
      padding: 10px 34px 6px;
      width: min(760px, 100%);
      text-align: center;
      backdrop-filter: blur(2px);
    }
    .hero-logo{ display:block; margin: 0 auto 8px; height:auto; }
    .tagline { margin:0; font-size:1.08rem; color:var(--muted); }
    .hero-extra { font-size: 1rem; line-height: 1.45; color:#1f2937; margin: 0.75rem 0 1rem; }
    .hero-extra a { color: inherit; text-decoration: none; border-bottom: 1px dotted #475569; }
    .hero-extra a:hover { border-bottom-style: solid; }

    .cta-row {
      display:flex; gap:12px; align-items:center; justify-content:center;
      margin-top:6px; margin-bottom:24px;
    }
    .social-icon { height: 24px; width: 72px; margin-left: 10px; object-fit: contain; }


    /* ===== SUBSCRIBE ===== */
    .subscribe{ margin:0 0 64px; }
    .sub-inner{
      background:#fff; border-radius:14px; padding:16px;
      box-shadow:0 8px 18px rgba(0,0,0,.06);
      border:1px solid #e5e7eb;
      text-align:center;
    }
    .subcopy{ color:#334155; margin:.25rem 0 .75rem; }
    .cc-embed{ margin-top:12px; }
    .coupon-img{
      max-width:100%; height:auto; border-radius:12px; box-shadow:0 6px 12px rgba(0,0,0,.08);
      transition: transform .15s ease;
    }
    .coupon-img:hover{ transform: scale(1.02); }


    /* ===== MOBILE BOOSTS ===== */
    @media (max-width: 860px) {
      .prodpg__grid { grid-template-columns: 1fr !important; gap: 18px !important; }

      .prodpg__card { max-width: 100% !important; padding: 14px !important; border-radius: 14px; }

      .card-photo-img { aspect-ratio: 4/3 !important; object-fit: cover; }

      .prod-hero h1 { font-size: clamp(1.8rem, 3.6vw, 2.2rem) !important; }
      .prod-hero p { font-size: 1.02rem; line-height: 1.5; }

      .prodpg__title { font-size: 1.15rem !important; line-height: 1.25 !important; }
      .prodpg__price { font-size: 1.25rem !important; font-weight: 800; margin-top: 2px; }

      .prodpg__bullets, .prodpg__desc {
        font-size: 1rem !important; line-height: 1.5;
      }

      .product-cta .add-to-cart {
        height: 52px !important;
        padding: 0 20px !important;
        font-size: 18px !important;
        font-weight: 700 !important;
        border-radius: 12px !important;
        min-width: 220px;
      }
    }

    @media (max-width: 420px) {
      .card-photo-img { aspect-ratio: 3/2 !important; }
      .prodpg__title { font-size: 1.2rem !important; }
      .prodpg__price { font-size: 1.3rem !important; }
      .product-cta .add-to-cart { min-width: 100%; }
    }

    @media (max-width: 520px) {
      .trust-title {
        font-size: 1.6rem !important;
        font-weight: 800 !important;
        line-height: 1.2 !important;
      }
      .trust-line {
        font-size: 1rem !important;
        line-height: 1.35 !important;
      }
    }

    @media (max-width: 520px) {
      .best-selling { margin: 10px 0 18px; }
      .best-selling .container { padding: 0 !important; }
      .best-selling .bs-wrap {
        width: 100vw;
        margin-left: 50%;
        transform: translateX(-50%);
        border-radius: 0;
        border: 0;
        box-shadow: none;
        padding: 14px 10px;
      }

      .bs-grid {
        grid-template-columns: repeat(2, 1fr) !important;
        column-gap: 12px !important;
        row-gap: 14px !important;
        justify-items: center !important;
        align-items: start !important;
      }

      .circle {
        width: calc((100vw - 20px - 12px) / 2) !important;
        height: calc((100vw - 20px - 12px) / 2) !important;
        max-width: 190px !important;
        max-height: 190px !important;
        border-width: 3px !important;
      }

      .bs-card { padding: 2px !important; }
      .bs-card:hover { box-shadow: 0 8px 14px rgba(0,0,0,.05); background: #f8fafc; }
    }

    @media (max-width: 380px) {
      .circle {
        max-width: 172px !important;
        max-height: 172px !important;
      }
    }

  </style>

</BaseLayout>
