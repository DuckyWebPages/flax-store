---
// FILE: src/pages/index.astro
import BaseLayout from '@/layouts/BaseLayout.astro';
const pageTitle = 'Welcome — ';
---

<BaseLayout>
  <Fragment slot="title">{pageTitle}</Fragment>

  <!-- BEST SELLING PRODUCTS (moved to top) -->
  <section class="best-selling">
    <div class="container">
      <div class="bs-wrap">
        <h2 class="products-title">Best Selling Products</h2>

        <div class="bs-grid">
          <!-- 1) Flax Products -->
          <a class="bs-card" href="/products?cat=flax" aria-label="Flax Products">
            <span class="circle">
              <img src="/images/flax-hull-bundle.jpg" alt="Flax Products" loading="lazy" />
            </span>
            <span class="label">Flax Products</span>
          </a>

          <!-- 2) Ocean Cleanse -->
          <a class="bs-card" href="/products?cat=ocean-cleanse" aria-label="Ocean Cleanse">
            <span class="circle">
              <img src="/images/ocean-cleanse-3jars-3035.jpg" alt="Ocean Cleanse" loading="lazy" />
            </span>
            <span class="label">Ocean Cleanse</span>
          </a>

          <!-- 3) Aftershot Zeolite -->
          <a class="bs-card" href="/products?cat=aftershot-zeolite" aria-label="Aftershot Zeolite">
            <span class="circle">
              <img src="/images/zeolite.png" alt="Aftershot Zeolite" loading="lazy" />
            </span>
            <span class="label">Aftershot Zeolite</span>
          </a>

          <!-- 4) Essiac Tea -->
          <a class="bs-card" href="/products?cat=essiac-tea" aria-label="Essiac Tea">
            <span class="circle">
              <img src="/images/essiac-tea.png" alt="Essiac Tea" loading="lazy" />
            </span>
            <span class="label">Essiac Tea</span>
          </a>

          <!-- 5) Essential Oils -->
          <a class="bs-card" href="/products?cat=essential-oils" aria-label="Essential Oils">
            <span class="circle">
              <img src="/images/eoils.png" alt="Essential Oils" loading="lazy" />
            </span>
            <span class="label">Essential Oils</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- HERO (moved between sections, new image, resized) -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container">
      <div class="hero-box">
        <img
          src="/images/flh-logo-33.png?v=6"
          alt="Flax Lignan Health"
          class="hero-logo"
          width="280"
          height="80"
          loading="eager"
          decoding="async"
        />
        <p class="tagline">
          Premium flax hull lignans for everyday wellness—simple, pure, and potent.
        </p>
        <p class="hero-extra">
  Your research-driven source for natural products promoting health, vitality and immune system support.<br />
  The original FHL Flax Hull Lignans found in international trials around the world.<br />
  Fresh from the USA North Dakota farm to your home.<br />
  <strong>
    Order online or call <a href="tel:18177106918">817-710-6918</a>.
    
  </strong>
</p>

        <div class="cta-row">
  <a class="btn-cta" href="/products">Shop Products</a>
  <a class="nav-link learn" href="/blog/">Learn More</a>
  <a href="https://www.facebook.com/flaxlignanhealth" target="_blank" rel="noopener">
    <img src="/images/facebook.png" alt="Follow us on Facebook" class="social-icon" />
  </a>
</div>

      </div>
    </div>
  </section>

  <!-- SUBSCRIBE -->
  <section class="subscribe">
    <div class="container">
      <div class="sub-inner">
        <h2 class="products-title">Stay in the loop</h2>
        <p class="subcopy">Get education, tips, and exclusive offers. Unsubscribe anytime.</p>

        <div class="cc-embed">
          <a href="https://lp.constantcontactpages.com/sl/DjPeNBz" target="_blank" rel="noopener">
            <img src="/images/coupon1.jpg" alt="Sign up and claim your coupon" class="coupon-img" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <style>
    :root { --ink:#0f172a; --muted:#334155; }

    .container{ max-width:1100px; margin:0 auto; padding:0 16px; }

    /* ===================== BEST SELLING ===================== */
    <!-- BEST SELLING PRODUCTS -->
<section class="best-selling">
  <div class="container">
    <div class="bs-wrap">
      <h2 class="products-title">Best Selling Products</h2>

      <div class="bs-grid">
        <!-- 1) Flax Products -->
        <a class="bs-card" href="/products/flax-hull-lignans" aria-label="Flax Products">
          <span class="circle">
            <img src="/images/flax-hull-bundle.jpg" alt="Flax Hull Lignans" loading="lazy" />
          </span>
          <span class="label">Flax Products</span>
        </a>

        <!-- 2) Ocean Cleanse -->
        <a class="bs-card" href="/products/ocean-cleanse" aria-label="Ocean Cleanse">
          <span class="circle">
            <img src="/images/ocean-cleanse-3jars-3035.jpg" alt="Ocean Cleanse" loading="lazy" />
          </span>
          <span class="label">Ocean Cleanse</span>
        </a>

        <!-- 3) Aftershot Zeolite -->
        <a class="bs-card" href="/products/zeolite" aria-label="Aftershot Zeolite">
          <span class="circle">
            <img src="/images/zeolite.png" alt="Aftershot Zeolite" loading="lazy" />
          </span>
          <span class="label">Aftershot Zeolite</span>
        </a>

        <!-- 4) Essiac Tea -->
        <a class="bs-card" href="/products/essiac-tea" aria-label="Essiac Tea">
          <span class="circle">
            <img src="/images/essiac-tea.png" alt="Essiac Tea" loading="lazy" />
          </span>
          <span class="label">Essiac Tea</span>
        </a>

        <!-- 5) Essential Oils -->
        <a class="bs-card" href="/products/essential-oils" aria-label="Essential Oils">
          <span class="circle">
            <img src="/images/eoils.png" alt="Essential Oils" loading="lazy" />
          </span>
          <span class="label">Essential Oils</span>
        </a>
      </div>
    </div>
  </div>
</section>


    /* ========================= HERO ========================= */
    .hero{
      position: relative;
      min-height: 400px; /* reduced 60px from original 460px */
      max-width: calc(100% - 24px); /* reduced width by 24px */
      margin: 0 auto 18px;
      display: flex;
      align-items: center;
    }
    .hero-bg{
  position:absolute; inset:0;
  background:
    linear-gradient(to bottom, rgba(0,0,0,.08), rgba(0,0,0,.14));
  z-index: 0;
}

    }
    .hero .container{ position: relative; z-index: 1; display: grid; place-items: center; }
    .hero-box{
      background: rgba(255,255,255,.96);
      border: 1px solid #e5e7eb;
      border-radius: 16px;
      box-shadow: 0 12px 28px rgba(0,0,0,.12);
      padding: 22px 22px 18px;
      width: min(760px, 100%);
      text-align: center;
      backdrop-filter: blur(2px);
    }
    .hero-logo{ display:block; margin: 0 auto 8px; height:auto; }
    .tagline { margin:0; font-size:1.08rem; color:var(--muted); }
    .hero-extra {
      font-size: 1rem; line-height: 1.45; color:#1f2937;
      margin: 0.75rem 0 1rem;
    }
    .hero-extra a { color: inherit; text-decoration: none; border-bottom: 1px dotted #475569; }
    .hero-extra a:hover { border-bottom-style: solid; }
    .cta-row { display:flex; gap:12px; align-items:center; justify-content:center; margin-top:6px; }
    .learn { font-weight:600; }

    /* ===================== SUBSCRIBE ===================== */
    .subscribe{ margin:0 0 64px; }
    .sub-inner{
      background:#fff; border-radius:14px; padding:16px;
      box-shadow:0 8px 18px rgba(0,0,0,.06);
      border:1px solid #e5e7eb;
      text-align:center;
    }
    .subcopy{ color:#334155; margin:.25rem 0 .75rem; }
    .cc-embed{ margin-top:12px; }
    .coupon-img{
      max-width:100%;
      height:auto;
      border-radius:12px;
      box-shadow:0 6px 12px rgba(0,0,0,.08);
      transition: transform .15s ease;
    }
    .coupon-img:hover{ transform: scale(1.02); }
    .social-icon {
  height: 24px;
  width: 72px; /* 3x longer than height */
  margin-left: 10px;
  object-fit: contain;
}


  </style>
</BaseLayout>
