---
import BaseLayout from '@/layouts/BaseLayout.astro';
const pageTitle = 'Welcome — ';
---

<BaseLayout>
  <Fragment slot="title">{pageTitle}</Fragment>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-copy">
        <h1 class="site-title">Flax Lignan Health</h1>
        <p class="tagline">
          Premium flax hull lignans for everyday wellness—simple, pure, and potent.
        </p>
        <div class="cta-row">
          <a class="btn-cta" href="/products">Shop Products</a>
          <a class="nav-link learn" href="/blog/">Learn More</a>
        </div>
      </div>
      <!-- Swap to a dedicated hero image if you have one -->
      <div class="hero-art" aria-hidden="true"></div>
    </div>
  </section>

  <!-- BEST SELLING PRODUCTS (6 circles in a connected white box) -->
  <section class="best-selling">
    <div class="bs-wrap">
      <h2 class="products-title">Best Selling Products</h2>

      <div class="bs-grid">
        <!-- 1) Flax Products -->
        <a class="bs-card" href="/products?cat=flax" aria-label="Flax Products">
          <span class="circle">
            <img src="/images/categories/flaxlignan-3jars-2025.jpg" alt="" loading="lazy" />
          </span>
          <span class="label">Flax Products</span>
        </a>

        <!-- 2) Ocean Cleanse -->
        <a class="bs-card" href="/products/ocean-cleanse" aria-label="Ocean Cleanse">
          <span class="circle">
            <img src="/images/categories/ocean-cleanse-3jars-3035.jpg" alt="" loading="lazy" />
          </span>
          <span class="label">Ocean Cleanse</span>
        </a>

        <!-- 3) Aftershot Zeolite -->
        <a class="bs-card" href="/products/aftershot-zeolite" aria-label="Aftershot Zeolite">
          <span class="circle">
            <img src="/images/categories/zeolite.png" alt="" loading="lazy" />
          </span>
          <span class="label">Aftershot Zeolite</span>
        </a>

        <!-- 4) Essiac Tea -->
        <a class="bs-card" href="/products/essiac-tea" aria-label="Essiac Tea">
          <span class="circle">
            <img src="/images/categories/essiac-tea.png" alt="" loading="lazy" />
          </span>
          <span class="label">Essiac Tea</span>
        </a>

        <!-- 5) Essential Oils -->
        <a class="bs-card" href="/products/essential-oils" aria-label="Essential Oils">
          <span class="circle">
            <img src="/images/categories/eoils.png" alt="" loading="lazy" />
          </span>
          <span class="label">Essential Oils</span>
        </a>

        <!-- 6) Other Products -->
        <a class="bs-card" href="/products?cat=other" aria-label="Other Products">
          <span class="circle">
            <img src="/images/categories/otherprods.png" alt="" loading="lazy" />
          </span>
          <span class="label">Other Products</span>
        </a>
      </div>
    </div>
  </section>

  <!-- SUBSCRIBE -->
  <section class="subscribe">
    <div class="sub-inner">
      <h2 class="products-title">Stay in the loop</h2>
      <p class="subcopy">Get education, tips, and exclusive offers. Unsubscribe anytime.</p>

      <!-- Paste your Constant Contact embed code inside this div -->
      <div class="cc-embed">
        <!-- Placeholder form so the layout looks right until you paste the real CC embed -->
        <form class="mini-form" onsubmit="alert('Thanks! (Replace with your Constant Contact embed.)'); return false;">
          <input type="email" name="email" placeholder="you@example.com" required />
          <button class="btn-cta" type="submit">Subscribe</button>
        </form>
      </div>
    </div>
  </section>

  <style>
    :root { --ink:#0f172a; --muted:#334155; }

    /* HERO */
    .hero { max-width:1100px; margin:0 auto 16px; padding:0 16px; }
    .hero-inner {
      display:grid; gap:16px; grid-template-columns:1.2fr .8fr;
      background:rgba(255,255,255,.92); border-radius:14px; overflow:hidden;
    }
    @media (max-width: 860px){ .hero-inner{ grid-template-columns:1fr; } }
    .hero-copy { padding:28px 24px; }
    .site-title { margin:0 0 6px 0; }
    .tagline { margin:0; font-size:1.1rem; color:var(--muted); }
    .cta-row { display:flex; gap:12px; align-items:center; margin-top:10px; }
    .learn { font-weight:600; }
    .hero-art { min-height:220px; background:url('/images/products/flax-hull-bundle.jpg') center/cover no-repeat; }

    /* BEST SELLING (connected white box with 6 circles) */
    .best-selling { max-width:1100px; margin:14px auto 48px; padding:0 16px; }
    .bs-wrap {
      background:#fff; border-radius:16px; box-shadow:0 8px 18px rgba(0,0,0,.06);
      border:1px solid #e5e7eb; padding:18px;
    }
    .bs-wrap .products-title { margin:0 0 10px 4px; }
    .bs-grid {
      display:grid; gap:12px;
      grid-template-columns: repeat(6, 1fr);
    }
    @media (max-width: 980px){ .bs-grid{ grid-template-columns: repeat(3, 1fr); } }
    @media (max-width: 520px){ .bs-grid{ grid-template-columns: repeat(2, 1fr); } }

    .bs-card {
      display:grid; gap:8px; place-items:center; text-align:center;
      padding:12px; border-radius:12px; text-decoration:none; color:inherit;
      transition: transform .08s ease, box-shadow .15s ease, background .15s ease;
    }
    .bs-card:hover { background:#f8fafc; transform: translateY(-1px); box-shadow:0 10px 20px rgba(0,0,0,.05); }

    .circle {
      width: 150px; height: 150px; border-radius: 50%; overflow: hidden; display: block;
      background:#f8fafc; border:6px solid #f1f5f9;
    }
    .circle img { width:100%; height:100%; object-fit: cover; display:block; }
    .label { font-weight:700; letter-spacing:.01em; }

    /* SUBSCRIBE */
    .subscribe{ max-width:1100px; margin:0 auto 64px; padding:0 16px; }
    .sub-inner{
      background:#fff; border-radius:14px; padding:16px;
      box-shadow:0 8px 18px rgba(0,0,0,.06);
      border:1px solid #e5e7eb;
    }
    .subcopy{ color:#334155; margin:.25rem 0 .75rem; }
    .mini-form{ display:flex; gap:8px; flex-wrap:wrap; }
    .mini-form input[type="email"]{
      flex:1 1 260px; min-width:220px; padding:10px 12px; border:1px solid #e5e7eb; border-radius:999px; font-size:1rem;
    }
  </style>
</BaseLayout>
