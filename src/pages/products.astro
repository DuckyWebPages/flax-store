---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ShopApp from '@/components/ShopApp.tsx';
import { products as PRODUCTS } from '@/data/products';
const title = 'Products — Flax Lignan Health';

/** Hide these products from the Products page */
const HIDE_TITLES = new Set([
  'Flax Hull Lignan Monthly Subscription',
]);

/** Filter: by exact title OR any slug/id that includes 'subscription' */
const ITEMS = PRODUCTS.filter((p: any) => {
  const title = (p?.title || p?.name || '').trim();
  const slugish = (p?.slug || p?.id || p?.sku || '').toString().toLowerCase();
  const byTitle = HIDE_TITLES.has(title);
  const bySlug = slugish.includes('subscription');
  return !(byTitle || bySlug);
});
---

<BaseLayout>
  <header class="products-header">
    <h1 class="products-title">Products</h1>
  </header>

  <main class="products-page">
    <!-- Client-only mount to avoid SSR errors, pass filtered list -->
    <ShopApp client:only="react" products={ITEMS} items={ITEMS} />
  </main>

  <style>
    :root {
      --font-body: 'Inter', system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
      --font-head: 'Source Sans 3', 'Inter', system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
      --ink: #0f172a;
    }

    .products-header {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 16px 8px;
      border-bottom: 1px solid #e5e7eb;
    }
    .products-title {
      font-family: var(--font-head);
      font-weight: 700;
      letter-spacing: -0.01em;
      line-height: 1.15;
      margin: 0.5rem 0 0.25rem;
      color: var(--ink);
      font-size: clamp(1.8rem, 3.8vw, 2.4rem);
    }

    /* Page container + font scoping */
    .products-page {
      max-width: 1100px;
      margin: 0 auto;
      padding: 1rem 16px 3rem;
      font-family: var(--font-body);
      color: var(--ink);
    }
    .products-page :where(p, li, span, div, td, th, input, select, textarea, label, a) {
      font-family: var(--font-body);
    }
    .products-page :where(h1, h2, h3, h4, h5, h6) {
      font-family: var(--font-head);
      letter-spacing: -0.01em;
      line-height: 1.15;
    }
    .products-page h1 { font-weight: 700; }
    .products-page h2, .products-page h3, .products-page h4 { font-weight: 600; }
    .products-page :where(button, [role="button"], .button) { font-family: var(--font-body); font-weight: 600; }
    .products-page :where(input, select, textarea) { font-family: var(--font-body); }

    /* Hide any Buy-Now style buttons/links within the Products page only */
    .products-page a[href*="buy.stripe.com"],
    .products-page a.buy-now, .products-page .buy-now, .products-page .btn-buy-now, .products-page [data-variant="buy-now"],
    .products-page a[aria-label*="Buy"], .products-page a[aria-label*="buy"],
    .products-page button[aria-label*="Buy"], .products-page button[aria-label*="buy"],
    .products-page [title*="Buy"], .products-page [title*="buy"] {
      display: none !important;
    }

    /* === Add to Cart button: black/white, bold, pill, matches front page === */
    .products-page :where(button, a).add-to-cart,
    .products-page :where(button, a)[data-action="add-to-cart"],
    .products-page :where(button, a)[data-add-to-cart],
    .products-page :where(button, a)[data-sku],
    .products-page :where(button, a)[aria-label*="Add to Cart"],
    .products-page :where(button, a).btn-add-to-cart {
      background: #111827 !important;        /* near-black */
      color: #fff !important;
      border: 0 !important;
      border-radius: 9999px !important;
      padding: 10px 16px !important;
      min-width: 160px !important;
      font-weight: 700 !important;
      text-decoration: none !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      box-shadow: 0 6px 18px rgba(0,0,0,.18) !important;
      transition: transform .08s ease, opacity .15s ease !important;
      cursor: pointer !important;
      line-height: 1 !important;
    }
    .products-page :where(button, a)[aria-label*="Add to Cart"]:hover,
    .products-page :where(button, a)[data-action="add-to-cart"]:hover,
    .products-page :where(button, a)[data-add-to-cart]:hover,
    .products-page :where(button, a)[data-sku]:hover,
    .products-page :where(button, a).add-to-cart:hover,
    .products-page :where(button, a).btn-add-to-cart:hover {
      opacity: .92 !important;
      transform: translateY(-1px) !important;
    }
    .products-page :where(button, a)[aria-label*="Add to Cart"]:focus-visible,
    .products-page :where(button, a)[data-action="add-to-cart"]:focus-visible,
    .products-page :where(button, a)[data-add-to-cart]:focus-visible,
    .products-page :where(button, a)[data-sku]:focus-visible,
    .products-page :where(button, a).add-to-cart:focus-visible,
    .products-page :where(button, a).btn-add-to-cart:focus-visible {
      outline: 2px solid #111827 !important;
      outline-offset: 2px !important;
    }
  </style>

  <!-- Scoped script: remove any Buy-Now links injected dynamically only inside .products-page -->
  <script is:inline>
    const root = document.querySelector('.products-page');
    const kill = () => {
      if (!root) return;
      root.querySelectorAll(
        'a[href*="buy.stripe.com"], a.buy-now, .buy-now, .btn-buy-now, [data-variant="buy-now"], a[aria-label*="Buy"], a[aria-label*="buy"]'
      ).forEach(el => el.remove());
    };
    kill();
    document.addEventListener('DOMContentLoaded', kill);
    new MutationObserver(kill).observe(root, { childList: true, subtree: true });
  </script>
</BaseLayout>


