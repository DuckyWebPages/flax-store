---
// FILE: src/pages/blog/index.astro
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const title = 'Blog — Flax Lignan Health';
---

<BaseLayout>
  <Fragment slot="title">{title}</Fragment>

  <header class="blog-header">
    <h1>Blog</h1>
    <p class="lede">Research-driven insights and site updates.</p>
  </header>

  <main class="blog-list">
    {posts.length === 0 ? (
      <p class="empty">No posts yet. Check back soon.</p>
    ) : (
      posts.map((post) => {
        const url = `/blog/${post.slug}/`;
        const img = post.data.heroImage ?? post.data.image ?? null; // optional cover from frontmatter (string path)
        const alt = post.data.heroAlt ?? '';
        const date = post.data.date.toLocaleDateString('en-US', { year:'numeric', month:'long', day:'numeric' });
        const tags = post.data.tags ?? [];

        return (
          <article class="post-card">
            {img && (
              <a href={url} class="thumb" aria-hidden="true" tabindex="-1">
                <img src={img} alt={alt} loading="lazy" />
              </a>
            )}
            <div class="content">
              <h2 class="post-title">
                <a href={url} class="post-link">{post.data.title}</a>
              </h2>
              <p class="meta">
                {date}{tags.length ? ` • ${tags.join(', ')}` : ''}
              </p>
              {post.data.description && <p class="excerpt">{post.data.description}</p>}
            </div>
          </article>
        );
      })
    )}
  </main>

  <style>
    .blog-header{max-width:1100px;margin:0 auto 8px;padding:0 16px;border-bottom:1px solid #e5e7eb}
    .blog-header h1{font-weight:700;margin:.5rem 0 .25rem}
    .lede{color:#555;margin:0 0 .9rem}

    /* grid of cards */
    .blog-list{
      max-width:1100px;
      margin:0 auto;
      padding:1rem 16px 2.5rem;
      display:grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap:20px;
    }
    .empty{grid-column:1 / -1}

    .post-card{
      background:#fff;
      border:1px solid #eee;
      border-radius:16px;
      overflow:hidden;
      box-shadow:0 6px 18px rgba(0,0,0,.06);
      display:flex;
      flex-direction:column;
      transition:transform .12s ease, box-shadow .12s ease;
    }
    .post-card:hover{
      transform:translateY(-2px);
      box-shadow:0 10px 24px rgba(0,0,0,.10);
    }

    .thumb{display:block; line-height:0;}
    .thumb img{
      width:100%;
      height:auto;
      aspect-ratio:16/9;
      object-fit:cover;
      display:block;
    }

    .content{padding:14px 16px 16px}
    .post-title{margin:0 0 .35rem; font-weight:800; font-size:1.05rem;}
    .post-link{color:inherit; text-decoration:none;}
    .post-link:hover{text-decoration:underline;}
    .meta{color:#666; margin:0 0 .6rem; font-size:.92rem}
    .excerpt{margin:0; color:#222}
  </style>
</BaseLayout>
