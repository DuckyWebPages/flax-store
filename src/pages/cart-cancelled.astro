---
import BaseLayout from '@/layouts/BaseLayout.astro';
const pageTitle = 'Checkout canceled — ';
---

<BaseLayout>
  <Fragment slot="title">{pageTitle}</Fragment>

  <section style="max-width:800px;margin:0 auto;padding:24px 16px;">
    <h1>Checkout canceled</h1>
    <p>No worries—your cart is saved. You can update quantities or try again anytime. Or, if you'd prefer to speak to a customer service representative, give us a call at 1-710-817-6918!</p>
    <p><a href="/">Return to store</a></p>
  </section>
</BaseLayout>
