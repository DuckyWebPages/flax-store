---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Fineprint from '@/components/Fineprint.astro';

// ✅ fixed quotes (all single quotes)
const pageTitle = 'Ocean Cleanse - Natural Radiation and Metals Detox and Chelator';
const PRICE_DISPLAY = '$34.95'; // visible price; billing comes from Stripe price ID

// Keep existing small image for HERO (lightweight)
const IMG_HERO = '/images/products/oceanfloor.jpg';

// New horizontal photo for the CARD
const IMG_CARD = '/images/products/oceancleansefinal.png';
---

<BaseLayout>
  <Fragment slot="title">{pageTitle}</Fragment>

  <!-- HERO: Ocean Cleanse (faded image, no CTA) -->
  <section class="prod-hero">
    <img class="bg" src={IMG_HERO} alt="" />
    <div class="inner">
      <h1>Ocean Cleanse</h1>
      <p>
        Concentrated brown-seaweed extract used to support detoxification of heavy metals
        and radioactive elements while supporting thyroid, energy, and immune function.
      </p>
    </div>
  </section>

  <!-- PRODUCT CARD -->
  <section id="buy" class="content">
    <div class="card">
      <img
        class="card-img"
        src={IMG_CARD}
        alt="Ocean Cleanse (Single Jar)"
        loading="lazy"
        decoding="async"
      />
      <div class="card-body">
        <h1 class="card-title">Ocean Cleanse (Single Jar)</h1>
        <p class="card-price">{PRICE_DISPLAY}</p>

        <p class="card-desc">
          All natural source of iodine and helps remove and chelate heavy metals and toxins. This formula was originally formulated to support
          the people of Chernobyl in removing radiation. 
          A great support after you have metal fillings removed from teeth.
          Great for anyone with high exposure to heavy metals, radiation, environmental toxins or vaccines.
        </p>

        <!-- CTA -->
        <div class="product-cta">
          <button
            class="btn-cta add-to-cart"
            type="button"
            data-sku="ocean-cleanse-single"
            data-qty="1"
            data-name="Ocean Cleanse"
            data-image="/images/products/ocean-cleanse-square.png"
            data-price="3499"
            aria-label="Add Ocean Cleanse to cart"
          >
            Add to Cart
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Additional content -->
  <section class="content">
    <h2>About Ocean Cleanse</h2>
    <p>
      OCEAN CLEANSE is a concentrated extract from the richest type of brown seaweed.
      It's used to help detoxify and chelate heavy metals as well as radioactive elements, while supporting energy and immune function.
      90 capsules per bottle.
    </p>

    <h3>May help you:</h3>
    <ul>
      <li>Support immune function</li>
      <li>Support healthy blood sugar and cholesterol</li>
      <li>Support thyroid health</li>
      <li>Support healthy weight management</li>
      <li>Improve hair and nail appearance</li>
      <li>Support detoxification (e.g., strontium, cadmium)</li>
    </ul>

    <h3>What it delivers:</h3>
    <ul>
      <li><strong>Organic iodine</strong> - thyroid support</li>
      <li><strong>Fucoxanthin</strong> - 10&nbsp;mg per capsule</li>
      <li><strong>Alginate</strong> - binds certain heavy metals</li>
      <li><strong>Fucoidan</strong> - supports healthy immune activity</li>
      <li><strong>Laminarin</strong> - supports cardiovascular health</li>
      <li>Naturally occurring trace minerals and vitamins</li>
    </ul>
  </section>

  <style>
    /* ---------- HERO (faded image) ---------- */
    .prod-hero{
      position:relative; isolation:isolate; overflow:hidden;
      min-height:180px; border-radius:14px; background:#fff; margin:8px 0 18px;
    }
    .prod-hero .bg{
      position:absolute; inset:0; width:100%; height:100%;
      object-fit:cover; opacity:.18; z-index:-1;
    }
    .prod-hero .inner{
      padding:20px 16px 18px; max-width:1000px; margin:0 auto;
    }
    .prod-hero h1{ margin:0 0 8px; font-size:clamp(2rem,3vw,2.4rem); }
    .prod-hero p{ margin:0; max-width:70ch; }

    /* ---------- CONTENT + CARD ---------- */
    .content{max-width:1000px;margin:22px auto;padding:0 10px}
    .content h3{margin:1rem 0 .25rem;font-size:1.1rem}
    .content ul{margin:.25rem 0 .75rem;padding-left:1.2rem}

    .card{
      display:grid;
      grid-template-columns: 1fr;
      gap: 16px;
      background:#fff;
      border:1px solid #e5e7eb;
      border-radius:14px;
      overflow:hidden;
      box-shadow: 0 1px 2px rgba(0,0,0,.04);
    }
    @media (min-width: 720px){
      .card{grid-template-columns: 1fr 1fr;}
    }

    .card-img{
      width:100%;
      height:auto;
      object-fit:cover;
      background:#f8fafc;
      display:block;
    }
    .card-body{padding:18px}
    .card-title{margin:.25rem 0 .25rem;font-size:1.6rem}
    .card-price{margin:0 0 .5rem;font-weight:700}
    .card-desc{margin:0 0 .9rem;line-height:1.55}

    /* Button styling: compact & consistent */
    .product-cta .btn-cta {
      min-width: 220px;
      width: 100%;
      justify-content: center;
    }
    .btn-cta.add-to-cart{
  display: inline-flex;
  align-items: center;        /* ⬅ vertical centering */
  justify-content: center;    /* ⬅ horizontal centering */
  box-sizing: border-box;     /* avoid height/padding mismatch */
  height: var(--cart-btn-h, 44px);
  padding: 0 var(--cart-btn-px, 16px);
  line-height: 1;             /* fine now that flex is centering */
  white-space: nowrap;        /* prevent awkward wrapping */
}

    button.btn:focus { outline: 2px solid #11182722; outline-offset: 2px; }
  </style>
</BaseLayout>
