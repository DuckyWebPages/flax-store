---
import BaseLayout from '@/layouts/BaseLayout.astro';

const pageTitle = 'Essential Oils - ';

const items = [
  { key: 'lavender-15ml',           label: 'Lavender (15 ml)',           cents: 3651 },
  { key: 'thieves-15ml',            label: 'Thieves (15 ml)',            cents: 5230 },
  { key: 'peppermint-15ml',         label: 'Peppermint (15 ml)',         cents: 3322 },
  { key: 'orange-15ml',             label: 'Orange (15 ml)',             cents: 1678 },
  { key: 'grapefruit-15ml',         label: 'Grapefruit (15 ml)',         cents: 2632 },
  { key: 'tea-tree-15ml',           label: 'Tea Tree (15 ml)',           cents: 4013 },
  { key: 'sacred-frankincense-5ml', label: 'Sacred Frankincense (5 ml)', cents: 4975 },
  { key: 'panaway-5ml',             label: 'PanAway (5 ml)',             cents: 4175 },
  { key: 'idaho-blue-spruce-5ml',   label: 'Idaho Blue Spruce (5 ml)',   cents: 4474 }
];

const heroImage = '/images/products/oilsgreen.png';
---

<BaseLayout>
  <Fragment slot="title">{pageTitle}</Fragment>

  <section class="prodpg">
    <div class="prodpg__container">
      <h1 class="products-title">Essential Oils</h1>

      <div class="prodpg__grid">
        <article class="prodpg__card">
          <img src={heroImage} alt="Essential Oils" loading="lazy" />
          <h3>Essential Oil</h3>

          <p id="eoPrice" class="prodpg__price">From $0.00</p>

          <p class="prodpg__desc">
            Pure essential oils. Choose your oil (size is built into the option).
          </p>

          <label>
            <span style="display:block;font-weight:600;margin:0 0 .25rem">Oil</span>
            <select id="eoItem" style="width:100%;padding:10px;border:1px solid #ddd;border-radius:10px">
              {items.map(i => (
                <option value={i.key} data-cents={i.cents}>{i.label}</option>
              ))}
            </select>
          </label>

          <label>
            <span style="display:block;font-weight:600;margin:.5rem 0 .25rem">Quantity</span>
            <input id="eoQty" type="number" min="1" value="1" style="width:86px;padding:8px;border:1px solid #ddd;border-radius:10px" />
          </label>

          <button
            id="eoAdd"
            class="btn-cta add-to-cart"
            data-sku=""
            data-name=""
            data-price="0"
            data-image={heroImage}
            data-qty="1"
          >Add to Cart</button>
        </article>
      </div>
    </div>
  </section>

  <style>
   .prodpg { padding: 0 0 48px; }
   .prodpg__container { max-width: 1100px; margin: 0 auto; padding: 0 16px; }
   section.prodpg .prodpg__grid{
     display: grid !important;
     grid-template-columns: 1fr;
     row-gap: 16px !important;
     column-gap: 32px !important;
     margin: 10px 0 24px;
   }
   @media (min-width: 800px){
     section.prodpg .prodpg__grid{ grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }
     section.prodpg .prodpg__card{ margin: 0; box-sizing: border-box; }
     section.prodpg .prodpg__card:nth-child(odd){ margin-right: 32px; }
   }
   section.prodpg .prodpg__card{
     background:#fff; border:1px solid #e5e7eb; border-radius:14px; padding:16px;
     box-shadow:0 8px 18px rgba(0,0,0,.06); display:grid; gap:.65rem; justify-items:start;
     width:100%; max-width:none;
   }
   section.prodpg .prodpg__card img{
     width:100%; height:220px; object-fit:cover; border-radius:10px; display:block;
   }
   section.prodpg .prodpg__price{ font-weight:700; font-size:1.05rem; }
   section.prodpg .prodpg__desc{ line-height:1.5; color:#374151; font-size:.98rem; margin:.25rem 0 .5rem; }
  </style>

  <script is:inline>
    (function(){
      var items = {
        "lavender-15ml":           3651,
        "thieves-15ml":            5230,
        "peppermint-15ml":         3322,
        "orange-15ml":             1678,
        "grapefruit-15ml":         2632,
        "tea-tree-15ml":           4013,
        "sacred-frankincense-5ml": 4975,
        "panaway-5ml":             4175,
        "idaho-blue-spruce-5ml":   4474
      };

      var sel = document.getElementById('eoItem');
      var qty = document.getElementById('eoQty');
      var btn = document.getElementById('eoAdd');
      var priceEl = document.getElementById('eoPrice');

      function update(){
        var key   = sel.value;
        var label = sel.options[sel.selectedIndex].textContent || key;
        var cents = Number(sel.options[sel.selectedIndex].dataset.cents || items[key] || 0);

        btn.setAttribute('data-sku', "eo-" + key);
        btn.setAttribute('data-name', label);
        btn.setAttribute('data-price', String(cents));
        btn.setAttribute('data-qty', String(Math.max(1, parseInt(qty.value||'1',10))));

        priceEl.textContent = "$" + (cents/100).toFixed(2);
      }

      sel.addEventListener('change', update);
      qty.addEventListener('input', function(){
        var n = Math.max(1, parseInt(qty.value || '1', 10));
        qty.value = String(n);
        btn.setAttribute('data-qty', String(n));
      });

      update();
    })();
  </script>
</BaseLayout>