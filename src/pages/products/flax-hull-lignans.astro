    .card-photo-img { width: 100%; height: auto; aspect-ratio: 1 / 1; object-fit: cover; border-radius: 8px; display: block; }

    .card-media { width: 100%; aspect-ratio: 1 / 1; overflow: hidden; border-radius: 8px; background: #f7f7f7; box-shadow: 0 3px 6px rgba(0,0,0,.04); }
    .card-video {
      width: 100%; height: 100%; display: block; object-fit: cover; border-radius: 8px;
      opacity: 0; transition: opacity .2s ease;
    }
    .card-video.is-ready { opacity: 1; }

    @media (max-width: 900px) { .card-media { aspect-ratio: 4 / 3 !important; } }
    @media (max-width: 420px) { .card-media { aspect-ratio: 3 / 2 !important; } }

    .prodpg__title { margin: .25rem 0 0; line-height: 1.1; font-weight: 700; font-size: .95rem; }
    .prodpg__title .unit { display: block; font-weight: 600; font-size: .85rem; }
