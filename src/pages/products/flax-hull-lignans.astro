/* 1 column on small screens, 2 wide columns on desktop */
.prodpg__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 6px;
  justify-content: center;
}

@media (min-width: 980px) {
  .prodpg__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
