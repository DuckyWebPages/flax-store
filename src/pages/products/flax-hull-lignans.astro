---
import BaseLayout from '@/layouts/BaseLayout.astro'

const pageTitle = 'Flax Hull Lignans — '
---

<BaseLayout>
  <Fragment slot="title">{pageTitle}</Fragment>

  <section class="container product-detail">
    <h1 class="products-title">Flax Hull Lignans</h1>

    <!-- Single Jar -->
    <article class="product-card">
      <img
        src="/images/products/flax-hull-single.jpg"
        alt="Flax Hull Lignan single jar"
        width="400"
        height="400"
        loading="lazy"
      />
      <h2>Flax Hull Lignan (Single Jar)</h2>
      <p class="price">$49.95</p>

      <button
        class="btn-cta add-to-cart"
        data-sku="fhl-single"
        data-name="Flax Hull Lignan (Single Jar)"
        data-price="4995"
        data-image="/images/products/flax-hull-single.jpg"
        data-qty="1"
      >
        Add to Cart
      </button>
    </article>

    <!-- Bundle -->
    <article class="product-card">
      <img
        src="/images/products/flax-hull-bundle.jpg"
        alt="Flax Hull Lignan bundle"
        width="400"
        height="400"
        loading="lazy"
      />
      <h2>Flax Hull Lignan Bundle (3 Jars)</h2>
      <p class="price">$134.95 <span class="save">(Save 10%)</span></p>

      <button
        class="btn-cta add-to-cart"
        data-sku="fhl-bundle"
        data-name="Flax Hull Lignan Bundle (3 Jars)"
        data-price="13495"
        data-image="/images/products/flax-hull-bundle.jpg"
        data-qty="1"
      >
        Add Bundle to Cart
      </button>
    </article>
  </section>

  <style>
    .container{ max-width:1100px; margin:0 auto; padding:0 16px; }
    .product-detail {
      display: grid; gap: 16px; margin: 8px 0 48px;
      grid-template-columns: 1fr; align-items: start;
    }
    @media (min-width: 900px){
      .product-detail{ grid-template-columns: 1fr 1fr; }
    }
    .product-card {
      background: #fff;
      padding: 16px;
      border-radius: 14px;
      border: 1px solid #e5e7eb;
      box-shadow: 0 8px 18px rgba(0,0,0,.06);
      display: grid;
      justify-items: start;
      gap: .75rem;
    }
    .product-card img{
      width: 100%; height: auto; max-height: 360px; object-fit: cover; border-radius: 10px;
    }
    .price { font-weight: 700; font-size: 1.1rem; }
    .save { color:#16a34a; font-weight:700; }
  </style>
</BaseLayout>
