      height: 44px; padding: 0 16px; border-radius: 10px; border: 0;
      background:#c7cdd6; color:#111; font-size:16px; transition: background-color .15s ease, transform .05s ease;
    }
    .btn-cta:hover { background:#aeb6c1; }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.card-video').forEach((v) => {
        const reveal = () => v.classList.add('is-ready');
        v.addEventListener('canplay', reveal, { once: true });
