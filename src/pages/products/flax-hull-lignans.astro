---
/* FILE: src/pages/products/flax-hull-lignans.astro */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Fineprint from "@/components/Fineprint.astro";
import { shopifyQuery } from "@/lib/shopify"; // TS helper (no .js)

/** Shopify product handles (exact) */
const SHOPIFY_HANDLE_FHL = "fhl-flax-hull-lignans-single-jar";
const SHOPIFY_HANDLE_ANCIENT = "ancient-seeds-grains-better-than-organic-flax-hull-lignans-single-jar";
// Pick the first available variant; fall back to the first one
const pickVariant = (edges?: Array<{ node?: { availableForSale?: boolean } }>) =>
  edges?.find(e => e?.node?.availableForSale)?.node ?? edges?.[0]?.node ?? null;

// Optional: currency formatter
const fmt = (amt: string, cur: string) =>
  new Intl.NumberFormat('en-US', { style: 'currency', currency: cur }).format(Number(amt));

/* Query Shopify for product data + first sellable variant */
const PRODUCT_QUERY = /* GraphQL */ `
  query ProductByHandle($handle: String!) {
    product(handle: $handle) {
      title
      handle
      descriptionHtml
      images(first: 1) { edges { node { url altText } } }
      variants(first: 10) {
        edges {
          node {
            id
            title
            availableForSale
            priceV2 { amount currencyCode }  # safer than deprecated 'price'
          }
        }
      }
    }
  }
`;

let productFHL = null, variantFHL = null, productAncient = null, variantAncient = null;
let shopifyError = "";


try {
  const dataFHL = await shopifyQuery(PRODUCT_QUERY, { handle: SHOPIFY_HANDLE_FHL });
  productFHL = dataFHL?.product ?? null;
  variantFHL = pickVariant(productFHL?.variants?.edges);


  const dataAncient = await shopifyQuery(PRODUCT_QUERY, { handle: SHOPIFY_HANDLE_ANCIENT });
  productAncient = dataAncient?.product ?? null;
variantAncient = pickVariant(productAncient?.variants?.edges);

} catch (e) {
  shopifyError = e?.message || String(e);
}

const pageTitle = "Flax Hull Lignans — ";

// Videos (posters only for <noscript> fallback)
const VID_FHL = "/videos/flaxlignanjar.mp4";
const POSTER_FHL = "/images/products/Flax4K.jpg";
const VID_ANCIENT = "/videos/ancientseeds.mp4";
const POSTER_ANCIENT = "/images/products/Ancientseedswood.jpg";


