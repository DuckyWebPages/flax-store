}

/* Make media stay inside the white panel */
.prodpg .card-photo,
.prodpg .card-media,
.prodpg .card-video,
.prodpg .card-photo-img {
  border-radius: 8px !important;
  background: #f7f7f7;
  overflow: hidden;
}

/* Keep the grid from collapsing */
.prodpg__grid {
  display: grid;
  gap: 6px;
}

@media (min-width: 980px) {
  .prodpg__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* Container wide enough to show two nice, wide cards */
.prodpg__container { max-width: 1180px; margin: 0 auto; padding: 0 12px; }


    
    .prodpg__card:hover { transform: translateY(-2px); }

