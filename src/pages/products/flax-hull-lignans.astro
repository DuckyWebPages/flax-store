/* FILE: src/pages/products/flax-oil-lignans.astro */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Fineprint from '@/components/Fineprint.astro';

const pageTitle = "Flax Hull Lignans — ";
const PRICE_FHL_CENTS = 3900;
const PRICE_FHL_DISPLAY = `$${(PRICE_FHL_CENTS / 100).toFixed(2)}`;
const PRICE_ANCIENT_CENTS = 4500;
const PRICE_ANCIENT_DISPLAY = `$${(PRICE_ANCIENT_CENTS / 100).toFixed(2)}`;

// Videos (keep posters ONLY for <noscript> fallback, not on <video>)
const VID_FHL = '/videos/flaxlignanjar.mp4';
const POSTER_FHL = '/images/products/Flax4K.jpg';
const VID_ANCIENT = '/videos/ancientseeds.mp4';
const POSTER_ANCIENT = '/images/products/Ancientseedswood.jpg';
---

<BaseLayout>
  <Fragment slot="title">{pageTitle}</Fragment>

  <!-- HERO -->
  <section class="prod-hero">
    <img class="bg" src="/images/products/flaxfield.png" alt="" />
    <div class="inner">
      <h1>Flax Hull Lignans</h1>
      <p>
        Concentrated SDG lignans from flax hulls to support hormone balance, healthy
        inflammation response, and everyday immune wellness. Used in foundational strategies to support the body's fight against damaged DNA. See our "Blog" tab to learn more about the research. Easy to add to smoothies,
        yogurt, or any food. Light, nutty flavor.
      </p>
    </div>
  </section>

  <section class="prodpg">
    <div class="prodpg__container">
      <h2 class="products-title sr-only">Products</h2>

      <div class="prodpg__grid">
        <!-- Card: Flax Hull Lignans (Single Jar) -->
        <article class="prodpg__card">
          <div class="card-photo">
            <div class="card-media">
              <video
                class="card-video"
                src={VID_FHL}
                autoplay
                muted
                loop
                playsinline
                preload="auto"
              ></video>
            </div>
            <noscript>
              <img
                src={POSTER_FHL}
                alt="Flax Hull Lignans (Single Jar)"
                loading="eager"
                decoding="async"
                class="card-photo-img"
              />
            </noscript>
          </div>

          <h3 class="prodpg__title">Flax Hull Lignans <span class="unit">(Single Jar)</span></h3>
          <p class="prodpg__price">{PRICE_FHL_DISPLAY}</p>

          <ul class="prodpg__bullets">
            <li>Very high in antioxidants</li>
            <li>Great in cereal, yogurt, or baking - heat doesn't hurt lignan activity</li>
            <li>No chemicals used in processing</li>
            <li>150-300 mg SDG per 1.5 tsp serving</li>
            <li>Full-spectrum 17 lignans present</li>
            <li>220 mg ALA (alpha-linolenic acid) per scoop</li>
          </ul>

          <p class="prodpg__desc">
            MCP-processed, concentrated SDG lignans from brown flax hulls. Take 1/2 - 1 scoop (provided) a day for foundational
            wellness and immune support. Farmer still uses strict sourcing standards, but depending on what is available, cannot guarantee non-GMO.
          </p>

          <div class="product-cta">
            <button
              class="btn-cta add-to-cart"
              data-sku="fhl-single"
              data-price={String(PRICE_FHL_CENTS)}
              data-qty="1"
              data-name="Flax Hull Lignans (Single Jar)"
              data-image="/images/products/flaxfield.jpg"
            >
              Add to Cart
            </button>
          </div>
        </article>

        <!-- Card: Ancient Seeds & Grains (Single Jar) -->
        <article class="prodpg__card">
          <div class="card-photo">
            <div class="card-media">
              <video
                class="card-video"
                src={VID_ANCIENT}
                autoplay
                muted
                loop
                playsinline
                preload="auto"
              ></video>
            </div>
            <noscript>
              <img
                src={POSTER_ANCIENT}
                alt="FLH Ancient Seeds & Grains (Single Jar)"
                loading="eager"
                decoding="async"
                class="card-photo-img"
              />
            </noscript>
          </div>

          <h3 class="prodpg__title">FLH Ancient Seeds &amp; Grains <span class="unit">(Single Jar is $45, 3 jars is $135)</span></h3>
          <p class="prodpg__price">{PRICE_ANCIENT_DISPLAY}</p>

          <ul class="prodpg__bullets">
            <li>Very high in antioxidants</li>
            <li>Great in cereal, yogurt, or baking - heat doesn't hurt lignan activity</li>
            <li>No chemicals used in processing</li>
            <li>150-300 mg SDG per 1.5 tsp serving</li>
            <li>Full-spectrum 17 lignans present</li>
            <li>220 mg ALA (alpha-linolenic acid) per scoop</li>
          </ul>

          <p class="prodpg__desc">
            MCP-processed, non-GMO flax hull lignans with stricter sourcing than today's organic
            label. Take 1/2 - 1 scoop (provided) a day for foundational wellness and immune support.
          </p>

          <div class="product-cta">
            <button
              class="btn-cta add-to-cart"
              data-sku="ancient-single"
              data-price={String(PRICE_ANCIENT_CENTS)}
              data-qty="1"
              data-name="FLH Ancient Seeds & Grains (Single Jar)"
              data-image="/images/products/flaxsinglefield.jpg"
            >
              Add to Cart
            </button>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Full-width Testimonials band (unchanged) -->
  <section class="tbox tbox--bleed" aria-labelledby="flax-testimonials-heading">
    <!-- ... keep your testimonials exactly as-is ... -->
  </section>

  <style>
    /* ---------- HERO ---------- */
    .prod-hero {
      position: relative; isolation: isolate; overflow: hidden;
      min-height: 150px; border-radius: 14px; background: #fff;
      margin: 8px auto 18px; max-width: 950px;
    }
    .prod-hero .bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .18; z-index: -1; }
    .prod-hero .inner { padding: 16px; max-width: 850px; margin: 0 auto; }
    .prod-hero h1 { margin: 0 0 6px; font-size: clamp(1.7rem, 2.3vw, 2rem); }
    .prod-hero p { margin: 0; max-width: 60ch; }

    /* ---------- PRODUCT GRID ---------- */
    .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); border: 0; }

    .prodpg { padding: 0 0 36px; }
    .prodpg__container { max-width: 950px; margin: 0 auto; padding: 0 12px; }

    .prodpg__grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 20px; justify-content: center;
    }

    .prodpg__card {
      background: #fff; border: 1px solid #e5e7eb; border-radius: 12px;
      padding: 10px; box-shadow: 0 4px 10px rgba(0,0,0,.05);
      display: grid; gap: .35rem; justify-items: start;
      max-width: 340px; margin: 0 auto; transition: transform .15s ease;
    }
    .prodpg__card:hover { transform: translateY(-2px); }

    .card-photo { position: relative; width: 100%; overflow: hidden; border-radius: 8px; background: #f7f7f7; box-shadow: 0 3px 6px rgba(0,0,0,.04); }
    .card-photo-img { width: 100%; height: auto; aspect-ratio: 1 / 1; object-fit: cover; border-radius: 8px; display: block; }

    .card-media { width: 100%; aspect-ratio: 1 / 1; overflow: hidden; border-radius: 8px; background: #f7f7f7; box-shadow: 0 3px 6px rgba(0,0,0,.04); }
    .card-video {
      width: 100%; height: 100%; display: block; object-fit: cover; border-radius: 8px;
      opacity: 0; transition: opacity .2s ease; /* start hidden to avoid flash */
    }
    .card-video.is-ready { opacity: 1; }

    @media (max-width: 900px) { .card-media { aspect-ratio: 4 / 3 !important; } }
    @media (max-width: 420px) { .card-media { aspect-ratio: 3 / 2 !important; } }

    .prodpg__title { margin: .25rem 0 0; line-height: 1.1; font-weight: 700; font-size: .95rem; }
    .prodpg__title .unit { display: block; font-weight: 600; font-size: .85rem; }
    .prodpg__price { font-weight: 800; font-size: .9rem; margin: .1rem 0 .2rem; }
    .prodpg__bullets { margin: .05rem 0 .3rem; padding-left: 1rem; font-size: .85rem; }
    .prodpg__bullets li { margin: .08rem 0; }
    .prodpg__desc { line-height: 1.4; color: #374151; font-size: .85rem; margin: .15rem 0 .25rem; }

    .product-cta .add-to-cart {
      display: inline-flex; height: var(--cart-btn-h, 44px); padding: 0 var(--cart-btn-px, 16px);
      line-height: 1; font-size: var(--cart-btn-fs, 16px); font-weight: var(--cart-btn-weight, 400);
      letter-spacing: .01em; border-radius: var(--cart-btn-radius, 10px);
      background: var(--cart-btn-bg, #c7cdd6); color: var(--cart-btn-fg, #111);
      border: 0; text-decoration: none; cursor: pointer; align-items: center; justify-content: center;
      white-space: nowrap; transition: background-color .15s ease, transform .05s ease;
    }
    .product-cta .add-to-cart:hover { background: var(--cart-btn-bg-hover, #aeb6c1); }

    /* ===== Testimonials (full-bleed band) ===== */
    .tbox--bleed { width: 100vw; margin-left: 50%; transform: translateX(-50%); background: #fafafa; border-top: 1px solid #ececec; border-bottom: 1px solid #ececec; padding: 28px 0 40px; }
    .tbox__container { max-width: 1100px; margin: 0 auto; padding: 0 16px; }
    .tbox h2 { margin: 0 0 6px; font-size: clamp(1.2rem, 2.2vw, 1.5rem); }
    .tbox__lead { margin: 0 0 14px; color: #475569; font-size: .95rem; }
    .tlist { display: grid; grid-template-columns: 1fr; gap: 14px; }
    @media (min-width: 820px) { .tlist { grid-template-columns: 1fr 1fr; } }
    .tquote { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 14px; box-shadow: 0 4px 10px rgba(0,0,0,.05); }
    .tquote blockquote { margin: 0 0 8px; position: relative; padding-left: 12px; color: #0f172a; line-height: 1.5; }
    .tquote blockquote::before { content: "“"; position: absolute; left: -4px; top: -6px; font-size: 2rem; line-height: 1; opacity: .2; }
    .tquote figcaption { font-size: .9rem; color: #475569; }

    /* ===== HARD OVERRIDES (phones) ===== */
    @media (max-width: 900px) {
      .prodpg__container { max-width: 680px !important; }
      .prodpg__grid { display: grid !important; grid-template-columns: 1fr !important; gap: 20px !important; justify-items: stretch !important; align-items: start !important; }
      .prodpg__card { width: 100% !important; max-width: none !important; padding: 16px !important; border-radius: 14px !important; }
      .card-photo-img { aspect-ratio: 4 / 3 !important; object-fit: cover !important; }
      .prodpg__title { font-size: 1.2rem !important; line-height: 1.25 !important; }
      .prodpg__price { font-size: 1.3rem !important; font-weight: 800 !important; }
      .prodpg__bullets, .prodpg__desc { font-size: 1.02rem !important; line-height: 1.55 !important; }
      .product-cta .add-to-cart { height: 54px !important; padding: 0 22px !important; font-size: 18px !important; font-weight: 800 !important; border-radius: 12px !important; min-width: 240px !important; }
    }
    @media (max-width: 420px) {
      .prodpg__container { max-width: 100% !important; }
      .card-photo-img { aspect-ratio: 3 / 2 !important; }
      .prodpg__title { font-size: 1.25rem !important; }
      .prodpg__price { font-size: 1.35rem !important; }
      .product-cta .add-to-cart { min-width: 100% !important; }
    }
  </style>

  <!-- Reveal all product videos only when they can play -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const vids = document.querySelectorAll('.card-video');
      vids.forEach(v => {
        const reveal = () => v.classList.add('is-ready');
        v.addEventListener('canplay', reveal, { once: true });
        if (v.readyState >= 3) reveal();
      });
    });
  </script>
</BaseLayout>

<!-- redeploy bump -->
