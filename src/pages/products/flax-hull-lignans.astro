---
// FILE: src/pages/products/flax-oil-lignans.astro
import BaseLayout from '@/layouts/BaseLayout.astro'

const pageTitle = 'Flax Hull Lignans â€” '
const PRICE_FHL_CENTS = 3900
const PRICE_FHL_DISPLAY = `$${(PRICE_FHL_CENTS / 100).toFixed(2)}`
const PRICE_ANCIENT_CENTS = 4500
const PRICE_ANCIENT_DISPLAY = `$${(PRICE_ANCIENT_CENTS / 100).toFixed(2)}`
---

<BaseLayout>
  <Fragment slot="title">{pageTitle}</Fragment>

  <!-- HERO -->
  <section class="prod-hero">
    <img class="bg" src="/images/products/flaxfield.jpg" alt="" />
    <div class="inner">
      <h1>Flax Hull Lignans</h1>
      <p>
        Concentrated SDG lignans from flax hulls to support hormone balance, healthy
        inflammation response, and everyday immune wellness. Used in foundational strategies to support the body's fight against damaged DNA. Easy to add to smoothies,
        yogurt, or any food. Light, nutty flavor.
      </p>
    </div>
  </section>

  <section class="prodpg">
    <div class="prodpg__container">
      <h2 class="products-title sr-only">Products</h2>

      <div class="prodpg__grid">
        <!-- Card: Flax Hull Lignans (Single Jar) -->
        <article class="prodpg__card">
          <div class="card-photo">
            <img
              src="/images/products/flaxfield.jpg"
              alt="Flax Hull Lignans (Single Jar)"
              loading="eager"
              decoding="async"
              class="card-photo-img"
            />
          </div>

          <h3 class="prodpg__title">Flax Hull Lignans <span class="unit">(Single Jar)</span></h3>
          <p class="prodpg__price">{PRICE_FHL_DISPLAY}</p>

          <ul class="prodpg__bullets">
            <li>Very high in antioxidants</li>
            <li>Great in cereal, yogurt, or baking</li>
            <li>No chemicals used in processing</li>
            <li>150-300 mg SDG per 1.5 tsp serving</li>
            <li>Full-spectrum 17 lignans present</li>
            <li>220 mg ALA (alpha-linolenic acid) per scoop</li>
          </ul>

          <p class="prodpg__desc">
            Concentrated SDG lignans from brown flax hulls. Take 1/2 - 1 scoop (provided) a day for foundational
            wellness and immune support.
          </p>

          <div class="product-cta">
            <button
              class="btn-cta add-to-cart"
              data-sku="fhl-single"
              data-price={String(PRICE_FHL_CENTS)}
              data-qty="1"
              data-name="Flax Hull Lignans (Single Jar)"
              data-image="/images/products/flaxfield.jpg"
            >
              Add to Cart
            </button>
          </div>
        </article>

        <!-- Card: Ancient Seeds & Grains (Single Jar) -->
        <article class="prodpg__card">
          <div class="card-photo">
            <img
              src="/images/products/flaxsinglefield.jpg"
              alt="FLH Ancient Seeds &amp; Grains (Single Jar)"
              loading="eager"
              decoding="async"
              class="card-photo-img"
            />
          </div>

          <h3 class="prodpg__title">FLH Ancient Seeds &amp; Grains <span class="unit">(Single Jar)</span></h3>
          <p class="prodpg__price">{PRICE_ANCIENT_DISPLAY}</p>

          <ul class="prodpg__bullets">
            <li>Very high in antioxidants</li>
            <li>Great in cereal, yogurt, or baking</li>
            <li>No chemicals used in processing</li>
            <li>150-300 mg SDG per 1.5 tsp serving</li>
            <li>Full-spectrum 17 lignans present</li>
            <li>220 mg ALA (alpha-linolenic acid) per scoop</li>
          </ul>

          <p class="prodpg__desc">
            MCP-processed, non-GMO flax hull lignans with stricter sourcing than today's organic
            label. Take 1/2 - 1 scoop (provided) a day for foundational wellness and immune support.
          </p>

          <div class="product-cta">
            <button
              class="btn-cta add-to-cart"
              data-sku="ancient-single"
              data-price={String(PRICE_ANCIENT_CENTS)}
              data-qty="1"
              data-name="FLH Ancient Seeds & Grains (Single Jar)"
              data-image="/images/products/flaxsinglefield.jpg"
            >
              Add to Cart
            </button>
          </div>
        </article>
      </div>
    </div>
  </section>

  <style>
    /* ---------- HERO (faded background image) ---------- */
    .prod-hero{
      position:relative; isolation:isolate; overflow:hidden;
      min-height:180px; border-radius:14px; background:#fff; margin:8px 0 18px;
    }
    .prod-hero .bg{
      position:absolute; inset:0; width:100%; height:100%;
      object-fit:cover; opacity:.18; z-index:-1;
    }
    .prod-hero .inner{
      padding:20px 16px 18px; max-width:1100px; margin:0 auto;
    }
    .prod-hero h1{ margin:0 0 8px; font-size:clamp(2rem,3vw,2.4rem); }
    .prod-hero p{ margin:0; max-width:70ch; }

    /* ---------- PRODUCT GRID ---------- */
    .sr-only{ position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); border:0; }

    .prodpg { padding: 0 0 48px; }
    .prodpg__container { max-width: 1100px; margin: 0 auto; padding: 0 16px; }

    section.prodpg .prodpg__grid {
      display: grid !important;
      grid-template-columns: 1fr;
      row-gap: 16px !important;
      column-gap: 32px !important;
      margin: 10px 0 24px;
    }
    @media (min-width: 800px) {
      section.prodpg .prodpg__grid { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }
      section.prodpg .prodpg__card { margin: 0; box-sizing: border-box; }
      section.prodpg .prodpg__card:nth-child(odd) { margin-right: 32px; }
    }

    section.prodpg .prodpg__card {
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 14px;
      padding: 16px;
      box-shadow: 0 8px 18px rgba(0,0,0,.06);
      display: grid;
      gap: .55rem;
      justify-items: start;
      width: 100%;
    }

    .card-photo{ width:100%; aspect-ratio: 3 / 4; overflow:hidden; border-radius:10px; background:#f7f7f7; box-shadow:0 8px 18px rgba(0,0,0,.05); }
    .card-photo-img{ width:100%; height:100%; display:block; object-fit:cover; object-position:center; }

    .prodpg__title{ margin:.35rem 0 0; line-height:1.15; font-weight:700; }
    .prodpg__title .unit{ display:block; font-weight:600; }
    .prodpg__price{ font-weight:800; font-size:1.05rem; margin:.15rem 0 .25rem; }

    .prodpg__bullets{ margin:.1rem 0 .45rem; padding-left:1.1rem; }
    .prodpg__bullets li{ margin:.18rem 0; }

    .prodpg__desc{ line-height:1.5; color:#374151; font-size:.98rem; margin:.25rem 0 .35rem; }

    .product-cta{ display:flex; align-items:center; gap:12px; flex-wrap:wrap; margin-top:.25rem; }
    .product-cta .add-to-cart{ display:inline-flex !important; width:auto !important; min-width:160px; align-items:center; justify-content:center; white-space:nowrap; align-self:start; }
  </style>
</BaseLayout>
