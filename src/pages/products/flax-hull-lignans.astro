---
import BaseLayout from '@/layouts/BaseLayout.astro'

const pageTitle = 'Flax Hull Lignans — '
---

<BaseLayout>
  <Fragment slot="title">{pageTitle}</Fragment>

  <section class="product-detail">
    <h1 class="products-title">Flax Hull Lignans</h1>

    <!-- Single Jar -->
    <article class="product-card">
      <img
        src="/images/products/flax-hull-single.jpg"
        alt="Flax Hull Lignan single jar"
        width="400"
        height="400"
      />
      <h2>Flax Hull Lignan (Single Jar)</h2>
      <p class="price">$49.95</p>

      <button
        class="btn-cta add-to-cart"
        data-sku="fhl-single"
        data-name="Flax Hull Lignan (Single Jar)"
        data-price="4995"
        data-image="/images/products/flax-hull-single.jpg"
        data-qty="1"
      >
        Add to Cart
      </button>
    </article>

    <!-- Bundle -->
    <article class="product-card">
      <img
        src="/images/products/flax-hull-bundle.jpg"
        alt="Flax Hull Lignan bundle"
        width="400"
        height="400"
      />
      <h2>Flax Hull Lignan Bundle (3 Jars)</h2>
      <p class="price">$134.95 (Save 10%)</p>

      <button
        class="btn-cta add-to-cart"
        data-sku="fhl-bundle"
        data-name="Flax Hull Lignan Bundle (3 Jars)"
        data-price="13495"
        data-image="/images/products/flax-hull-bundle.jpg"
        data-qty="1"
      >
        Add Bundle to Cart
      </button>
    </article>
  </section>

  <style>
    .product-detail {
      display: grid;
      gap: 2rem;
    }
    .product-card {
      background: #fff;
      padding: 1.5rem;
      border-radius: 1rem;
      box-shadow: 0 4px 14px rgba(0,0,0,.08);
      display: grid;
      justify-items: start;
      gap: .75rem;
    }
    .price {
      font-weight: 600;
      font-size: 1.1rem;
    }
  </style>
</BaseLayout>
