---
// FILE: src/pages/products/flax-hull-lignans.astro
import BaseLayout from '@/layouts/BaseLayout.astro'

const pageTitle = 'Flax Hull Lignans — '
const PRICE_FHL_CENTS = 3900
const PRICE_FHL_DISPLAY = `$${(PRICE_FHL_CENTS / 100).toFixed(2)}`
const PRICE_ANCIENT_CENTS = 4500
const PRICE_ANCIENT_DISPLAY = `$${(PRICE_ANCIENT_CENTS / 100).toFixed(2)}`
---

<BaseLayout>
  <Fragment slot="title">{pageTitle}</Fragment>

  <!-- HERO -->
  <section class="prod-hero">
    <img class="bg" src="/images/products/FHLSingleGreen.png" alt="" />
    <div class="inner">
      <h1>Flax Hull Lignans</h1>
      <p>
        Concentrated SDG lignans from flax hulls to support hormone balance, healthy inflammation
        response, and everyday immune wellness. Pure, potent, and easy to add to smoothies, yogurt,
        or water.
       
      </p>
    </div>
  </section>

  <section class="prodpg">
    <div class="prodpg__container">
      <h2 class="products-title sr-only">Products</h2>

      <div class="prodpg__grid">
        <!-- Card: Flax Hull Lignans (Single Jar) -->
        <article class="prodpg__card">
          <div class="card-photo">
            <img
              src="/images/products/FHLSingleGreen.png"
              alt="Flax Hull Lignans (Single Jar)"
              loading="eager"
              decoding="async"
              class="card-photo-img"
            />
          </div>

          <h3 class="prodpg__title">
            Flax Hull Lignans
            <span class="unit">(Single Jar)</span>
          </h3>

          <p class="prodpg__price">{PRICE_FHL_DISPLAY}</p>

          <p class="prodpg__desc">
            Concentrated SDG lignans from brown flax hulls—simple daily scoop for foundational wellness.
          </p>

            <ul class="prodpg__bullets">
            <li>Very High in Antioxidants</li>
            <li>Great in cereal, yogurt, or baking</li>
            <li>No chemicals used in processing</li>
            <li>150-300 mg SDG per 1.5 tsp serving</li>
            <li>Full Spectrum 17 lignans present</li>
            <li>1 scoop equals 220 mg ALA (Alpha-Linolenic Acid)</li>
          </ul>

          <div class="product-cta">
            <button
              class="btn-cta add-to-cart"
              data-sku="fhl-single"
              data-price={String(PRICE_FHL_CENTS)}
              data-qty="1"
              data-name="Flax Hull Lignans (Single Jar)"
              data-image="/images/products/FHLSingleGreen.png"
            >
              Add to Cart
            </button>
          </div>
        </article>

        <!-- Card: Ancient Seeds & Grains (Single Jar) -->
        <article class="prodpg__card">
          <div class="card-photo">
            <img
              src="/images/ancient-single-small.png"
              alt="FLH Ancient Seeds & Grains (Single Jar)"
              loading="eager"
              decoding="async"
              class="card-photo-img"
            />
          </div>

          <h3 class="prodpg__title">
            FLH Ancient Seeds &amp; Grains
            <span class="unit">(Single Jar)</span>
          </h3>

          <p class="prodpg__price">{PRICE_ANCIENT_DISPLAY}</p>

          <p class="prodpg__desc">
            MCP Processed “Better Than Organic” Flax Hull Lignans are the highest grade you can get. We also have MCP Processed commercial lignans which are also high quality, but they aren’t as strict standards as this one.

The Organic industry has changed over the past few years, and not for the better. The word “organic” now allows for cross pollinated GMO products to be used in anything that is certified organic, up to 8%. We feel this is a problem when many customers are buying organic thinking they are getting non-gmo. Our flax hull lignans are no longer certified organic, but they are certified “USA Ancient Seeds” which holds a HIGHER STANDARD than “organic”.

We know that there is going to be an educational period where our customers are going to have to learn about this new certification and why we are doing it, but we want these lignans to not only hold up to organic standards, but NON-GMO standards as well. Nothing has changed in our product, just the paperwork. We still have all the standards of organic, we just have a few higher standards that we are embracing.

There is no GMO flax used in these flax hull lignans. On that note, our manufacturer always avoids GMO sources for commercial lignans as well but he says that it’s possible to get some every once in awhile if he isn’t specifically purchasing “Non-GMO” flax – which is reserved for this product and costs more.

          <ul class="prodpg__bullets">
            <li>Very High in Antioxidants</li>
            <li>Great in cereal, yogurt, or baking</li>
            <li>No chemicals used in processing</li>
            <li>150-300 mg SDG per 1.5 tsp serving</li>
            <li>Full Spectrum 17 lignans present</li>
            <li>1 scoop equals 220 mg ALA (Alpha-Linolenic Acid)</li>
          </ul>

          <div class="product-cta">
            <button
              class="btn-cta add-to-cart"
              data-sku="ancient-single"
              data-price={String(PRICE_ANCIENT_CENTS)}
              data-qty="1"
              data-name="FLH Ancient Seeds & Grains (Single Jar)"
              data-image="/images/ancient-single-small.png"
            >
              Add to Cart
            </button>
          </div>
        </article>
      </div>
    </div>
  </section>

  <style>
    /* ---------- HERO (faded background image) ---------- */
    .prod-hero{
      position:relative; isolation:isolate; overflow:hidden;
      min-height:180px; border-radius:14px; background:#fff; margin:8px 0 18px;
    }
    .prod-hero .bg{
      position:absolute; inset:0; width:100%; height:100%;
      object-fit:cover; opacity:.18; z-index:-1;
    }
    .prod-hero .inner{
      padding:20px 16px 18px; max-width:1100px; margin:0 auto;
    }
    .prod-hero h1{ margin:0 0 8px; font-size:clamp(2rem,3vw,2.4rem); }
    .prod-hero p{ margin:0; max-width:70ch; }

    /* ---------- PRODUCT GRID ---------- */
    .sr-only{ position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); border:0; }

    .prodpg { padding: 0 0 48px; }
    .prodpg__container { max-width: 1100px; margin: 0 auto; padding: 0 16px; }

    section.prodpg .prodpg__grid {
      display: grid !important;
      grid-template-columns: 1fr;
      row-gap: 16px !important;
      column-gap: 32px !important;
      margin: 10px 0 24px;
    }
    @media (min-width: 800px) {
      section.prodpg .prodpg__grid { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }
      section.prodpg .prodpg__card { margin: 0; box-sizing: border-box; }
      section.prodpg .prodpg__card:nth-child(odd) { margin-right: 32px; }
    }

    section.prodpg .prodpg__card {
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 14px;
      padding: 16px;
      box-shadow: 0 8px 18px rgba(0,0,0,.06);
      display: grid;
      gap: .65rem;
      justify-items: start;
      width: 100%;
      max-width: none;
    }

    /* Vertical card image: 3:4 frame that crops wide photos nicely */
    .card-photo{
      width: 100%;
      aspect-ratio: 3 / 4;
      overflow: hidden;
      border-radius: 10px;
      background: #f7f7f7;
      box-shadow: 0 8px 18px rgba(0,0,0,.05);
    }
    .card-photo-img{
      width: 100%; height: 100%; display: block;
      object-fit: cover;
      object-position: center;
    }

    .prodpg__title{ margin: .25rem 0 0; line-height: 1.2; }
    .prodpg__title .unit{ display:block; font-weight:600; }

    section.prodpg .prodpg__price { font-weight: 700; font-size: 1.05rem; }
    section.prodpg .prodpg__desc { line-height: 1.5; color: #374151; font-size: .98rem; margin: .25rem 0 .5rem; }
    .prodpg__bullets { margin: 0 0 .5rem; padding-left: 1.1rem; }
    .prodpg__bullets li { margin: .25rem 0; }

    .product-cta { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    .product-cta .add-to-cart{
      display:inline-flex !important; width:auto !important; min-width:160px;
      align-items:center; justify-content:center; white-space:nowrap; align-self:start;
    }
  </style>
</BaseLayout>
