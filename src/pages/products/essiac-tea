---
import BaseLayout from '@/layouts/BaseLayout.astro';
const pageTitle = 'Essiac Tea — ';
---

<BaseLayout>
  <Fragment slot="title">{pageTitle}</Fragment>

  <section class="prod-hero">
    <img class="bg" src="/images/essiac-tea.png" alt="" />
    <div class="inner">
      <h1>Essiac Tea</h1>
      <p>Traditional herbal blend with a long history of wellness use and gentle daily support.</p>
      <a href="/products" class="btn">Shop Now</a>
    </div>
  </section>

  <section class="content">
    <h2>About Essiac Tea</h2>
    <p>Include ingredients, preparation tips, and links to sizes or bundles when ready.</p>
  </section>

  <style>
    .prod-hero{position:relative;isolation:isolate;overflow:hidden;min-height:360px;border-radius:14px;background:#fff;margin-top:8px}
    .bg{position:absolute;inset:0;object-fit:cover;width:100%;height:100%;opacity:.18;z-index:-1}
    .inner{padding:36px 20px 28px;max-width:900px;margin:0 auto}
    .inner h1{margin:0 0 8px;font-size:clamp(2rem,3vw,2.6rem)}
    .inner p{margin:0 0 14px;max-width:60ch}
    .btn{display:inline-flex;gap:.5rem;align-items:center;justify-content:center;padding:10px 16px;border-radius:999px;background:#111827;color:#fff;text-decoration:none;font-weight:700}
    .content{max-width:900px;margin:22px auto;padding:0 4px}
  </style>
</BaseLayout>
