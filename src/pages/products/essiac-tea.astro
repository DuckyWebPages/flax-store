---
import BaseLayout from '@/layouts/BaseLayout.astro';

const TITLE = 'Essiac Tea â€” Famous 8 Herb Recipe (Single)';
const PRICE_DISPLAY = '$40.50';
const PRICE_CENTS = 4050;               // 40.50 â†’ 4050 (cart wants cents)
const SKU = 'essiac-tea-single';
const IMG = '/images/products/essiacgreen.png';  // ensure this file exists

const pageTitle = 'Essiac Tea â€” ';
---

<BaseLayout>
  <Fragment slot="title">{pageTitle}</Fragment>

  <!-- HERO (half height; faded background image; NO add-to-cart here) -->
  <section class="prod-hero">
    <img class="bg" src={IMG} alt="" />
    <div class="inner">
      <h1>Essiac Tea</h1>
      <p>
        Traditional herbal blend with a long history of wellness use and stories of supporting the bodyâ€™s ability to heal.
      </p>
      <!-- intentionally no hero CTA -->
    </div>
  </section>

  <!-- PRODUCT CARD -->
  <section id="buy" class="content">
    <div class="card">
      <img
        class="card-img"
        src={IMG}
        alt={TITLE}
        width="640"
        height="640"
        loading="lazy"
        decoding="async"
      />
      <div class="card-body">
        <h1 class="card-title">{TITLE}</h1>
        <p class="card-price">{PRICE_DISPLAY}</p>
        <p class="card-desc">
          The classic 8-herb Essiac formula. Carefully blended for purity and consistency.
          Ingredients (USA): Blessed Thistle, Burdock Root, Kelp, Red Clover, Sheep Sorrel,
          Slippery Elm Bark, Turkish Rhubarb Root, Watercress.
        </p>

        <!-- cart button (kept here on the card, not in the hero) -->
        <button
          type="button"
          class="btn add-to-cart"
          data-sku={SKU}
          data-name={TITLE}
          data-price={String(PRICE_CENTS)}
          data-image={IMG}
          data-qty="1"
        >
          Add to Cart
        </button>
      </div>
    </div>
  </section>

  <!-- LONGER COPY (optional) -->
  <section class="content">
    <h2>About Essiac Tea</h2>
    <p>
      This famous tea is often misrepresented online. Nurse Rene Caisseâ€™s early 4-herb recipe is widely circulated,
      but her later, refined 8-herb version with Dr. Charles Brusch is the one known for helping many. Our Essiac Tea
      follows that lineage. This tea has helped many people support their bodyâ€™s own ability to heal from numerous
      serious health challenges. Taste is similar to cold coffee. Keep it chilled in the refrigerator. Instructions are printed on the bag.
    </p>
  </section>

  <style>
    /* HERO (half height + tight padding) */
    .prod-hero{
      position:relative; isolation:isolate; overflow:hidden;
      min-height:180px; border-radius:14px; background:#fff; margin-top:8px;
    }
    .bg{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:.18; z-index:-1; }
    .inner{ padding:20px 16px 18px; max-width:900px; margin:0 auto; }
    .inner h1{ margin:0 0 8px; font-size:clamp(2rem,3vw,2.6rem); }
    .inner p{ margin:0 0 14px; max-width:60ch; }

    /* CONTENT + CARD */
    .content{ max-width:1000px; margin:22px auto; padding:0 10px; }
    .card{
      display:grid; grid-template-columns:1fr; gap:16px; background:#fff;
      border:1px solid #e5e7eb; border-radius:14px; overflow:hidden;
      box-shadow:0 1px 2px rgba(0,0,0,.04);
    }
    @media (min-width:720px){ .card{ grid-template-columns:1fr 1fr; } }
    .card-img{ width:100%; height:auto; object-fit:cover; background:#f8fafc; }
    .card-body{ padding:18px; }
    .card-title{ margin:.25rem 0 .25rem; font-size:1.6rem; }
    .card-price{ margin:0 0 .5rem; font-weight:700; }
    .card-desc{ margin:0 0 .9rem; line-height:1.55; }

    /* Buttons used on the card (not in hero) */
    button.btn, .btn{
      display:inline-flex; gap:.5rem; align-items:center; justify-content:center;
      padding:10px 16px; border-radius:999px; background:#111827; color:#fff;
      text-decoration:none; font-weight:700; cursor:pointer; border:0;
      -webkit-appearance:none; appearance:none;
    }
    button.btn:focus{ outline:2px solid #11182722; outline-offset:2px; }
  </style>
</BaseLayout>
