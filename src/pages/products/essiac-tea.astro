---
// FILE: src/pages/products/essiac.astro
import BaseLayout from '@/layouts/BaseLayout.astro';
import Fineprint from '@/components/Fineprint.astro';

const pageTitle = 'Essiac Tea — Famous 8-Herb Recipe';
const PRICE_CENTS = 4050;
const PRICE_DISPLAY = `$${(PRICE_CENTS / 100).toFixed(2)}`; // $40.50
const SKU = 'essiac-tea';

// Light hero image (faded behind heading)
const IMG_HERO = '/images/products/essiacgreen.png';

// Video for the product card
const VID_CARD = '/videos/essiac.mp4';
const POSTER_CARD = '/images/products/essiacgreen.png';
---

<BaseLayout>
  <Fragment slot="title">{pageTitle}</Fragment>

  <!-- HERO: Essiac (faded image, no CTA) -->
  <section class="prod-hero">
    <img class="bg" src={IMG_HERO} alt="" />
    <div class="inner">
      <h1>Essiac Tea</h1>
      <p>
        This is THE traditional 8-herb blend - the finalized recipe from the famous nurse Caisse that comes with a long history of wellness use and stories of supporting the body’s
        natural resilience. It will help you detox and support healthy replication of your DNA. Brewing instructions are on the package. Brew, chill, and drink cold daily.
      </p>
    </div>
  </section>

  <!-- PRODUCT CARD (Ocean Cleanse-style) -->
  <section id="buy" class="content">
    <div class="card">
      <!-- Media: VIDEO replaces product picture -->
      <div class="card-media-wrap">
        <video
          class="card-media"
          src={VID_CARD}
          poster={POSTER_CARD}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
        ></video>
        <noscript>
          <img src={POSTER_CARD} alt="Essiac Tea" class="card-fallback" />
        </noscript>
      </div>

      <div class="card-body">
        <h1 class="card-title">Essiac Tea (Single Bag)</h1>
        <p class="card-price">{PRICE_DISPLAY}</p>

        <p class="card-desc">
          Later 8-herb formulation associated with Nurse René Caisse and Dr. Charles Brusch. Simple taste (coffee-like);
          brew and refrigerate. See bag for brewing instructions. This is a famous recipe used in history from over 100 years ago.
          We cannot make medical claims; we encourage you to research its history and usage.
        </p>

        <ul>
          <li>Classic <strong>8-herb</strong> formulation (not the early 4-herb)</li>
          <li>Carefully blended for purity and consistency</li>
          <li>Brew ahead and keep chilled</li>
        </ul>

        <!-- CTA -->
        <div class="product-cta">
          <button
            class="btn-cta add-to-cart"
            type="button"
            data-sku={SKU}
            data-qty="1"
            data-name="Essiac Tea — Famous 8-Herb Recipe (Single)"
            data-image={IMG_HERO}
            data-price={String(PRICE_CENTS)}
            aria-label="Add Essiac Tea to cart"
          >
            Add to Cart
          </button>
        </div>

        <p class="fineprint">
          *Statements on this page have not been evaluated by the FDA. Products are not intended to diagnose, treat, cure, or prevent any disease.
        </p>
      </div>
    </div>
  </section>

  <!-- Additional content -->
  <section class="content">
    <h2>About Essiac Tea</h2>
    <p>
      The early 4-herb version is widely circulated as it was the first recipe Nurse Caisse started with,
      but over time she developed a more refined 8-herb version with Dr. Brusch. This is that 8-herb recipe.
      Taste is similar to cold coffee and is slightly bitter.
    </p>

    <h3>Ingredients (USA)</h3>
    <p>
      Blessed Thistle, Burdock Root, Kelp, Red Clover, Sheep Sorrel, Slippery Elm Bark, Turkish Rhubarb Root, Watercress.
    </p>

    <!-- Image pair under Ingredients -->
    <div class="image-pair" aria-label="Essiac product images">
      <img src="/images/products/essiacgreen.png" alt="Essiac bag" />
      <img src="/images/products/ESSIAC.png" alt="Essiac logo" />
    </div>
  </section>

  <style>
    /* ---------- HERO (faded image) ---------- */
    .prod-hero{
      position:relative; isolation:isolate; overflow:hidden;
      min-height:180px; border-radius:14px; background:#fff; margin:8px 0 18px;
    }
    .prod-hero .bg{
      position:absolute; inset:0; width:100%; height:100%;
      object-fit:cover; opacity:.18; z-index:-1;
    }
    .prod-hero .inner{
      padding:20px 16px 18px; max-width:1000px; margin:0 auto;
    }
    .prod-hero h1{ margin:0 0 8px; font-size:clamp(2rem,3vw,2.4rem); }
    .prod-hero p{ margin:0; max-width:70ch; }

    /* ---------- CONTENT + CARD (mirrors Ocean Cleanse) ---------- */
    .content{ max-width:1000px; margin:22px auto; padding:0 10px; }
    .content h3{ margin:1rem 0 .25rem; font-size:1.1rem; }
    .content ul{ margin:.25rem 0 .75rem; padding-left:1.2rem; }

    .card{
      display:grid;
      grid-template-columns: 1fr;
      gap: 16px;
      background:#fff;
      border:1px solid #e5e7eb;
      border-radius:14px;
      overflow:hidden;
      box-shadow: 0 1px 2px rgba(0,0,0,.04);
    }
    @media (min-width: 720px){
      .card{ grid-template-columns: 1fr 1fr; }
    }

    /* Video / media area */
    .card-media-wrap{
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      background: #000;
      overflow: hidden;
    }
    .card-media{
      position: absolute; inset: 0;
      width: 100%; height: 100%;
      object-fit: cover;
      display: block;
    }
    .card-fallback{
      width:100%; height:auto; display:block;
    }
    /* Nudge the video framing DOWN a bit so the top shows more */
.card-media{
  object-fit: cover;       /* keep full-bleed */
  object-position: 50% 62%;/* ← adjust this: 50% 62% moves view down */
}

/* Give the media area a steady shape on desktop/phone so nothing gets clipped */
@media (min-width: 720px){
  .card-media-wrap{ aspect-ratio: 16 / 9; }
}
@media (max-width: 719.98px){
  .card-media-wrap{ aspect-ratio: 16 / 9; }
  .card-media{ object-position: 50% 60%; } /* slightly different on phones if desired */
}


    .card-body{ padding:18px; }
    .card-title{ margin:.25rem 0 .25rem; font-size:1.6rem; }
    .card-price{ margin:0 0 .5rem; font-weight:700; }
    .card-desc{ margin:0 0 .9rem; line-height:1.55; }

    /* Button styling: compact & consistent */
    .product-cta .btn-cta {
      min-width: 220px;
      width: 100%;
      justify-content: center;
    }
    .btn-cta.add-to-cart{
      display:inline-flex; align-items:center; justify-content:center; box-sizing:border-box;
      height: var(--cart-btn-h, 44px);
      padding: 0 var(--cart-btn-px, 16px);
      line-height: 1; white-space: nowrap;
    }

    .fineprint { margin:.6rem 0 0; color:#6b7280; font-size:.8rem; }

    /* Bottom image pair */
    .image-pair{
      margin: 16px auto 8px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      align-items: center;
      justify-items: center;
      max-width: 800px;
    }
    .image-pair img{
      width: min(100%, 360px);
      height: auto;
      display: block;
      border-radius: 10px;
      box-shadow: 0 3px 8px rgba(0,0,0,.06);
      background: #fff;
      padding: 6px; /* small frame */
    }
    @media (max-width: 560px){
      .image-pair{
        grid-template-columns: 1fr 1fr;  /* still side-by-side on most phones */
        gap: 10px;
      }
      .image-pair img{
        width: 100%;
        max-width: 160px; /* keep them modest on small phones */
      }
    }
  </style>
</BaseLayout>
