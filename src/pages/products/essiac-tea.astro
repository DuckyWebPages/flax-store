---
// FILE: src/pages/products/essiac.astro
import BaseLayout from '@/layouts/BaseLayout.astro';
import Fineprint from '@/components/Fineprint.astro';

const pageTitle = 'Essiac Tea — Famous 8-Herb Recipe';
const PRICE_CENTS = 4050;
const PRICE_DISPLAY = `$${(PRICE_CENTS / 100).toFixed(2)}`; // $40.50
const SKU = 'essiac-tea';

// Light hero image (faded behind heading)
const IMG_HERO = '/images/backgroundw.jpg';

// Video for the product card
const VID_CARD = '/videos/essiac.mp4';
const POSTER_CARD = '/images/products/essiacgreen.png'; // used only in <noscript>
---

<BaseLayout>
  <Fragment slot="title">{pageTitle}</Fragment>

  <!-- HERO: Essiac (faded image, no CTA) -->
  <section class="prod-hero">
    <img class="bg" src={IMG_HERO} alt="" />
    <div class="inner">
      <h1>Essiac Tea</h1>
      <p>
        This is THE traditional 8-herb blend—the finalized recipe from Nurse René Caisse—known for a long history of wellness use and stories of supporting the body’s natural resilience. It may support detox and healthy DNA replication. Brewing instructions are on the package. Brew, chill, and drink cold daily.
      </p>
    </div>
  </section>

    <!-- PRODUCT CARD -->
  <section id="buy" class="content">
    <div class="card">
      <!-- LEFT: media column (MP4 on top, YouTube below) -->
      <div class="media-col">
        <div class="media-box">
          <video
            class="card-media card-media--nudge"
            src={VID_CARD}
            autoplay
            muted
            loop
            playsinline
            preload="auto"
          ></video>
          <noscript>
            <img src={POSTER_CARD} alt="Essiac Tea" class="card-fallback" />
          </noscript>
        </div>

        <div class="yt-box">
          <iframe
            class="yt-frame"
            src="https://www.youtube-nocookie.com/embed/96a3JCcDb9k?modestbranding=1&rel=0"
            title="Essiac Tea Instructions"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      </div>

      <!-- RIGHT: product info -->
      <div class="card-body">
        <h1 class="card-title">Essiac Tea (1 lb Single Bag)</h1>
        <p class="card-price">{PRICE_DISPLAY}</p>

        <p class="card-desc">
          Later 8-herb formulation associated with Nurse René Caisse and Dr. Charles Brusch. Simple taste (coffee-like); brew and refrigerate. See bag for brewing instructions. This is a famous recipe used in history for over 100 years. We cannot make medical claims; we encourage you to research its history and usage.
        </p>

        <ul>
          <li>Classic <strong>8-herb</strong> formulation (not the early 4-herb)</li>
          <li>Carefully blended for purity and consistency — grown in the USA</li>
          <li>Brew ahead and keep chilled in the refrigerator</li>
          <li>Video is a representation, not actual tea. It is dark and bitter like coffee. Best very cold.</li>
        </ul>

        <div class="product-cta">
          <button
            class="btn-cta add-to-cart"
            type="button"
            data-handle="essiac-tea"
            data-qty="1"
            aria-label="Add Essiac Tea to cart"
          >
            Add to Cart
          </button>
        </div>

        <p class="fineprint">
          *Statements on this page have not been evaluated by the FDA. Products are not intended to diagnose, treat, cure, or prevent any disease. *Top video is not of actual tea, just a representation.
        </p>
      </div>
    </div>
  </section>


  <!-- Additional content -->
  <section class="content content--card">

    <h2>About Essiac Tea</h2>
    <p>
      The early 4-herb version is widely circulated because it was Nurse Caisse’s first formula, but over time she worked with Dr. Brusch to develop a more refined 8-herb version. This is that 8-herb recipe. Taste is similar to cold coffee and is slightly bitter.
    </p>

    <h2>Brewing Instructions</h2>
    <p>
      Below are options for brewing an aggressive dose (concentrate used to make daily tea), a maintenance dose, or a one-quart batch. Steps <strong>3–5</strong> are the same for all methods.
    </p>

    <h3>Aggressive Treatment Dose (makes ~1 gallon concentrate)</h3>
    <p><em>Typical intake:</em> 3–6 oz of tea, three times per day.</p>
    <ol>
      <li>Bring <strong>132 oz</strong> (1 gallon + 4 oz to account for evaporation) of spring or distilled water to a boil, then reduce to a gentle simmer.</li>
      <li>Add <strong>4 oz (113 g)</strong> of the Essiac herb blend. For accuracy, weigh the herbs on a kitchen scale. (Very rough dry-measure approximation: about <strong>1¼ cups</strong>.)</li>
    </ol>

    <h3>Maintenance Dose (2-week supply)</h3>
    <p><em>Typical intake:</em> 3 oz of tea once daily (some take twice daily for maintenance).</p>
    <ol>
      <li>Bring <strong>88 oz</strong> of spring or distilled water to a boil in a large pot.</li>
      <li>Add <strong>2.67 oz (≈76 g)</strong> of the Essiac herb blend. Weigh for accuracy. (Rough dry-measure approximation: a <strong>rounded ½ cup</strong>.)</li>
    </ol>

    <h3>One-Quart Batch</h3>
    <ol>
      <li>Bring <strong>36 oz</strong> of spring or distilled water to a boil in a large pot.</li>
      <li>Add <strong>1 oz (28 g)</strong> of the Essiac herb blend. Weigh for accuracy. (Rough dry-measure approximation: about <strong>¼ cup</strong>.)</li>
    </ol>

    <h3>Steps 3–5 (same for all batches)</h3>
    <ol start="3">
      <li>
        Reduce heat to medium and <strong>simmer for 10 minutes</strong>, stirring occasionally. Keep the lid on with a small gap to limit evaporation.
      </li>
      <li>
        Turn heat off, <strong>cover tightly</strong>, and let sit at room temperature for <strong>12 hours</strong>.
      </li>
      <li>
        The next day, <strong>stir vigorously</strong> to disperse herb particles and funnel into a clean gallon water jug (or glass bottle). <strong>Do not strain.</strong> Because the herbs are powdered, they can be taken with the tea and may improve efficacy. Refrigerate.
      </li>
    </ol>

    <p>
      Brew only up to a <strong>2-week</strong> supply at a time; after roughly 14 days, make a fresh batch. <strong>Shake well</strong> before pouring each dose to redistribute herb particles. If the taste is difficult, mix with fruit or vegetable juice. Best consumed <strong>cold</strong>.
    </p>
    <p>
      For most consistent results, take doses on an <strong>empty stomach</strong> (avoid food for ~2 hours before and ~1 hour after). If that’s not possible, taking Essiac with food is still better than skipping a dose.
    </p>

    <h3>Ingredients (USA)</h3>
    <p>
      Blessed Thistle, Burdock Root, Kelp, Red Clover, Sheep Sorrel, Slippery Elm Bark, Turkish Rhubarb Root, Watercress.
    </p>

    <!-- Image pair under Ingredients -->
    <div class="image-pair" aria-label="Essiac product images">
      <img src="/images/products/essiacgreen.png" alt="Essiac bag" />
      <img src="/images/products/ESSIAC.png" alt="Essiac logo" />
    </div>
  </section>

  <style>
    /* ---------- HERO (faded image) ---------- */
    .prod-hero{
      position:relative; isolation:isolate; overflow:hidden;
      min-height:180px; border-radius:14px; background:#fff; margin:8px 0 18px;
    }
    .prod-hero .bg{
      position:absolute; inset:0; width:100%; height:100%;
      object-fit:cover; opacity:.18; z-index:-1;
    }
    .prod-hero .inner{
      padding:20px 16px 18px; max-width:1000px; margin:0 auto;
    }
    .prod-hero h1{ margin:0 0 8px; font-size:clamp(2rem,3vw,2.4rem); }
    .prod-hero p{ margin:0; max-width:70ch; }

   /* ---------- CONTENT + CARD ---------- */
.content{ max-width:1000px; margin:22px auto; padding:0 10px; }
.content h3{ margin:1rem 0 .25rem; font-size:1.1rem; }
.content ul{ margin:.25rem 0 .75rem; padding-left:1.2rem; }

.card{
  display:grid;
  grid-template-columns: 1fr;
  gap: 16px;
  background:#fff;
  border:1px solid #e5e7eb;
  border-radius:14px;
  overflow:hidden;
  box-shadow: 0 1px 2px rgba(0,0,0,.04);
}
@media (min-width: 720px){
  .card{ grid-template-columns: 1fr 1fr; } /* media left, content right */
}

/* MEDIA COLUMN: stack both videos inside the left column */
.media-col{
  display:flex;
  flex-direction:column;
  gap:12px;
  padding:12px;   /* breathing room inside the white card */
}

/* 16:9 boxes for each media item */
.media-box,
.yt-box{
  position:relative;
  width:100%;
  aspect-ratio:16 / 9;
  background:#000;
  border-radius:10px;
  overflow:hidden;
  box-shadow: 0 1px 2px rgba(0,0,0,.06);
}

/* MP4 video fills its box and fades in when ready */
.card-media{
  position:absolute; inset:0;
  width:100%; height:100%;
  object-fit:cover;
  display:block;
  opacity:0;
  transition:opacity .2s ease;
}
.card-media.is-ready { opacity:1; }

/* Optional crop nudge */
.card-media--nudge { object-position:50% 28%; }
@supports (-webkit-touch-callout: none) {
  .card-media--nudge { object-position:50% 36%; }
}
.card-fallback{ width:100%; height:auto; display:block; }

/* YouTube iframe fills its box */
.yt-frame{
  position:absolute; inset:0;
  width:100%; height:100%;
  border:0; display:block;
}

.card-body{ padding:18px; }
.card-title{ margin:.25rem 0 .25rem; font-size:1.6rem; }
.card-price{ margin:0 0 .5rem; font-weight:700; }
.card-desc{ margin:0 0 .9rem; line-height:1.55; }

/* CTA */
.product-cta .btn-cta { min-width: 220px; width: 100%; justify-content: center; }
.btn-cta.add-to-cart{
  display:inline-flex; align-items:center; justify-content:center;
  box-sizing:border-box; height: var(--cart-btn-h, 44px);
  padding: 0 var(--cart-btn-px, 16px); line-height: 1; white-space: nowrap;
}

/* Fine print */
.fineprint { margin:.6rem 0 0; color:#6b7280; font-size:.8rem; }

/* Bottom image pair */
.image-pair{
  margin: 16px auto 8px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
  align-items: center;
  justify-items: center;
  max-width: 800px;
}
.image-pair img{
  width: min(100%, 360px);
  height: auto;
  display: block;
  border-radius: 10px;
  box-shadow: 0 3px 8px rgba(0,0,0,.06);
  background: #fff;
  padding: 6px;
}
@media (max-width: 560px){
  .image-pair{ grid-template-columns: 1fr 1fr; gap: 10px; }
  .image-pair img{ width: 100%; max-width: 160px; }
}


/* Make CTA button auto-width, pill style, centered */
.product-cta {
  display: flex;
  align-items: center;
  gap: 8px;
}
.product-cta .btn-cta {
  width: auto;
  min-width: 180px;
  justify-content: center;
  border-radius: 9999px;    /* pill */
}

/* White card treatment for the long text section */
.content--card {
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 14px;
  box-shadow: 0 1px 2px rgba(0,0,0,.04);
  padding: 18px;
}


.fineprint { margin:.6rem 0 0; color:#6b7280; font-size:.8rem; }

/* Bottom image pair */
.image-pair{
  margin: 16px auto 8px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
  align-items: center;
  justify-items: center;
  max-width: 800px;
}
.image-pair img{
  width: min(100%, 360px);
  height: auto;
  display: block;
  border-radius: 10px;
  box-shadow: 0 3px 8px rgba(0,0,0,.06);
  background: #fff;
  padding: 6px;
}
@media (max-width: 560px){
  .image-pair{ grid-template-columns: 1fr 1fr; gap: 10px; }
  .image-pair img{ width: 100%; max-width: 160px; }
}

/* Make CTA button auto-width, pill style, centered */
.product-cta{
  display:flex; align-items:center; gap:8px;
}
.product-cta .btn-cta{
  width:auto; min-width:180px; justify-content:center; border-radius:9999px;
}

/* White card treatment for the long text section */
.content--card{
  background:#fff;
  border:1px solid #e5e7eb;
  border-radius:14px;
  box-shadow:0 1px 2px rgba(0,0,0,.04);
  padding:18px;
}


  </style>

  <!-- Reveal video only when it can play -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const v = document.querySelector('.card-media');
      if (!v) return;
      const reveal = () => v.classList.add('is-ready');
      v.addEventListener('canplay', reveal, { once: true });
      if (v.readyState >= 3) reveal();
    });
  </script>
  <script is:raw>
(function () {
  async function addToCart(handle, qty) {
    const payload = { handle, quantity: qty };
    console.log("[cart-add] POST /api/cart-add", payload);

    let res, text;
    try {
      res = await fetch("/api/cart-add", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      text = await res.text(); // read as text first in case server returned HTML error
    } catch (netErr) {
      console.error("[cart-add] network error:", netErr);
      throw new Error("Network error contacting /api/cart-add");
    }

    let json;
    try {
      json = JSON.parse(text);
    } catch {
      console.error("[cart-add] non-JSON response:", text);
      throw new Error("Server returned non-JSON. Check logs.");
    }

    if (!res.ok || !json.ok) {
      console.error("[cart-add] server error:", { status: res.status, json });
      throw new Error(json.error || ("HTTP " + res.status));
    }

    // Tell BaseLayout to open the drawer
    window.dispatchEvent(new CustomEvent("cart:open", {
      detail: { checkoutUrl: json.checkoutUrl, linesCount: json.linesCount }
    }));

    console.log("[cart-add] success:", json);
    return json;
  }

  document.addEventListener("click", async (ev) => {
    const btn = ev.target?.closest?.(".add-to-cart");
    if (!btn) return;
    ev.preventDefault();

    const handle = (btn.getAttribute("data-handle") || "").trim();
    const qty = Number(btn.getAttribute("data-qty") || "1") || 1;
    if (!handle) return alert("Missing data-handle on button.");

    const originalHTML = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = "Adding…";

    try {
      await addToCart(handle, qty);
      btn.innerHTML = "Added!";
      setTimeout(() => (btn.innerHTML = originalHTML), 900);
    } catch (e) {
      alert("Cart error: " + (e?.message || e));
      btn.innerHTML = originalHTML;
    } finally {
      btn.disabled = false;
    }
  });
})();
</script>


</BaseLayout>
