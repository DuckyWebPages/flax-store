---
// FILE: src/pages/products/index.astro
import BaseLayout from '@/layouts/BaseLayout.astro';
const pageTitle = 'Products — ';
---

<BaseLayout>
  <Fragment slot="title">{pageTitle}</Fragment>

  <section class="prodpg">
    <div class="prodpg__container">
      <h1 class="products-title">Products by Category</h1>
      <p class="prodpg__lead">Browse by category, or jump straight to our best sellers.</p>

      <!-- Category Grid -->
      <div class="prodpg__cats">
        <a class="prodpg__cat" href="/products/flax-hull-lignans" aria-label="Flax Products">
          <span class="prodpg__circle">
            <img src="/images/products/flax-small.png" alt="Flax Hull Lignans" loading="lazy" />
          </span>
          <span class="prodpg__label">Flax Products</span>
        </a>

        <a class="prodpg__cat" href="/products/detox-products" aria-label="Detox Products">
          <span class="prodpg__circle">
            <img src="/images/detox-small.png" alt="Detox Products" loading="lazy" />
          </span>
          <span class="prodpg__label">Detox Products</span>
        </a>

        <a class="prodpg__cat" href="/products/brain-health" aria-label="Brain Health Products">
          <span class="prodpg__circle">
            <img src="/images/detox-small.png" alt="Brain Health" loading="lazy" />
          </span>
          <span class="prodpg__label">Brain Products</span>
        </a>

        <a class="prodpg__cat" href="/products/essential-oils" aria-label="Essential Oils">
          <span class="prodpg__circle">
            <img src="/images/essential-small.png" alt="Essential Oils" loading="lazy" />
          </span>
          <span class="prodpg__label">Essential Oils</span>
        </a>

        <a class="prodpg__cat" href="/products/other-products" aria-label="Other Products">
          <span class="prodpg__circle">
            <img src="/images/other-small.png" alt="Other Products" loading="lazy" />
          </span>
          <span class="prodpg__label">Other Products</span>
        </a>
      </div>

      <!-- Featured Products -->
      <h2 class="products-title">Featured Products</h2>
      <div class="prodpg__grid">
        <!-- Regular Single Jar -->
        <article class="prodpg__card">
          <img
            src="/images/products/flax-single-small.jpg"
            alt="Flax Hull Lignans (Single Jar)"
            loading="lazy"
          />
          <h3>Flax Hull Lignans (Single Jar)</h3>
          <p class="prodpg__price">$39.00</p>
          <button
            class="btn-cta add-to-cart"
            data-sku="fhl-single"
            data-name="Flax Hull Lignan (Single Jar)"
            data-price="4995"
            data-image="/images/products/flax-single-small.jpg"
            data-qty="1"
          >Add to Cart</button>
        </article>

        <!-- Regular Bundle -->
        <article class="prodpg__card">
          <img
            src="/images/products/flax-hull-bundle-small.jpg"
            alt="Flax Hull Lignans (3 Jars)"
            loading="lazy"
          />
          <h3>Flax Hull Lignans (3 Jars)</h3>
          <p class="prodpg__price">$112.50 <span class="prodpg__save">Save 10%</span></p>
          <button
            class="btn-cta add-to-cart"
            data-sku="fhl-bundle"
            data-name="Flax Hull Lignan Bundle (3 Jars)"
            data-price="11250"
            data-image="/images/products/flax-hull-bundle-small.jpg"
            data-qty="1"
          >Add Bundle</button>
        </article>

        <!-- Ancient Seeds & Grains Single Jar -->
        <article class="prodpg__card">
          <img
            src="/images/ancient-single-small.png"
            alt="FLH Ancient Seeds & Grains Flax Hull Lignans (Single Jar)"
            loading="lazy"
          />
          <h3>FLH Ancient Seeds &amp; Grains Flax Hull Lignans (Single Jar)</h3>
          <p class="prodpg__price">$45.00</p>
          <button
            class="btn-cta add-to-cart"
            data-sku="ancient-single"
            data-name="FLH Ancient Seeds and Grains Flax Hull Lignans (Single Jar)"
            data-price="4500"
            data-image="/images/ancient-single-small.png"
            data-qty="1"
          >Add to Cart</button>
        </article>

        <!-- Ancient Seeds & Grains Bundle -->
        <article class="prodpg__card">
          <img
            src="/images/ancient-single-3jars.jpg"
            alt="FLH Ancient Seeds & Grains Flax Hull Lignans (3 Jar Bundle)"
            loading="lazy"
          />
          <h3>FLH Ancient Seeds &amp; Grains Flax Hull Lignans (3 Jar Bundle)</h3>
          <p class="prodpg__price">$132.00</p>
          <button
            class="btn-cta add-to-cart"
            data-sku="ancient-bundle"
            data-name="FLH Ancient Seeds and Grains Flax Hull Lignans (3 Jar Bundle)"
            data-price="13200"
            data-image="/images/ancient-single-3jars.jpg"
            data-qty="1"
          >Add Bundle</button>
        </article>
      </div>
    </div>
  </section>

  <style>
    /* Everything on this page is namespaced under .prodpg */
    .prodpg { padding: 0 0 48px; }
    .prodpg__container { max-width:1100px; margin:0 auto; padding:0 16px; }
    .prodpg__lead { color:#334155; margin:.25rem 0 1rem; }

    /* Category grid */
    .prodpg__cats{
      display:grid; gap:14px;
      grid-template-columns: repeat(5, 1fr);
      margin: 12px 0 28px;
    }
    @media (max-width: 980px){ .prodpg__cats{ grid-template-columns: repeat(3, 1fr); } }
    @media (max-width: 520px){ .prodpg__cats{ grid-template-columns: repeat(2, 1fr); } }

    .prodpg__cat{
      display:grid; gap:8px; place-items:center; text-align:center;
      padding:12px; border-radius:12px; text-decoration:none; color:inherit;
      background:#fff; border:1px solid #e5e7eb; box-shadow:0 8px 18px rgba(0,0,0,.06);
      transition: transform .08s ease, box-shadow .15s ease, background .15s ease;
    }
    .prodpg__cat:hover{ background:#f8fafc; transform: translateY(-1px); box-shadow:0 10px 20px rgba(0,0,0,.05); }

    .prodpg__circle{ width:150px; height:150px; border-radius:50%; overflow:hidden; display:block; background:#f8fafc; border:6px solid #f1f5f9; }
    .prodpg__circle img{ width:100%; height:100%; object-fit:cover; display:block; }
    .prodpg__label{ font-weight:700; letter-spacing:.01em; }

    /* Featured products grid — enforce smaller cards */
    .prodpg__grid{
      display:grid; gap:14px;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      margin: 6px 0 12px;
    }
    @media (min-width: 900px){
      .prodpg__grid{ grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }

    /* Keep cards from stretching full width */
    .prodpg__card{
      background:#fff; border:1px solid #e5e7eb; border-radius:14px; padding:14px;
      box-shadow:0 8px 18px rgba(0,0,0,.06);
      display:grid; gap:.55rem; justify-items:start;
      max-width: 340px;            /* cap width */
      width: 100%;
      margin: 0 auto;              /* center within grid cell */
    }

    /* Force image height so tall images don’t make giant cards */
    .prodpg__card img{
      width:100%;
      height:180px;                /* adjust to taste (e.g., 160–200) */
      object-fit:cover;
      border-radius:10px;
    }

    .prodpg__price{ font-weight:700; }
    .prodpg__save{ color:#16a34a; font-weight:700; margin-left:.35rem; font-size:.95rem; }
  </style>
</BaseLayout>
