---
// FILE: src/pages/products/index.astro
import BaseLayout from '@/layouts/BaseLayout.astro';
const pageTitle = 'Products — ';
---

<BaseLayout>
  <Fragment slot="title">{pageTitle}</Fragment>

  <section class="container">
    <h1 class="products-title">Products</h1>
    <p class="lead">Browse by category, or jump straight to our best sellers.</p>

    <!-- Category Grid -->
    <div class="cat-grid">
      <!-- Flax Products -->
      <a class="cat-card" href="/products/flax-hull-lignans" aria-label="Flax Products">
        <span class="circle">
          <img src="/images/flax-hull-bundle.jpg" alt="Flax Hull Lignans" loading="lazy" />
        </span>
        <span class="label">Flax Products</span>
      </a>

      <!-- Ocean Cleanse -->
      <a class="cat-card" href="/products/ocean-cleanse" aria-label="Ocean Cleanse">
        <span class="circle">
          <img src="/images/ocean-cleanse-3jars-3035.jpg" alt="Ocean Cleanse" loading="lazy" />
        </span>
        <span class="label">Ocean Cleanse</span>
      </a>

      <!-- Aftershot Zeolite -->
      <a class="cat-card" href="/products/zeolite" aria-label="Aftershot Zeolite">
        <span class="circle">
          <img src="/images/zeolite.png" alt="Aftershot Zeolite" loading="lazy" />
        </span>
        <span class="label">Aftershot Zeolite</span>
      </a>

      <!-- Essiac Tea -->
      <a class="cat-card" href="/products/essiac-tea" aria-label="Essiac Tea">
        <span class="circle">
          <img src="/images/essiac-tea.png" alt="Essiac Tea" loading="lazy" />
        </span>
        <span class="label">Essiac Tea</span>
      </a>

      <!-- Essential Oils -->
      <a class="cat-card" href="/products/essential-oils" aria-label="Essential Oils">
        <span class="circle">
          <img src="/images/eoils.png" alt="Essential Oils" loading="lazy" />
        </span>
        <span class="label">Essential Oils</span>
      </a>
    </div>

    <!-- Featured Products -->
    <h2 class="products-title">Featured Products</h2>
    <div class="prod-grid">
      <!-- Flax Hull Lignan (Single Jar) -->
      <article class="product-card">
        <img
          src="/images/products/flax-hull-single.jpg"
          alt="Flax Hull Lignan (Single Jar)"
          loading="lazy"
        />
        <h3>Flax Hull Lignan (Single Jar)</h3>
        <p class="price">$49.95</p>
        <button
          class="btn-cta add-to-cart"
          data-sku="fhl-single"
          data-name="Flax Hull Lignan (Single Jar)"
          data-price="4995"
          data-image="/images/products/flax-hull-single.jpg"
          data-qty="1"
        >Add to Cart</button>
      </article>

      <!-- Flax Hull Lignan Bundle (3 Jars) -->
      <article class="product-card">
        <img
          src="/images/products/flax-hull-bundle.jpg"
          alt="Flax Hull Lignan Bundle (3 Jars)"
          loading="lazy"
        />
        <h3>Flax Hull Lignan Bundle (3 Jars)</h3>
        <p class="price">$134.95 <span class="save">Save 10%</span></p>
        <button
          class="btn-cta add-to-cart"
          data-sku="fhl-bundle"
          data-name="Flax Hull Lignan Bundle (3 Jars)"
          data-price="13495"
          data-image="/images/products/flax-hull-bundle.jpg"
          data-qty="1"
        >Add Bundle</button>
      </article>

