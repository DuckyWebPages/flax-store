---
import BaseLayout from '@/layouts/BaseLayout.astro';

const pageTitle = 'Products — ';
---

<BaseLayout>
  <Fragment slot="title">{pageTitle}</Fragment>

  <section class="shop">
    <h1 class="products-title">Products</h1>
    <p class="intro">Our best-sellers. Add to cart right from here or tap into a product to learn more.</p>

    <div class="grid">
      <!-- Flax Hull Lignan (Single Jar) -->
      <article class="card">
        <a class="thumb" href="/products/flax-hull-lignans" aria-label="View Flax Hull Lignan details">
          <img src="/images/products/flax-hull-single.jpg" alt="Flax Hull Lignan single jar" width="480" height="480" loading="lazy" />
        </a>
        <div class="info">
          <h2 class="title">
            <a href="/products/flax-hull-lignans">Flax Hull Lignan (Single Jar)</a>
          </h2>
          <div class="price">$49.95</div>
          <button
            class="btn-cta add-to-cart"
            data-sku="fhl-single"
            data-name="Flax Hull Lignan (Single Jar)"
            data-price="4995"
            data-image="/images/products/flax-hull-single.jpg"
            data-qty="1"
          >
            Add to Cart
          </button>
        </div>
      </article>

      <!-- Flax Hull Lignan Bundle -->
      <article class="card">
        <a class="thumb" href="/products/flax-hull-lignans" aria-label="View Flax Hull Lignan bundle details">
          <img src="/images/products/flax-hull-bundle.jpg" alt="Flax Hull Lignan bundle (3 jars)" width="480" height="480" loading="lazy" />
        </a>
        <div class="info">
          <h2 class="title">
            <a href="/products/flax-hull-lignans">Flax Hull Lignan Bundle (3 Jars)</a>
          </h2>
          <div class="price">$134.95 <span class="save">Save 10%</span></div>
          <button
            class="btn-cta add-to-cart"
            data-sku="fhl-bundle"
            data-name="Flax Hull Lignan Bundle (3 Jars)"
            data-price="13495"
            data-image="/images/products/flax-hull-bundle.jpg"
            data-qty="1"
          >
            Add Bundle
          </button>
        </div>
      </article>
    </div>
  </section>

  <style>
    .shop { display: grid; gap: 1rem; }
    .intro { color: #334155; background: rgba(255,255,255,.9); padding: .75rem 1rem; border-radius: .75rem; }

    .grid {
      display: grid;
      gap: 1.25rem;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    }

    .card {
      background: #fff;
      border-radius: 1rem;
      box-shadow: 0 10px 24px rgba(0,0,0,.08);
      display: grid;
      grid-template-rows: auto 1fr;
      overflow: hidden;
    }

    .thumb {
      display: block;
      background: #f8fafc;
      aspect-ratio: 1 / 1;
      overflow: hidden;
    }
    .thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .info {
      display: grid; gap: .5rem;
      padding: 1rem;
    }
    .title {
      font-size: 1.05rem; margin: 0;
      line-height: 1.2;
    }
    .title a { color: inherit; text-decoration: none; }
    .title a:hover { text-decoration: underline; }

    .price { font-weight: 700; }
    .save {
      color: #16a34a; font-weight: 700; margin-left: .35rem; font-size: .95rem;
    }

    /* Ensure CTA stretches nicely on small cards */
    .btn-cta.add-to-cart { width: 100%; }
  </style>
</BaseLayout>
