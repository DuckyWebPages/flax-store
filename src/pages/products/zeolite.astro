// FILE: src/pages/products/zeolite.astro
import BaseLayout from '@/layouts/BaseLayout.astro'

const pageTitle = 'AfterShot'
const PRICE_CENTS = 1995
const PRICE_DISPLAY = `$${(PRICE_CENTS / 100).toFixed(2)}`
---

<BaseLayout>
  <Fragment slot="title">{pageTitle}</Fragment>

  <!-- HERO -->
  <section class="prod-hero">
    <img class="bg" src="/images/products/aftershot-8oz.jpg" alt="" />
    <div class="inner">
      <h1>AfterShot Zeolite</h1>
      <p>
        AfterShot Zeolite combines micronized, cleansed zeolite with humic/fulvic acids so it can
        circulate beyond the gut, supporting whole-body detox and efficient elimination. Zeolite is
        recommended by natural health practitioners for binding positively charged particles
        (many toxins and heavy metals). This product is favored for very fine particle sizes.
      </p>
    </div>
  </section>

  <section class="prodpg">
    <div class="prodpg__container">
      <h2 class="products-title sr-only">Products</h2>

      <div class="prodpg__grid">
        <!-- Single bottle -->
        <article class="prodpg__card">
          <!-- VIDEO at top -->
          <div class="vidbox" aria-label="AfterShot Zeolite product video">
            <video
              class="prod-video"
              src="/videos/aftershotvideo.mp4"
              muted
              autoplay
              loop
              playsinline
              preload="auto"
            ></video>
          </div>

          <h3 class="prodpg__title">
            AfterShot Zeolite Heavy Metal &amp; Toxin Removal
            <span class="unit">(1 oz)</span>
          </h3>

          <p class="prodpg__price">{PRICE_DISPLAY}</p>

          <p class="prodpg__desc">
            Micronized zeolite + humic/fulvic complex to support systemic detox. Cage-like structure
            preferentially binds positively charged particles; humic/fulvic assists transport and elimination.
          </p>

          <ul class="prodpg__bullets">
            <li>Gentle and non-systemic; eliminated within hours.</li>
            <li>Targets metals like mercury, cadmium, lead, arsenic, aluminum, strontium, excess iron.</li>
            <li>Includes Dihydroquercetin (taxifolin) for immune and antioxidant support.</li>
          </ul>

          <div class="product-cta">
            <button
              class="btn-cta add-to-cart"
              type="button"
              data-sku="aftershot-zeolite"
              data-price={String(PRICE_CENTS)}
              data-qty="1"
              data-name="AfterShot Zeolite (1 oz)"
              data-image="/images/products/aftershot-8oz.jpg"
              aria-label="Add AfterShot Zeolite (1 oz) to cart"
            >
              Add to Cart
            </button>
          </div>

          <!-- PHOTO moved to bottom -->
          <figure class="photoline">
            <img
              src="/images/products/aftershot-8oz.jpg"
              alt="AfterShot Zeolite (1 oz) product photo"
              loading="lazy"
              decoding="async"
            />
          </figure>
        </article>

        <!-- 3-bottle bundle -->
        <article class="prodpg__card">
          <!-- VIDEO at top -->
          <div class="vidbox" aria-label="AfterShot Zeolite 3-Bottle Bundle video">
            <video
              class="prod-video"
              src="/videos/aftershot3video.mp4"
              muted
              autoplay
              loop
              playsinline
              preload="auto"
            ></video>
          </div>

          <h3 class="prodpg__title">
            AfterShot Zeolite
            <span class="unit">3-Bottle Bundle</span>
          </h3>

          <p class="prodpg__price">$49.99</p>

          <p class="prodpg__desc">
            Stock up and save on three bottles of AfterShot Zeolite at a discounted bundle price.
          </p>

          <ul class="prodpg__bullets">
            <li>Best value for families or longer protocols.</li>
            <li>Same gentle, effective detox support.</li>
          </ul>

          <div class="product-cta">
            <button
              class="btn-cta add-to-cart"
              type="button"
              data-sku="aftershot-3pack"
              data-price="4999"
              data-qty="1"
              data-name="AfterShot Zeolite – 3-Bottle Bundle"
              data-image="/images/products/aftershot3green.jpg"
              aria-label="Add AfterShot Zeolite 3-Bottle Bundle to cart"
            >
              Add to Cart
            </button>
          </div>

          <!-- PHOTO moved to bottom -->
          <figure class="photoline">
            <img
              src="/images/products/aftershot3green.jpg"
              alt="AfterShot Zeolite 3-Bottle Bundle product photo"
              loading="lazy"
              decoding="async"
            />
          </figure>
        </article>
      </div>
    </div>
  </section>

  <style>
    /* ---------- HERO ---------- */
    .prod-hero{
      position:relative; isolation:isolate; overflow:hidden;
      min-height:180px; border-radius:14px; background:#fff; margin:8px 0 18px;
    }
    .prod-hero .bg{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:.18; z-index:-1; }
    .prod-hero .inner{ padding:20px 16px 18px; max-width:1100px; margin:0 auto; }
    .prod-hero h1{ margin:0 0 8px; font-size:clamp(2rem,3vw,2.4rem); }
    .prod-hero p{ margin:0; max-width:70ch; }

    /* ---------- PRODUCT GRID ---------- */
    .sr-only{ position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); border:0; }
    .prodpg { padding: 0 0 48px; }
    .prodpg__container { max-width: 1100px; margin: 0 auto; padding: 0 16px; }
    .prodpg__grid { display:grid; grid-template-columns:1fr; gap:16px 32px; margin:10px 0 24px; }
    @media (min-width:800px){ .prodpg__grid{ grid-template-columns:repeat(2,minmax(0,1fr)); } }

    .prodpg__card{
      background:#fff; border:1px solid #e5e7eb; border-radius:14px; padding:16px;
      box-shadow:0 8px 18px rgba(0,0,0,.06); display:grid; gap:.65rem; justify-items:start;
      width:100%;
    }

    /* ---------- VIDEO BOX ---------- */
    .vidbox { position: relative; width: 100%; aspect-ratio: 4 / 3; border-radius: 10px; overflow: hidden; background:#0b0b0b; }
    .vidbox .prod-video {
      position: absolute; inset: 0; width: 100%; height: 100%;
      object-fit: cover; border-radius: 10px;

      /* anti-flash */
      opacity: 0;
      transition: opacity .2s ease;
    }
    .vidbox .prod-video.is-ready { opacity: 1; }

    /* ---------- TEXT ---------- */
    .prodpg__title{ margin:.25rem 0 0; line-height:1.2; }
    .prodpg__title .unit{ display:block; font-weight:600; }
    .prodpg__price{ font-weight:700; font-size:1.05rem; }
    .prodpg__desc{ line-height:1.5; color:#374151; font-size:.98rem; margin:.25rem 0 .5rem; }
    .prodpg__bullets{ margin:0 0 .5rem; padding-left:1.1rem; }
    .prodpg__bullets li{ margin:.25rem 0; }

    /* ---------- CTA ---------- */
    .product-cta{ display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
    .product-cta .btn-cta{
      display:inline-flex; width:auto; min-width:160px;
      align-items:center; justify-content:center; white-space:nowrap; align-self:start;
      height: var(--cart-btn-h, 44px);
      padding: 0 var(--cart-btn-px, 16px);
      border-radius: var(--cart-btn-radius, 10px);
      background: var(--cart-btn-bg, #c7cdd6);
      color: var(--cart-btn-fg, #111);
      border: 0; cursor: pointer; font-weight: var(--cart-btn-weight, 400);
      transition: background-color .15s ease;
    }
    .product-cta .btn-cta:hover { background: var(--cart-btn-bg-hover, #aeb6c1); }

    /* ---------- PHOTO AT BOTTOM ---------- */
    .photoline { margin: 10px 0 0 0; }
    .photoline img{
      display:block; width:100%; height:auto; border-radius:10px;
      box-shadow:0 3px 8px rgba(0,0,0,.06);
      background:#f7f7f7;
    }
  </style>

  <!-- Reveal all videos only when they can play -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.vidbox .prod-video').forEach(v => {
        const reveal = () => v.classList.add('is-ready');
        v.addEventListener('canplay', reveal, { once: true });
        if (v.readyState >= 3) reveal();
      });
    });
  </script>
</BaseLayout>
