---
import BaseLayout from '@/layouts/BaseLayout.astro'

const pageTitle = 'AfterShot — '
const PRICE_CENTS = 1999
const PRICE_DISPLAY = `$${(PRICE_CENTS / 100).toFixed(2)}`
---

<BaseLayout>
  <Fragment slot="title">{pageTitle}</Fragment>

  <section class="prodpg">
    <div class="prodpg__container">
      <h1 class="products-title">AfterShot</h1>

      <div class="prodpg__grid">
        <!-- AfterShot (single item) -->
        <article class="prodpg__card">
          <!-- Vertical image frame -->
          <div class="card-photo">
            <img
              src="/images/products/aftershot-8oz.jpg"
              alt="AfterShot Zeolite Heavy Metal & Toxin Removal (8 oz)"
              loading="eager"
              decoding="async"
              class="card-photo-img"
            />
          </div>

          <!-- Title with forced line break for (8 oz) -->
          <h3 class="prodpg__title">
            AfterShot Zeolite Heavy Metal &amp; Toxin Removal
            <span class="unit">(8 oz)</span>
          </h3>

          <p class="prodpg__price">{PRICE_DISPLAY}</p>

          <p class="prodpg__desc">
            AfterShot Zeolite combines micronized, cleansed zeolite with humic/fulvic acids so it
            circulates beyond the gut and into your bloodstream—supporting whole-body detox.
            Zeolite’s cage-like structure preferentially binds positively charged particles
            (e.g., certain metals), while the humic/fulvic complex helps transport and elimination.
          </p>

          <ul class="prodpg__bullets">
            <li>Extremely safe &amp; non-toxic; eliminated within ~5–7 hours.</li>
            <li>Targets toxic heavy metals including mercury, cadmium, lead, arsenic, aluminum,
                strontium, and excess iron.</li>
            <li>Includes Dihydroquercetin (taxifolin), a researched bioflavonoid that supports
                immune response and antioxidant defenses.</li>
          </ul>

          <!-- CTA -->
          <div class="product-cta">
            <button
              class="btn-cta add-to-cart"
              data-sku="zeolite-8oz"
              data-price={String(PRICE_CENTS)}
              data-qty="1"
              data-name="AfterShot Zeolite (8 oz)"
              data-image="/images/products/aftershot-8oz.jpg"
            >
              Add to Cart
            </button>
          </div>
        </article>
        <!-- AfterShot (3-bottle bundle) -->
<article class="prodpg__card">
  <div class="card-photo">
    <img
      src="/images/products/aftershot3green.jpg"
      alt="AfterShot Zeolite — 3-Bottle Bundle"
      loading="eager"
      decoding="async"
      class="card-photo-img"
    />
  </div>

  <h3 class="prodpg__title">
    AfterShot Zeolite
    <span class="unit">3-Bottle Bundle</span>
  </h3>

  <p class="prodpg__price">$49.99</p>

  <p class="prodpg__desc">
    Stock up and save. Three bottles of AfterShot Zeolite for one low bundle price.
  </p>

  <ul class="prodpg__bullets">
    <li>Same micronized zeolite + humic/fulvic complex.</li>
    <li>Bundle pricing for best value.</li>
  </ul>

  <div class="product-cta">
    <button
      class="btn-cta add-to-cart"
      data-sku="zeolite-3pack"
      data-price={String(4999)}      <!-- $49.99 total -->
      data-qty="1"
      data-name="AfterShot Zeolite — 3-Bottle Bundle"
      data-image="/images/products/aftershot3green.jpg"
      Add to Cart
    </button>
  </div>
</article>

      </div>
    </div>
  </section>

  <style>
    .prodpg { padding: 0 0 48px; }

    .prodpg__container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 16px;
    }

    /* same grid as your Flax page */
    section.prodpg .prodpg__grid {
      display: grid !important;
      grid-template-columns: 1fr;
      row-gap: 16px !important;
      column-gap: 32px !important;
      margin: 10px 0 24px;
    }

    @media (min-width: 800px) {
      section.prodpg .prodpg__grid { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }
      section.prodpg .prodpg__card { margin: 0; box-sizing: border-box; }
      section.prodpg .prodpg__card:nth-child(odd) { margin-right: 32px; }
    }

    section.prodpg .prodpg__card {
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 14px;
      padding: 16px;
      box-shadow: 0 8px 18px rgba(0,0,0,.06);
      display: grid;
      gap: .65rem;
      justify-items: start;
      width: 100%;
      max-width: none;
    }

    /* Vertical card image: 3:4 frame that always crops wide photos nicely */
    .card-photo{
      width: 100%;
      aspect-ratio: 3 / 4;      /* <-- vertical */
      overflow: hidden;
      border-radius: 10px;
      background: #f7f7f7;
      box-shadow: 0 8px 18px rgba(0,0,0,.05);
    }
    .card-photo-img{
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;         /* fill the frame; side-crop horizontals */
      object-position: center;   /* try 'center top' if you want higher crop */
    }

    .prodpg__title{
      margin: .25rem 0 0;
      line-height: 1.2;
    }
    .prodpg__title .unit{
      display: block;            /* forces (8 oz) onto its own line */
      font-weight: 600;
    }

    section.prodpg .prodpg__price { font-weight: 700; font-size: 1.05rem; }
    section.prodpg .prodpg__desc { line-height: 1.5; color: #374151; font-size: .98rem; margin: .25rem 0 .5rem; }
    .prodpg__bullets { margin: 0 0 .5rem; padding-left: 1.1rem; }
    .prodpg__bullets li { margin: .25rem 0; }

    /* Keep CTA tidy and the button compact */
    .product-cta { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    .product-cta .add-to-cart {
      display: inline-flex !important;
      width: auto !important;
      min-width: 160px;
      align-items: center;
      justify-content: center;
      white-space: nowrap;
      align-self: start;
    }
  </style>
</BaseLayout>
