---
// FILE: src/pages/products/zeolite.astro
import BaseLayout from '@/layouts/BaseLayout.astro'

const pageTitle = 'AfterShot Zeolite — Detox Support'

// Prices (display only)
const PRICE_AFTERSHOT = 1995
const PRICE_AFTERSHOT_3PAK = 4999

// Images
const IMG_AFTERSHOT = "/images/products/aftershot-8oz.jpg"
const IMG_AFTERSHOT_3PAK = "/images/products/aftershot3green.jpg"

// Local videos
const VIDEO_AFTERSHOT_SRC = "/videos/aftershotvideo.mp4"
const VIDEO_AFTERSHOT_3PAK_SRC = "/videos/aftershot3video.mp4"
---

<BaseLayout>
  <Fragment slot="title">{pageTitle}</Fragment>

  <!-- Preload videos -->
  <Fragment slot="head">
    <link rel="preload" as="video" href={VIDEO_AFTERSHOT_SRC} type="video/mp4" />
    <link rel="preload" as="video" href={VIDEO_AFTERSHOT_3PAK_SRC} type="video/mp4" />
  </Fragment>

  <!-- HERO -->
  <section class="prod-hero">
    <div class="inner">
      <h1>AfterShot Zeolite</h1>
      <p>
        Micronized, cleansed zeolite paired with humic/fulvic acids for gentle, daily detox support.
        Designed to bind positively charged toxins (many heavy metals &amp; chemicals) and support
        efficient elimination. Choose a single bottle or save with the 3-Pak.
      </p>
    </div>
  </section>

  <section class="prodpg">
    <div class="prodpg__container">
      <h2 class="products-title sr-only">AfterShot Zeolite Products</h2>

      <div class="prodpg__grid prodpg__grid--two">
        <!-- Card: AfterShot (1 oz) -->
        <article class="prodpg__card">
          <div class="card-photo">
            <video
              class="card-media"
              src={VIDEO_AFTERSHOT_SRC}
              autoplay
              muted
              loop
              playsinline
              preload="auto"
            ></video>
          </div>

          <h3 class="prodpg__title">
            AfterShot <span class="unit">(1 oz)</span>
          </h3>

          <ul class="prodpg__bullets">
            <li>Micronized zeolite + humic/fulvic acids</li>
            <li>Gentle, everyday detox support</li>
            <li>Targets positively charged toxins</li>
            <li>Pairs well with Ocean Cleanse</li>
            <li>My help normalize pH levels, supporting the body in it's ability to handle viruses and bacteria</li>
          <li>There is emerging evidence that certain types of zeolite support markers of gut-barrier integrity (for example lowering zonulin in a 12-week trial). More research is needed. But this may indicate gut health support.</li>
          </ul>

          <p class="prodpg__desc">
            Zeolite’s honeycomb molecular structure attracts and binds positively charged particles
            (e.g., mercury, lead, cadmium, some pesticides, heavy metals, possibly viral and bacterial particles), helping your body eliminate them
            through normal pathways. Purified and activated for safety and efficacy.
          </p>
          <p class="prodpg__desc"> We do not know all the components of the current MRNA vaccines and make no claims regarding what AFTERSHOT™ can or can’t pull out. We do know it will go after positively charged particles -toxins in your bloodstream. We do know that spike proteins have positive cell receptor sites on them. Human receptor sites are negatively charged. Theoretically, zeolite could bind to the MRNA particles, but this is not proven. We do know that it will grab onto the particles of aluminum and other metals that are found in shots.
      </p>

          <figure class="desc-photo">
            <img
              src={IMG_AFTERSHOT}
              alt="AfterShot Zeolite 1 oz bottle"
              loading="lazy"
              decoding="async"
            />
          </figure>

          <p class="prodpg__price">${(PRICE_AFTERSHOT / 100).toFixed(2)}</p>

          <div class="product-cta">
            <button
              class="btn-cta add-to-cart"
              type="button"
              data-handle="aftershot-zeolite"
              data-qty="1"
            >
              Add to Cart
            </button>
          </div>
        </article>

        <!-- Card: AfterShot 3-Pak -->
        <article class="prodpg__card">
          <div class="card-photo">
            <video
              class="card-media"
              src={VIDEO_AFTERSHOT_3PAK_SRC}
              autoplay
              muted
              loop
              playsinline
              preload="auto"
            ></video>
          </div>

          <h3 class="prodpg__title">
            AfterShot 3-Pak <span class="unit">(3 × 1 oz)</span>
          </h3>

          <ul class="prodpg__bullets">
            <li>Three-bottle value bundle</li>
            <li>Same zeolite + humic/fulvic pairing</li>
            <li>Designed for whole-body circulation and detoxification</li>
          </ul>

          <p class="prodpg__desc">
            Same great formula as the single bottle, bundled for savings. Extremely safe and
            non-toxic; typical elimination in ~5–7 hours. A practical option if multiple family
            members are detoxing or you prefer fewer reorders.
          </p>

          <figure class="desc-photo">
            <img
              src={IMG_AFTERSHOT_3PAK}
              alt="AfterShot Zeolite 3-Pak bottles"
              loading="lazy"
              decoding="async"
            />
          </figure>

          <p class="prodpg__price">${(PRICE_AFTERSHOT_3PAK / 100).toFixed(2)}</p>

          <div class="product-cta">
            <button
              class="btn-cta add-to-cart"
              type="button"
              data-handle="aftershot-zeolite-special"
              data-qty="1"
            >
              Add to Cart
            </button>
          </div>
        </article>
      </div>
    </div>
  </section>

  <style>
    /* ---------- HERO ---------- */
    .prod-hero {
      position: relative; isolation: isolate; overflow: hidden;
      min-height: 150px; border-radius: 14px; background: #fff;
      margin: 8px auto 18px; max-width: 950px;
    }
    .prod-hero .inner { padding: 16px; max-width: 850px; margin: 0 auto; }
    .prod-hero h1 { margin: 0 0 6px; font-size: clamp(1.7rem, 2.3vw, 2rem); }
    .prod-hero p { margin: 0; max-width: 60ch; }

    /* ---------- PRODUCT GRID ---------- */
    .prodpg { padding: 0 0 36px; }
    .prodpg__container { max-width: 1100px; margin: 0 auto; padding: 0 12px; }
    .prodpg__grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 20px; justify-content: center;
    }
    /* Force two equal columns on wide screens for this page */
    @media (min-width: 900px) {
      .prodpg__grid--two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    :root { --card-price-gap: 10px; --card-row-gap: .35rem; }

    .prodpg__card{
      display: flex; flex-direction: column; gap: var(--card-row-gap); height: 100%;
      background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 10px;
      box-shadow: 0 4px 10px rgba(0,0,0,.05); margin: 0; transition: transform .15s ease;
    }
    .prodpg__card:hover { transform: translateY(-2px); }

    .card-photo {
      width: 100%; aspect-ratio: 1 / 1; overflow: hidden;
      border-radius: 8px; background: #000; box-shadow: 0 3px 6px rgba(0,0,0,.04);
      position: relative;
    }
    .card-media {
      position: absolute; inset: 0; width: 100%; height: 100%;
      object-fit: cover; display: block; border-radius: 8px;
    }

    .desc-photo{ margin: .2rem 0 .2rem; align-self: center; width: 100%; }
    .desc-photo img{
      display: block; width: 100%; max-width: 360px; max-height: 320px;
      aspect-ratio: 1 / 1; object-fit: contain; height: auto; margin: 0 auto;
      border-radius: 10px; box-shadow: 0 3px 8px rgba(0,0,0,.06);
    }
    @media (min-width: 900px){ .desc-photo img{ max-width: 320px; max-height: 300px; } }

    .prodpg__title { margin: .25rem 0 0; line-height: 1.1; font-weight: 700; font-size: .95rem; }
    .prodpg__title .unit { display: block; font-weight: 600; font-size: .85rem; }

    .prodpg__bullets { margin: .05rem 0 .3rem; padding-left: 1rem; font-size: .85rem; }
    .prodpg__bullets li { margin: .08rem 0; }
    .prodpg__desc { line-height: 1.4; color: #374151; font-size: .85rem; margin: .15rem 0 .25rem; }
    .prodpg__price{ font-weight: 800; font-size: .9rem; margin: 0 0 var(--card-price-gap) 0; }

    /* CTA: gray look to match Detox */
    .product-cta{ display: flex; flex-direction: column; align-items: flex-start; gap: 8px; }
    .product-cta .add-to-cart{ width: auto; max-width: none; }

    .prodpg .btn-cta {
      display: inline-flex; align-items: center; justify-content: center;
      height: 44px; padding: 0 16px; border: 0; border-radius: 10px;
      background: #c7cdd6 !important; color: #111 !important;
      font-size: 16px; font-weight: 600; cursor: pointer;
      transition: background-color .15s ease, transform .05s ease;
    }
    .prodpg .btn-cta:hover { background: #aeb6c1 !important; }
  </style>

  <script is:raw>
    (function () {
      async function addToCart(handle, qty) {
        const res = await fetch("/api/cart-add", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ handle, quantity: Math.max(1, Number(qty || 1)) }),
        });
        const ct = res.headers.get("content-type") || "";
        if (!ct.includes("application/json")) {
          throw new Error("Server did not return JSON. Check /api/cart-add route.");
        }
        const json = await res.json();
        if (!json.ok) throw new Error(json.error || "Add to cart failed");
        window.dispatchEvent(new CustomEvent("cart:open", {
          detail: { checkoutUrl: json.checkoutUrl, linesCount: json.linesCount }
        }));
        return json;
      }

      document.addEventListener("DOMContentLoaded", () => {
        document.querySelectorAll(".add-to-cart[data-handle]").forEach((el, i) => {
          console.log("[Zeolite] BTN", i, "handle:", el.getAttribute("data-handle"));
        });
      });

      document.addEventListener("click", async (ev) => {
        const btn = ev.target?.closest?.(".add-to-cart[data-handle]");
        if (!btn) return;
        ev.preventDefault();

        const handle = (btn.getAttribute("data-handle") || "").trim();
        const qty = btn.getAttribute("data-qty") || "1";
        if (!handle) return alert("Missing data-handle on button.");

        const original = btn.textContent;
        btn.disabled = true;

        try {
          await addToCart(handle, qty);
          btn.textContent = "Added!";
          setTimeout(() => (btn.textContent = original), 1000);
        } catch (e) {
          console.error("[Zeolite] Cart error:", e);
          alert("Cart error: " + (e?.message || e));
        } finally {
          btn.disabled = false;
        }
      });
    })();
  </script>
  <p class="fineprint">
  These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease. The information provided here is for educational purposes only and is not a substitute for professional medical advice, diagnosis, or treatment. Always consult your physician or other qualified health provider before using any dietary supplement, especially if you are pregnant, nursing, have a medical condition, or are taking medications. Discontinue use and consult a healthcare professional if you experience any adverse reaction. Keep out of reach of children.
</p>

</BaseLayout>
