---
import BaseLayout from '@/layouts/BaseLayout.astro'
import CartBridge from '../../components/CartBridge.tsx'

const pageTitle = 'Detox Products — '

// Prices in cents
const PRICE_OCEAN_CLEANSE = 3495
const PRICE_AFTERSHOT = 2995
const PRICE_AFTERSHOT_3PAK = 4999

// Images (served from /public)
// Make sure these files exist under /public/images/products/
const IMG_OCEAN_CARD = '/images/products/oceancleanse-web.jpg'
const IMG_AFTERSHOT = '/images/products/aftershot-8oz.jpg'
const IMG_AFTERSHOT_3PAK = '/images/products/aftershot3green.jpg'

// Keep the hero white (no background image)
const IMG_HERO = null
---

<BaseLayout>
  <Fragment slot="title">{pageTitle}</Fragment>

  <!-- HERO (white, no bg) -->
  <section class="prod-hero">
    <div class="inner">
      <h1>Detox Products</h1>
      <p>
        Targeted support for both heavy detox and gentle cleansing. These products are natural and not hard on your system, but yet effective at removing toxins.
      </p>
    </div>
  </section>

  <section class="prodpg">
    <div class="prodpg__container">
      <h2 class="products-title sr-only">Detox Products</h2>

      <div class="prodpg__grid">
        <!-- Card: Ocean Cleanse -->
        <article class="prodpg__card">
          <div class="card-photo">
            <img
              src={IMG_OCEAN_CARD}
              alt="Ocean Cleanse"
              loading="eager"
              decoding="async"
              class="card-photo-img"
            />
          </div>

          <h3 class="prodpg__title">Ocean Cleanse <span class="unit">(90 capsules)</span></h3>
          <p class="prodpg__price">${(PRICE_OCEAN_CLEANSE/100).toFixed(2)}</p>

          <ul class="prodpg__bullets">
            <li>Concentrated brown-seaweed extract</li>
            <li>Natural iodine; supports thyroid &amp; energy</li>
            <li>Alginate binds certain heavy metals</li>
            <li>Fucoidan &amp; fucoxanthin for immune support</li>
          </ul>

          <p class="prodpg__desc">
            A focused seaweed (Laminaria Japonica) used traditionally to support detox of heavy metals and radioactive elements, while supporting thyroid balance and everyday vitality. This product has a synergistic combination of ionic iodine, laminarin, alginates, and selenium—present in a single natural source. The patented process removes the seaweed's outer fiber and extracts only the inner, water-soluble part of the Laminaria leaf to enhance availability of minerals, vitamins, and polysaccharides. Forty pounds of raw seaweed are needed to make one pound of Ocean Cleanse.
          </p>

          <div class="product-cta">
            <button
              class="btn-cta add-to-cart"
              type="button"
              data-sku="ocean-cleanse-single"
              data-price={String(PRICE_OCEAN_CLEANSE)}
              data-qty="1"
              data-name="Ocean Cleanse - Heavy Metal/Radiation Detox"
              data-image={IMG_OCEAN_CARD}
            >
              Add to Cart
            </button>
            <a class="btn btn-link" href="/products/ocean-cleanse/">Learn more</a>
          </div>
        </article>

        <!-- Card: AfterShot (1 oz) -->
        <article class="prodpg__card">
          <div class="card-photo">
            <img
              src={IMG_AFTERSHOT}
              alt="AfterShot 1-oz"
              loading="eager"
              decoding="async"
              class="card-photo-img"
            />
          </div>

          <h3 class="prodpg__title">AfterShot <span class="unit">(1 oz)</span></h3>
          <p class="prodpg__price">${(PRICE_AFTERSHOT/100).toFixed(2)}</p>

          <ul class="prodpg__bullets">
            <li>Removes toxins and heavy metals</li>
            <li>Antioxidant support</li>
            <li>pH balanced</li>
            <li>Gentle daily detox support</li>
            <li>Pairs well with Ocean Cleanse</li>
            <li>No artificial colors or flavors</li>
            <li>Micronized zeolite with humic/fulvic pairing</li>
          </ul>

          <p class="prodpg__desc">
            A simple, everyday companion formula used to support the body's natural detox processes. Particle size is just above nano. Attracts positively charged particles into a cage-like structure and moves them out via normal elimination. Slightly bitter; take straight or dilute in water.
          </p>

          <div class="product-cta">
            <button
              class="btn-cta add-to-cart"
              type="button"
              data-sku="aftershot-8oz"
              data-price={String(PRICE_AFTERSHOT)}
              data-qty="1"
              data-name="AfterShot (1 oz)"
              data-image={IMG_AFTERSHOT}
            >
              Add to Cart
            </button>
            <!-- <a class="btn btn-link" href="/products/aftershot/">Learn more</a> -->
          </div>
        </article>

        <!-- Card: AfterShot 3-Pak -->
        <article class="prodpg__card">
          <div class="card-photo">
            <img
              src={IMG_AFTERSHOT_3PAK}
              alt="AfterShot 3-Pak (3 Bottles)"
              loading="eager"
              decoding="async"
              class="card-photo-img"
            />
          </div>

          <h3 class="prodpg__title">AfterShot 3-Pak <span class="unit">(3 Bottles)</span></h3>
          <p class="prodpg__price">${(PRICE_AFTERSHOT_3PAK/100).toFixed(2)}</p>

          <ul class="prodpg__bullets">
            <li>Three-bottle value bundle</li>
            <li>Detox &amp; antioxidant support</li>
            <li>Humic/fulvic pairing for circulation</li>
            <li>Pairs well with Ocean Cleanse</li>
          </ul>

          <p class="prodpg__desc">
            Three-bottle value bundle; same micronized zeolite plus humic/fulvic pairing designed for circulation—not just the gut. Finds toxic metals and residues and captures free radicals for safe elimination.
          </p>

          <div class="product-cta">
            <button
              class="btn-cta add-to-cart"
              type="button"
              data-sku="aftershot-3pak"
              data-price={String(PRICE_AFTERSHOT_3PAK)}
              data-qty="1"
              data-name="AfterShot 3-Pak Natural Chelation and Detoxifier (3 Bottles)"
              data-image={IMG_AFTERSHOT_3PAK}
            >
              Add to Cart
            </button>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Full-width Testimonials band -->
  <section class="tbox tbox--bleed" aria-labelledby="detox-testimonials-heading">
    <div class="tbox__container">
      <h2 id="detox-testimonials-heading">Customer Testimonials</h2>
      <p class="tbox__lead">
        Real experiences with Ocean Cleanse &amp; AfterShot. Thank you for sharing your testimonies. Because of the cost of true medical trials, natural products like these will never be tested to that degree. We need the community to share their results to help others see the results they are getting. Email your testimonials to: Wendy@flaxlignanhealth.com.
      </p>

      <div class="tlist tlist--four">
        <!-- Testimonial 1 -->
        <figure class="tquote">
          <blockquote><p>“After having all the metal removed from my teeth, my natural dentist and naturopath agreed for me to chelate. Every couple of months I would have a 'metal dump'... I'd take 2 Ocean Cleanse 3x a day and by the third day would be back to normal.”</p></blockquote>
          <figcaption>— W.S., Colorado</figcaption>
        </figure>

        <!-- Testimonial 2 -->
        <figure class="tquote">
          <blockquote><p>“When I joined the military... I took Ocean Cleanse and AfterShot and felt energized and so much better within a day or two. I was so grateful to have an option to be in control of my health.”</p></blockquote>
          <figcaption>— T.E., Colorado</figcaption>
        </figure>

        <!-- Testimonial 3 -->
        <figure class="tquote">
          <blockquote><p>Manufacturer note: “This product is a winner when detoxing, because the detox/healing crisis effect is very mild... six capsules a day for an average-size body will make people clean.”</p></blockquote>
          <figcaption>— S.Z., California</figcaption>
        </figure>

        <!-- Testimonial 4 -->
        <figure class="tquote">
          <blockquote><p>“I am worried about the nano-technology... With AfterShot zeolite being just a little larger than nano, I am hoping it traps nano particles within its cage-like structure.”</p></blockquote>
          <figcaption>— P.T., Idaho</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <CartBridge client:load />

  <style>
    /* ---------- HERO ---------- */
    .prod-hero {
      position: relative; isolation: isolate; overflow: hidden;
      min-height: 150px; border-radius: 14px; background: #fff;
      margin: 8px auto 18px; max-width: 950px;
    }
    .prod-hero .inner { padding: 16px; max-width: 850px; margin: 0 auto; }
    .prod-hero h1 { margin: 0 0 6px; font-size: clamp(1.7rem, 2.3vw, 2rem); }
    .prod-hero p { margin: 0; max-width: 60ch; }

    /* ---------- PRODUCT GRID ---------- */
    .prodpg { padding: 0 0 36px; }
    .prodpg__container { max-width: 1100px; margin: 0 auto; padding: 0 12px; }

    .prodpg__grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 20px;
      justify-content: center;
    }
    @media (min-width: 900px) {
      .prodpg__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }

    :root { --card-price-gap: 10px; --card-row-gap: .35rem; }

    /* Unified FLEX card layout (square media) */
    .prodpg__card{
      display: flex;
      flex-direction: column;
      gap: var(--card-row-gap);
      height: 100%;
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      padding: 10px;
      box-shadow: 0 4px 10px rgba(0,0,0,.05);
      margin: 0;
      transition: transform .15s ease;
    }
    .prodpg__card:hover { transform: translateY(-2px); }

    .card-photo {
      width: 100%;
      aspect-ratio: 1 / 1;           /* square */
      overflow: hidden;
      border-radius: 8px;
      background: #fff;
      box-shadow: 0 3px 6px rgba(0,0,0,.04);
      display: block;
    }
    .card-photo-img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: center;
      padding: 8px;
      display: block;
      border-radius: 8px;
    }

    .prodpg__title { margin: .25rem 0 0; line-height: 1.1; font-weight: 700; font-size: .95rem; }
    .prodpg__title .unit { display: block; font-weight: 600; font-size: .85rem; }

    .prodpg__price{
      order: 90;
      font-weight: 800; font-size: .9rem;
      margin: 0 !important;
      margin-top: auto !important;
      margin-bottom: calc(var(--card-price-gap) - var(--card-row-gap)) !important;
    }
    @supports (margin-bottom: max(0px, 1px)) {
      .prodpg__price{
        margin-bottom: max(0px, calc(var(--card-price-gap) - var(--card-row-gap))) !important;
      }
    }

    .prodpg__bullets { margin: .05rem 0 .3rem; padding-left: 1rem; font-size: .85rem; }
    .prodpg__bullets li { margin: .08rem 0; }

    .prodpg__desc {
      line-height: 1.4; color: #374151;
      font-size: .85rem; margin: .15rem 0 .25rem;
    }

    .product-cta {
      order: 100;
      display: flex; align-items: center; gap: 10px;
      flex-wrap: wrap; margin-top: .15rem;
    }
    .product-cta .add-to-cart {
      display: inline-flex;
      padding: 10px 16px;
      font-size: .95rem;
      border-radius: 0;
      background: #000;
      color: #fff;
      font-weight: 600;
      border: 0;
      text-decoration: none;
      cursor: pointer;
      transition: background-color .15s ease;
    }
    .product-cta .add-to-cart:hover { background: #222; }
    .product-cta .add-to-cart:focus-visible { outline: 3px solid #60a5fa; outline-offset: 2px; }

    .btn-link { background: transparent; color: #1f2937; font-size: .85rem; }

    /* ===== Testimonials (full-bleed band) ===== */
    .tbox--bleed {
      width: 100vw;
      margin-left: 50%;
      transform: translateX(-50%);
      background: #fafafa;
      border-top: 1px solid #ececec;
      border-bottom: 1px solid #ececec;
      padding: 28px 0 40px;
    }
    .tbox__container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 12px;
    }
    .tbox h2 {
      margin: 0 0 6px;
      font-size: clamp(1.2rem, 2.2vw, 1.5rem);
    }
    .tbox__lead {
      margin: 0 0 14px;
      color: #475569;
      font-size: .95rem;
    }

    .tlist {
      display: grid;
      grid-template-columns: 1fr;   /* mobile */
      gap: 14px;
    }
    @media (min-width: 820px) {
      .tlist { grid-template-columns: 1fr 1fr; }
    }

    .tquote {
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      padding: 14px;
      box-shadow: 0 4px 10px rgba(0,0,0,.05);
    }
    .tquote blockquote {
      margin: 0 0 8px;
      position: relative;
      padding-left: 12px;
      color: #0f172a;
      line-height: 1.5;
    }
    .tquote blockquote::before {
      content: "“";
      position: absolute;
      left: -4px;
      top: -6px;
      font-size: 2rem;
      line-height: 1;
      opacity: .2;
    }
    .tquote figcaption {
      font-size: .9rem;
      color: #475569;
    }
  </style>
</BaseLayout>
