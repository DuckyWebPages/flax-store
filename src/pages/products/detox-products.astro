    <div class="inner">
      <h1>Detox Products</h1>
      <p>
        Targeted support for both heavy detox and gentle cleansing. These products are natural and not hard on your system, but yet effective at removing toxins.
      </p>
    </div>
  </section>

  <section class="prodpg">
    <div class="prodpg__container">
      <h2 class="products-title sr-only">Detox Products</h2>

      <div class="prodpg__grid">
