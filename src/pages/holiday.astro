<script is:inline>
for (const button of document.querySelectorAll('.code')) {
  button.addEventListener('click', async () => {
    const status = button.parentElement.querySelector('[role="status"]');
    try {
      await navigator.clipboard.writeText(button.textContent);
      status.textContent = 'Copied!';
    } catch {
      status.textContent = 'Enter ' + button.textContent + ' at checkout.';
    }
  });
}

const saleEndsAt = Date.parse('2026-11-28T00:00:00-06:00');
function checkSaleDeadline() {
  const remaining = saleEndsAt - Date.now();
  if (remaining > 0) {
    setTimeout(checkSaleDeadline, Math.min(remaining, 2147483647));
    return;
  }
  document.querySelector('.hero').hidden = true;
  document.querySelector('main').hidden = true;
  document.querySelector('#sale-ended').hidden = false;
}
checkSaleDeadline();
</script></html>