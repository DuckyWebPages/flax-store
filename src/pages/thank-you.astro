---
// FILE: src/pages/thank-you.astro
import BaseLayout from "../layouts/BaseLayout.astro";

// Grab ?session_id from the URL (client will fetch details)
const title = "Thank you!";
---

<BaseLayout pageTitle={title}>
  <div class="thankyou">
    <h1>{title}</h1>

    <p class="lead">
      Thank you for shopping with us! Weâ€™ve received your order. A receipt has been emailed to you.
      Questions? Call 817-710-6918.
    </p>

    <img
      src="/images/products/flaxgift.png"
      alt="Shopping bag with Flax Lignans jars"
      width="250"
      height="auto"
      loading="lazy"
      decoding="async"
      class="hero-img"
    />

    <div id="order-summary" class="order">
      <p>Loading your orderâ€¦</p>
    </div>
  </div>

  <script>
  (async () => {
    const params = new URLSearchParams(window.location.search);
    const sessionId = params.get("session_id");
    const box = document.getElementById("order-summary");

    if (!sessionId) {
      box.innerHTML = `
        <p><strong>Order confirmed.</strong></p>
        <p>No session details found in the URL.</p>
      `;
      return;
    }

    try {
      // If your GET file is src/pages/api/checkout.ts, use /api/checkout here.
      const res = await fetch(`/api/checkout?session_id=${encodeURIComponent(sessionId)}`);
      const raw = await res.text();
      let data = null; try { data = raw ? JSON.parse(raw) : null; } catch {}
      if (!res.ok || !data) throw new Error((data && (data.error || data.message)) || `HTTP ${res.status}`);

      // Support either {session: {...}} or flat fields
      const s = data.session ?? data;

      const paymentStatus = s.payment_status ?? "unknown";
      const email = s.customer_details?.email ?? "â€”";
      const currency = (typeof s.currency === "string" ? s.currency : "usd").toUpperCase();
      const total = typeof s.amount_total === "number" ? (s.amount_total / 100) : null;

      // Handle either array or {data:[...]} shape for line items
      const liArr = Array.isArray(s.line_items) ? s.line_items : (s.line_items?.data || []);
      const itemsHtml = liArr.map((li) => {
        const name =
          (li.price && li.price.product && li.price.product.name) ||
          li.description || "Item";
        const qty = li.quantity ?? 1;

        const unitCents =
          (li.price && typeof li.price.unit_amount === "number")
            ? li.price.unit_amount
            : (typeof li.amount_subtotal === "number" ? Math.round(li.amount_subtotal / (qty || 1)) : 0);

        const dollars = (unitCents / 100).toFixed(2);
        return `<li>${name} Ã— ${qty} â€” $${dollars}</li>`;
      }).join("");

      box.innerHTML = `
        <p><strong>Payment status:</strong> ${paymentStatus}</p>
        <p><strong>Email:</strong> ${email}</p>
        ${total !== null ? `<p><strong>Total:</strong> ${currency} ${total.toFixed(2)}</p>` : ""}
        ${itemsHtml ? `<ul class="items">${itemsHtml}</ul>` : "<p><em>No line items were returned.</em></p>"}
        <p class="help">Need help? Reply to your receipt email.</p>
        <p><button type="button" class="print-btn" onclick="window.print()">Print this page</button></p>
      `;
    } catch (e) {
      console.error("thank-you load error:", e);
      box.innerHTML = `
        <div class="returns">
          <p><strong>Order confirmed.</strong></p>
          <p>We know youâ€™ll love your products. If you need to return an item, our <strong>30-day money-back guarantee</strong> applies to <strong>unopened</strong> items only.</p>
          <ul>
            <li>Item must be new, unopened, and the seal intact.</li>
            <li>Email <a href="mailto:info@flaxlignanhealth.com">info@flaxlignanhealth.com</a> to request a Return Authorization (RA) number before sending anything back.</li>
            <li>Ship in the original or comparable protective packaging to the address provided with your RA.</li>
            <li>Refund covers the product price only; original shipping is non-refundable.</li>
            <li>Return shipping is the customerâ€™s responsibility.</li>
            <li>No refunds for opened items or returns more than 30 days from the purchase date.</li>
          </ul>
          <p>Questions? Call 817-710-6918.</p>
          <p><button type="button" class="print-btn" onclick="window.print()">Print this page</button></p>
        </div>
      `;
    }
  })();
</script>

</BaseLayout>
