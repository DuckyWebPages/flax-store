---
import BaseLayout from "../layouts/BaseLayout.astro";

// Grab ?session_id from the URL (client will fetch details)
const title = "Thank you!";
---

<BaseLayout pageTitle={title}>
  <h1>{title}</h1>
  <p>Thank you for shopping with us! We’ve received your order. A receipt has been emailed to you. Questions? Call 817-710-6918.</p>

  <div id="order-summary">
    <p>Loading your order…</p>
  </div>

  <script>
    (async () => {
      const params = new URLSearchParams(window.location.search);
      const sessionId = params.get("session_id");
      const box = document.getElementById("order-summary");

      if (!sessionId) {
        box.innerHTML = `
          <p><strong>Order confirmed.</strong></p>
          <p>No session details found in the URL.</p>
        `;
        return;
      }

      try {
        const res = await fetch(`/api/checkout-session?session_id=${encodeURIComponent(sessionId)}`);
        if (!res.ok) throw new Error("Failed to load session");
        const data = await res.json();

        // ✅ Work with either shape:
        //    { session: {...} }  OR  a flat object with the fields directly on data
        const s = data.session ?? data;

        // Payment + customer info
        const paymentStatus = s.payment_status ?? "unknown";
        const email = s.customer_details?.email ?? "—";

        // Currency/amount helpers (Stripe amounts are in cents)
        const currency = (s.currency || s.amount_total?.currency || "usd").toString().toUpperCase();
        const total = typeof s.amount_total === "number" ? (s.amount_total / 100) : null;

        // Line items (requires your API to expand line_items)
        const lineItems = s.line_items?.data ?? [];
        const itemsHtml = lineItems.map((li) => {
          const name = li.price?.product?.name || li.description || "Item";
          const qty = li.quantity ?? 1;
          // Prefer per-item unit amount; fall back to subtotal if present
          const cents = (typeof li.price?.unit_amount === "number")
            ? li.price.unit_amount
            : (typeof li.amount_subtotal === "number" ? li.amount_subtotal : 0);
          const dollars = (cents / 100).toFixed(2);
          return `<li>${name} × ${qty} — $${dollars}</li>`;
        }).join("");

        box.innerHTML = `
          <p><strong>Payment status:</strong> ${paymentStatus}</p>
          <p><strong>Email:</strong> ${email}</p>
          ${total !== null ? `<p><strong>Total:</strong> ${currency} ${total.toFixed(2)}</p>` : ""}
          ${itemsHtml ? `<ul>${itemsHtml}</ul>` : "<p><em>No line items were returned.</em></p>"}
          <p>Need help? Reply to your receipt email.</p>
        `;
      } catch (e) {
        box.innerHTML = "<p>Order confirmed. We know you are going to LOVE your products!R However, IF you need to return your product, our 30 day money-back guarantee is for unopened product only. Please make sure the product seal has not been broken, and it’s in like-new condition. Pack product in original or comparable packing and email us (info@flaxlignanhealth.com) for a Return Authorization number. Once you receive your Return Authorization number by email, you’ll also have instructions included on return address on where to ship the product. Once we receive the undamaged, new and unopened product, we will refund the full price of the product, minus shipping charges from us to you. It will be your responsibility to pay for return shipping to us as well. Sorry but no refunds can be given for any product that has been opened or the seal broken on the container, or if over 30 days has passed from the original purchase date. If you have questions, call 817-710-6918 to speak with Customer Service.</p>";
      }
    })();
  </script>
</BaseLayout>
