---
import BaseLayout from "@/layouts/BaseLayout.astro";
const title = "Your Cart";
---

<BaseLayout>
  <Fragment slot="title">{title}</Fragment>

  <section style="max-width:900px;margin:20px auto;padding:16px;">
    <h1 style="margin:0 0 12px;">{title}</h1>

    <div id="cart-root" style="min-height:120px;display:flex;align-items:center;justify-content:center;">
      Loading cart…
    </div>

    <style>
      .cart-list{list-style:none;padding:0;margin:0;display:grid;gap:12px}
      .cart-item{display:flex;gap:12px;align-items:flex-start;border:1px solid #e5e7eb;border-radius:12px;padding:12px}
      .cart-img{width:84px;height:84px;object-fit:cover;border-radius:8px;border:1px solid #eee;flex-shrink:0}
      .row{display:flex;gap:12px;align-items:center}
      .grow{flex:1}
      .qty{display:inline-flex;align-items:center;gap:8px}
      .qty input{width:68px;padding:6px 8px;border:1px solid #e5e7eb;border-radius:8px}
      .btn{display:inline-flex;align-items:center;justify-content:center;height:40px;padding:0 14px;border-radius:10px;border:1px solid #e5e7eb;background:#fff;cursor:pointer}
      .btn:hover{background:#f9fafb}
      .cta{display:inline-flex;align-items:center;justify-content:center;height:44px;padding:0 16px;border:0;border-radius:10px;background:#111827;color:#fff;text-decoration:none}
      .cta:hover{opacity:.92;transform:translateY(-1px)}
      .actions{display:flex;gap:12px;justify-content:flex-end;margin-top:16px}
      .muted{color:#6b7280}
      .price{font-weight:700}
    </style>

    <script type="module">
      import { getCart, setLineQuantity, removeLine, getCheckoutUrl } from "/src/lib/shopify-cart.ts";

      const root = document.getElementById("cart-root");

      function money(amount, code){
        try { return new Intl.NumberFormat('en-US', { style:'currency', currency: code || 'USD' }).format(Number(amount||0)); }
        catch { return '$0.00'; }
      }

      async function render(){
        const cart = await getCart();
        if(!cart || !cart.lines?.nodes?.length){
          root.innerHTML = `
            <div style="text-align:center;">
              <p>Your cart is empty.</p>
              <a class="cta" href="/products">Browse Products</a>
            </div>`;
          return;
        }

        const lines = cart.lines.nodes;
        const itemsHtml = lines.map(l => {
          const v   = l.merchandise;
          const img = v?.image?.url || '/images/placeholder-84.png';
          const title = v?.product?.title || v?.title || 'Item';
          const qty = l.quantity;
          const unit = money(v?.price?.amount, v?.price?.currencyCode);
          const total = money(l?.cost?.totalAmount?.amount, l?.cost?.totalAmount?.currencyCode);
          const handle = v?.product?.handle ? `/products/${v.product.handle}` : '#';

          return `
            <li class="cart-item" data-line="${l.id}">
              <img class="cart-img" src="${img}" alt="" loading="lazy" decoding="async">
              <div class="grow">
                <div class="row" style="justify-content:space-between;">
                  <a href="${handle}" style="font-weight:700;text-decoration:none;color:inherit">${title}</a>
                  <span class="price">${total}</span>
                </div>

                <div class="row" style="margin-top:8px;">
                  <div class="qty">
                    <button class="btn" data-dec aria-label="Decrease">−</button>
                    <input data-qty type="number" min="1" value="${qty}">
                    <button class="btn" data-inc aria-label="Increase">+</button>
                  </div>
                  <button class="btn" data-remove style="margin-left:12px;">Remove</button>
                  <span class="muted" style="margin-left:auto;">Unit: ${unit}</span>
                </div>
              </div>
            </li>
          `;
        }).join('');

        const checkoutUrl = getCheckoutUrl() || cart.webUrl;

        root.innerHTML = `
          <ul class="cart-list">${itemsHtml}</ul>
          <div class="actions">
            <a class="btn" href="/products">Continue Shopping</a>
            <a class="cta" href="${checkoutUrl}">Checkout</a>
          </div>
        `;
      }

      root.addEventListener('click', async (e) => {
        const t = e.target;
        if(!(t instanceof HTMLElement)) return;
        const row = t.closest('.cart-item');
        if(!row) return;
        const lineId = row.getAttribute('data-line');

        if(t.hasAttribute('data-inc') || t.hasAttribute('data-dec')){
          const input = row.querySelector('[data-qty]');
          const current = Math.max(1, parseInt(input.value || '1', 10));
          const next = t.hasAttribute('data-inc') ? current + 1 : Math.max(1, current - 1);
          await setLineQuantity(lineId, next);
          await render();
          return;
        }

        if(t.hasAttribute('data-remove')){
          await removeLine(lineId);
          await render();
          return;
        }
      });

      root.addEventListener('change', async (e) => {
        const t = e.target;
        if(!(t instanceof HTMLInputElement) || !t.hasAttribute('data-qty')) return;
        const row = t.closest('.cart-item');
        const lineId = row.getAttribute('data-line');
        const val = Math.max(1, parseInt(t.value || '1', 10));
        await setLineQuantity(lineId, val);
        await render();
      });

      render();
    </script>
  </section>
</BaseLayout>
