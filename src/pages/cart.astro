<script type="module">
  import { Cart } from "@/lib/cart";

  function render() {
    const mount = document.getElementById("cart-list");
    const cart = Cart.all(); // [{id,name,unitCents,image,qty}]
    if (!cart.length) {
      mount.innerHTML = "<p>Your cart is empty.</p>";
      return;
    }

    mount.innerHTML = cart.map(i => `
      <div class="row" data-sku="${i.id}">
        <img src="${i.image ?? ""}" alt="" style="width:64px;height:64px;object-fit:cover;margin-right:.5rem;" />
        <div style="flex:1;">
          <strong>${i.name}</strong><br />
          $${(i.unitCents/100).toFixed(2)}
        </div>
        <input type="number" min="1" value="${i.qty}" class="qty" style="width:64px;" />
        <button class="rm">Remove</button>
      </div>
    `).join("");
  }

  // Remove item
  document.addEventListener("click", (e) => {
    const t = e.target;
    if (!(t instanceof HTMLElement)) return;
    if (t.classList.contains("rm")) {
      const row = t.closest(".row");
      const sku = row?.getAttribute("data-sku");
      if (sku) { Cart.remove(sku); render(); }
    }
  });

  // Qty change
  document.addEventListener("change", (e) => {
    const t = e.target;
    if (!(t instanceof HTMLInputElement)) return;
    if (t.classList.contains("qty")) {
      const row = t.closest(".row");
      const sku = row?.getAttribute("data-sku");
      if (sku) {
        Cart.setQty(sku, Math.max(1, Number(t.value) || 1));
        render();
      }
    }
  });

  // Checkout (SKU + qty + optional promo/country)
  document.getElementById("checkout")?.addEventListener("click", async () => {
    const items = Cart.all();
    if (!items.length) { alert("Your cart is empty."); return; }

    // Optional country selector (harmless if backend ignores it)
    const selectEl = /** @type {HTMLSelectElement|null} */ (document.getElementById("country"));
    const country = (selectEl && selectEl.value ? String(selectEl.value) : "US").toUpperCase();

    // Optional promo (reads the drawer input if present site-wide)
    const couponEl = /** @type {HTMLInputElement|null} */ (document.querySelector("[data-coupon]"));
    const promoCode = couponEl ? couponEl.value.trim() : "";

    const payload = {
      items: items.map(i => ({ id: i.id, qty: i.qty })), // <-- SKU + qty
      promoCode,
      // Include if/when your API uses it:
      // country,
    };

    try {
      const res = await fetch("/api/create-checkout-session", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(payload),
      });

      // Read raw first to avoid JSON.parse crash on HTML error pages
      const raw = await res.text();
      let data = null; try { data = raw ? JSON.parse(raw) : null; } catch {}

      if (!res.ok || !data?.url) {
        const msg = (data && (data.error || data.message)) || `Checkout failed (HTTP ${res.status}).`;
        console.error("Checkout init failed:", res.status, data || raw);
        alert(msg);
        return;
      }

      window.location.href = data.url; // Stripe Checkout
    } catch (err) {
      console.error("Checkout request error:", err);
      alert("Network error initializing checkout.");
    }
  });

  // Initial render
  render();
</script>
