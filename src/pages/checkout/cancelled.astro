---
import BaseLayout from "@/layouts/BaseLayout.astro";
const title = "Redirecting…";
---
<BaseLayout>
  <Fragment slot="title">{title}</Fragment>
  <section class="wrap">
    <h1>Redirecting…</h1>
    <p>If you are not redirected, <a href="/cartcancel">click here</a>.</p>
  </section>
  <script>
    if (typeof window !== "undefined") {
      window.location.replace("/cartcancel");
    }
  </script>
  <style>.wrap{max-width:800px;margin:24px auto;padding:0 12px}</style>
</BaseLayout>
