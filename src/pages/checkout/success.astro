---
import BaseLayout from "@/layouts/BaseLayout.astro";
const title = "Redirecting…";
const qs = typeof Astro !== "undefined" ? Astro.url.search : "";
---
<BaseLayout>
  <Fragment slot="title">{title}</Fragment>
  <section class="wrap">
    <h1>Redirecting…</h1>
    <p>If you are not redirected, <a href={'/success' + qs}>click here</a>.</p>
  </section>
  <script>
    if (typeof window !== "undefined") {
      const qs = window.location.search || "";
      window.location.replace("/success" + qs);
    }
  </script>
  <style>.wrap{max-width:800px;margin:24px auto;padding:0 12px}</style>
</BaseLayout>
