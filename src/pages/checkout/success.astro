---
import BaseLayout from "@/layouts/BaseLayout.astro";
const qs = typeof Astro !== "undefined" ? Astro.url.search : "";
---
<BaseLayout>
  <main style="max-width:680px;margin:40px auto;padding:0 16px;text-align:center;">
    <h1>Redirecting…</h1>
    <p>If you are not redirected, <a href={'/success' + qs}>click here</a>.</p>
  </main>
  <script>
    if (typeof window !== "undefined") {
      const qs = window.location.search || "";
      window.location.replace("/success" + qs);
    }
  </script>
</BaseLayout>
