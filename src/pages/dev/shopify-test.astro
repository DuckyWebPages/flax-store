---
import { getProductByHandle } from "@/lib/shopify";

const HANDLE = "fhl-flax-hull-lignans-single-jar";


let product = null;
let error: string | null = null;

try {
  product = await getProductByHandle(HANDLE);
} catch (e) {
  error = e instanceof Error ? e.message : String(e);
}
---

<html lang="en">
  <head><meta charset="utf-8" /><title>Shopify Test</title></head>
  <body style="font-family: system-ui; padding: 24px;">
    <h1>Shopify Test</h1>
    <p>Handle: <code>{HANDLE}</code></p>

    {error ? (
      <pre style="color:red; white-space:pre-wrap;">{error}</pre>
    ) : product ? (
      <div>
        <h2>{product.title}</h2>
        {product.featuredImage && (
          <img
            src={product.featuredImage.url}
            alt={product.featuredImage.altText || product.title}
            width="300"
          />
        )}
        <p>{product.description}</p>
        <p>
          Price from: {product.priceRangeV2.minVariantPrice.amount} {product.priceRangeV2.minVariantPrice.currencyCode}
        </p>
        {product.variants?.edges?.[0]?.node && (
          <p>
            First variant: {product.variants.edges[0].node.title} —
            {product.variants.edges[0].node.priceV2.amount}
            {" "}
            {product.variants.edges[0].node.priceV2.currencyCode}
          </p>
        )}
      </div>
    ) : (
      <p>No product found for that handle.</p>
    )}
  </body>
</html>
