---
import CartApp from "../components/CartApp.tsx";
import "@/styles/products.css";
---

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title><slot name="title" />Flax Lignan Health</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&family=Source+Sans+3:wght@600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Global styles -->
    <link rel="stylesheet" href="/src/styles/global.css" />
    <link rel="stylesheet" href="/src/styles/store.css" />

    <style>
      :root {
        --font-body: 'Inter', system-ui, -apple-system, Segoe UI, Roboto, Arial,
          sans-serif;
        --font-head: 'Source Sans 3', 'Inter', system-ui, -apple-system,
          Segoe UI, Roboto, Arial, sans-serif;
        --ink: #0f172a;
        --ink-muted: #64748b;
        --accent: #0b7a53;
        --header-h: 88px;
      }

      body {
        margin: 0;
        font-family: var(--font-body);
        color: var(--ink);
        background: #ffffff
          url('/images/backgroundw.jpg') center top / cover no-repeat fixed;
      }

      h1, h2, h3, h4 {
        font-family: var(--font-head);
        letter-spacing: -0.01em;
      }

      .site-header-wrap {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 9999;
        background: #fff;
        border-bottom: 1px solid #e5e7eb;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.12);
        height: var(--header-h);
      }

      .site-header {
        max-width: 1100px;
        margin: 0 auto;
        height: var(--header-h);
        padding: 0 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        line-height: 0;
      }

      .nav-logo {
        height: 64px;
        width: auto;
        display: block;
      }

      nav.main-nav {
        display: flex;
        gap: 24px;
        align-items: center;
      }

      .nav-link {
        color: var(--ink);
        font-weight: 600;
        text-decoration: none;
        padding: 6px 8px;
        border-radius: 6px;
        cursor: pointer;
      }

      .nav-link:hover {
        background: #f3f4f6;
      }

      main, footer {
        max-width: 1100px;
        margin: 0 auto;
      }

      main {
        padding: calc(var(--header-h) + 16px) 16px 56px;
      }

      footer {
        padding: 16px;
        color: var(--ink-muted);
        background: transparent;
      }

      .btn-cta {
        background: #111827;
        color: #fff;
        border: 0;
        border-radius: 9999px;
        padding: 10px 16px;
        min-width: 160px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.18);
        cursor: pointer;
        transition: transform 0.08s ease, opacity 0.15s ease;
      }

      .btn-cta:hover {
        opacity: 0.92;
        transform: translateY(-1px);
      }

      /* --- Overlay for React Drawer --- */
      .cart-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.4);
        backdrop-filter: blur(2px);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.25s ease;
        z-index: 9998;
      }

      .cart-overlay.open {
        opacity: 1;
        pointer-events: auto;
      }
    </style>
    <style is:global>
  .prodpg__desc { font-weight: 400; line-height: 1.55; }
  .prodpg__desc p { margin: 0 0 14px; }
  .prodpg__desc strong { font-weight: inherit; }
</style>

  </head>

  <body>
    <div class="site-header-wrap">
      <div class="site-header">
        <a href="/" class="brand" aria-label="Flax Lignan Health home">
          <img
            src="/images/flh-logo-33.png?v=6"
            alt="Flax Lignan Health"
            class="nav-logo"
            decoding="async"
            loading="eager"
            fetchpriority="high"
          />
        </a>

        <nav class="main-nav" aria-label="Main">
          <a
            href="/"
            class="nav-link"
            aria-current={Astro.url.pathname === '/' ? 'page' : undefined}
            >Home</a
          >
          <a
            href="/products"
            class="nav-link"
            aria-current={Astro.url.pathname.startsWith('/products')
              ? 'page'
              : undefined}
            >Products</a
          >
          <a
            href="/blog/"
            class="nav-link"
            aria-current={Astro.url.pathname.startsWith('/blog')
              ? 'page'
              : undefined}
            >Blog</a
          >
          <a
            href="/contact"
            class="nav-link"
            aria-current={Astro.url.pathname === '/contact'
              ? 'page'
              : undefined}
            >Contact Us</a
          >
        <!-- Cart Button -->
          <button
            class="nav-link nav-cart"
            aria-label="Open cart"
            onClick={() => window.cartOpen && window.cartOpen()}
          >
            <img
              src="/images/shoppingcart.jpg"
              alt=""
              class="cart-icon"
              width="22"
              height="22"
              loading="lazy"
              decoding="async"
            />
            <span
              class="cart-badge"
              id="cart-badge"
              style="margin-left:4px; background:#0b7a53; color:#fff; border-radius:9999px; padding:2px 6px; font-size:11px; display:none;"
            >0</span>
          </button>
        </nav>
      </div>
    </div>

    <main><slot /></main>

    <footer>© {new Date().getFullYear()} Flax Lignan Health</footer>

    {/* Mount ONE cart UI */}
    <CartApp client:only="react" />


    <!-- Cart bridge: persists to localStorage, updates badge, and enforces add-to-cart vs buy-now -->
   <script>
  // One job: turn any ".add-to-cart" click into a call to the React cart
  document.addEventListener('click', (e) => {
    const btn = e.target.closest('button, a');
    if (!btn) return;

    // ADD TO CART
    if (btn.classList.contains('add-to-cart')) {
      e.preventDefault(); e.stopPropagation();

      const sku    = btn.getAttribute('data-sku') || btn.getAttribute('sku') || '';
      const qty    = Number(btn.getAttribute('data-qty') || '1');
      const name   = btn.getAttribute('data-name') || btn.textContent?.trim() || '';
      const image  = btn.getAttribute('data-image') || '';
      const price  = btn.getAttribute('data-price');             // cents (optional)
      const priceId= btn.getAttribute('data-price-id') || '';    // optional

      if (window.FLH_ADD) {
        window.FLH_ADD({
          id: sku,
          name,
          qty,
          unitCents: price ? Number(price) : 0,
          priceId,
          image
        });
      }
      if (window.cartOpen) window.cartOpen();
      return;
    }

    // BUY NOW (explicit only; optional)
    const isBuyNow = btn.classList.contains('buy-now') || btn.getAttribute('data-buynow') === '1';
    if (isBuyNow) {
      e.preventDefault(); e.stopPropagation();
      const sku = btn.getAttribute('data-sku') || btn.getAttribute('sku') || '';
      const qty = Number(btn.getAttribute('data-qty') || '1');
      fetch('/api/create-checkout-session', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ items: [{ id: sku, qty }] })
      })
      .then(r => r.json())
      .then(data => { if (data?.url) location.href = data.url; else alert(data?.error || 'Checkout error'); })
      .catch(() => alert('Network error'));
    }
  }, { capture: true });
</script>



  </body>
</html>

