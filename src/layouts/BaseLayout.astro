---
/* Simple, reliable layout with fixed header + clean nav */
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title><slot name="title" />Flax Lignan Health</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&family=Source+Sans+3:wght@600;700&display=swap" rel="stylesheet">

    <style>
      :root{
        --font-body:'Inter',system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;
        --font-head:'Source Sans 3','Inter',system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;
        --ink:#0f172a; --ink-muted:#64748b;
      }
      *{box-sizing:border-box}

      body{
        margin:0;
        font-family:var(--font-body);
        color:var(--ink);
        /* SITE-WIDE BACKGROUND IMAGE */
        background: #0b7a53 url("/images/background3.png") center top / cover no-repeat fixed;
      }

      /* Fixed header (kept solid so bg image doesn’t show through) */
      .site-header-wrap{
        position:fixed; top:0; left:0; right:0; z-index:9999;
        background:#ffffff;
        border-bottom:1px solid #e5e7eb;
      }
      .site-header{
        max-width:1100px; margin:0 auto; padding:6px 14px;
        display:flex; align-items:flex-start; justify-content:space-between;
      }

      /* Brand logo */
      .brand{display:inline-flex; align-items:flex-start; line-height:0;}
      .nav-logo{
        height:200px; width:auto; display:block;
        margin-top:-8px; margin-bottom:-4px;
      }
      @media (min-width:1024px){
        .nav-logo{height:220px; margin-top:-10px;}
      }

      nav.main-nav{display:flex; gap:20px; align-items:flex-end; margin-top:8px;}
      .nav-link{
        color:var(--ink); font-weight:600; text-decoration:none;
        padding:8px 10px; border-radius:8px;
      }
      .nav-link:hover{ background:#f3f4f6; }
      .nav-link[aria-current="page"]{ text-decoration:underline; }

      /* Page shell spacing for tall header */
      main,footer{ max-width:1100px; margin:0 auto; }
      main{ padding:260px 16px 56px; }
      footer{ padding:16px; color:var(--ink-muted); background:rgba(255,255,255,.85); border-radius:12px 12px 0 0; }

      /* Headings */
      h1,h2,h3,h4,.site-title,.products-title{
        font-family:var(--font-head);
        letter-spacing:-.01em; line-height:1.15;
      }
      h1,.site-title,h2,.products-title{ font-weight:700; }
      h3,h4{ font-weight:600; }
    </style>
  </head>

  <body>
    <div class="site-header-wrap">
      <div class="site-header">
        <a href="/" class="brand" aria-label="Flax Lignan Health home">
          <img src="/images/flh-logo-3.png" alt="Flax Lignan Health" class="nav-logo" />
        </a>

        <nav class="main-nav" aria-label="Main">
          <a href="/" class="nav-link" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Home</a>
          <a href="/products" class="nav-link" aria-current={Astro.url.pathname.startsWith('/products') ? 'page' : undefined}>Products</a>
          <a href="/blog/" class="nav-link" aria-current={Astro.url.pathname.startsWith('/blog') ? 'page' : undefined}>Blog</a>
          <a href="/contact" class="nav-link" aria-current={Astro.url.pathname === '/contact' ? 'page' : undefined}>Contact Us</a>
        </nav>
      </div>
    </div>

    <main><slot /></main>

    <footer>© {new Date().getFullYear()} Flax Lignan Health</footer>
  </body>
</html>
