<!-- Cart + Drawer + Renderer (single block, no imports) -->
<script is:inline>
(function () {
  // ===== Inline Cart (no imports) =====
  var KEY = "flax_cart_v1";
  function read(){ try{ return JSON.parse(localStorage.getItem(KEY) || "[]"); } catch(e){ return []; } }
  function write(items){ localStorage.setItem(KEY, JSON.stringify(items)); }

  var Cart = {
    all: function(){ return read(); },
    count: function(){ return read().reduce(function(n,i){ return n + i.qty; }, 0); },
    totalCents: function(){ return read().reduce(function(n,i){ return n + i.qty * i.unitCents; }, 0); },
    add: function(item, qty){
      qty = Number(qty || 1);
      var items = read();
      var idx = items.findIndex(function(x){ return x.id === item.id; });
      if (idx >= 0) items[idx].qty += qty;
      else items.push({ id:item.id, name:item.name, unitCents:item.unitCents, image:item.image, qty:qty });
      write(items);
      window.dispatchEvent(new CustomEvent("cart:updated"));
    },
    setQty: function(id, qty){
      qty = Number(qty || 0);
      var items = read().map(function(i){ return i.id === id ? Object.assign({}, i, { qty: qty }) : i; })
                        .filter(function(i){ return i.qty > 0; });
      write(items);
      window.dispatchEvent(new CustomEvent("cart:updated"));
    },
    remove: function(id){
      write(read().filter(function(i){ return i.id !== id; }));
      window.dispatchEvent(new CustomEvent("cart:updated"));
    },
    clear: function(){
      write([]);
      window.dispatchEvent(new CustomEvent("cart:updated"));
    }
  };
  window.Cart = Cart; // expose for Console

  // ===== Drawer elements =====
  var drawer  = document.querySelector("[data-cart-drawer]");
  var overlay = document.querySelector("[data-cart-overlay]");
  var listEl  = document.querySelector("[data-cart-items]");
  var subEl   = document.querySelector("[data-subtotal]");

  function openDrawer(){
    if (!drawer || !overlay) return;
    drawer.classList.add("is-open");
    overlay.classList.add("is-open");
    drawer.hidden = false; overlay.hidden = false;
    drawer.setAttribute("aria-hidden","false");
  }
  function closeDrawer(){
    if (!drawer || !overlay) return;
    drawer.classList.remove("is-open");
    overlay.classList.remove("is-open");
    drawer.hidden = true; overlay.hidden = true;
    drawer.setAttribute("aria-hidden","true");
  }

  function fmt(cents){ return (cents/100).toLocaleString("en-US",{style:"currency",currency:"USD"}); }

  function render(){
    var items = Cart.all();

    if (listEl) {
      if (!items.length) {
        listEl.innerHTML = '<li class="cart-item" style="border:0;padding:18px;">Your cart is empty.</li>';
      } else {
    listEl.innerHTML = items.map(function(i){
  return ''+
  '<li class="cart-item" data-id="'+i.id+'">'+
    (i.image ? '<img class="ci-thumb" src="'+i.image+'" alt="" loading="lazy" decoding="async">' : '')+
    '<div class="ci-main">'+
      '<div class="ci-row">'+
        '<p class="ci-title">'+i.name+'</p>'+
        '<button class="btn-remove" data-remove="'+i.id+'" aria-label="Remove item">'+
          '<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">'+
            '<path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>'+
          '</svg>'+
        '</button>'+
      '</div>'+
      '<div class="ci-row">'+
        '<div class="qty" aria-label="Quantity">'+
          '<button class="qty-btn" data-dec="'+i.id+'" aria-label="Decrease">–</button>'+
          '<input class="qty-input" value="'+i.qty+'" inputmode="numeric" data-qty="'+i.id+'">'+
          '<button class="qty-btn" data-inc="'+i.id+'" aria-label="Increase">+</button>'+
        '</div>'+
        '<div class="ci-price">'+fmt(i.unitCents * i.qty)+'</div>'+
      '</div>'+
    '</div>'+
  '</li>';
}).join("");

      }
    }
    if (subEl) subEl.textContent = fmt(Cart.totalCents());
// Update counts/badges (header + nav)
// Update counts/badges
var count = Cart.count();

// Drawer header badge
var drawerBadge = document.querySelector('[data-cart-count]');
if (drawerBadge) drawerBadge.textContent = String(count);

// Header icon bubble
var navBadge = document.querySelector('[data-cart-count-nav]');
if (navBadge) {
  if (count > 0) {
    navBadge.textContent = String(count);
    navBadge.removeAttribute('hidden');
  } else {
    navBadge.setAttribute('hidden', '');
  }
}

// Enable/disable checkout button
var checkoutBtn = document.querySelector('[data-checkout]');
if (checkoutBtn) checkoutBtn.disabled = count === 0;

  }

  // Initial paint
  render();

  // Open & render on cart change
  window.addEventListener("cart:updated", function(){ render(); openDrawer(); });

  // Click handling (open/close, qty, remove, add-to-cart)
  document.addEventListener("click", function(e){
    var el = e.target instanceof Element ? e.target : null;
    if (!el) return;

    if (el.closest("[data-cart-open]")) { openDrawer(); return; }
    if (el.closest("[data-cart-close]") || el.closest("[data-cart-overlay]")) { closeDrawer(); return; }

    // Qty +
    var inc = el.closest("[data-inc]"); if (inc) {
      var idI = inc.getAttribute("data-inc");
      var currI = (Cart.all().find(function(i){ return i.id===idI; }) || { qty:1 }).qty;
      Cart.setQty(idI, currI + 1); return;
    }
    // Qty –
    var dec = el.closest("[data-dec]"); if (dec) {
      var idD = dec.getAttribute("data-dec");
      var currD = (Cart.all().find(function(i){ return i.id===idD; }) || { qty:1 }).qty;
      Cart.setQty(idD, Math.max(0, currD - 1)); return;
    }
    // Remove
    var rm = el.closest("[data-remove]"); if (rm) {
      var idR = rm.getAttribute("data-remove");
      Cart.remove(idR); return;
    }

    // Add-to-cart
    var btn = el.closest(".add-to-cart");
    if (!btn) return;

    var sku   = btn.getAttribute("data-sku") || "";
    var name  = btn.getAttribute("data-name") || sku;
    var cents = Number(btn.getAttribute("data-price") || "0");
    var image = btn.getAttribute("data-image") || "";
    var qty   = Number(btn.getAttribute("data-qty") || "1");

    if (!sku || !Number.isFinite(cents) || !Number.isFinite(qty)) {
      console.warn("[Cart] Bad button data", { sku:sku, cents:cents, qty:qty });
      return;
    }

    Cart.add({ id: sku, name: name, unitCents: cents, image: image }, qty);

    // Toast + open drawer
    var toast = document.querySelector("[data-cart-toast]");
    if (toast) {
      toast.removeAttribute("hidden");
      toast.classList.add("show");
      setTimeout(function(){ toast.classList.remove("show"); toast.setAttribute("hidden",""); }, 1200);
    }
    openDrawer();
  });

  // ESC closes drawer
  window.addEventListener("keydown", function(e){ if (e.key === "Escape") closeDrawer(); });
// --- Checkout handler (Stripe) ---
var checkoutBtn = document.querySelector("[data-checkout]");
if (checkoutBtn) {
  checkoutBtn.addEventListener("click", async function () {
    var items = Cart.all();
    if (!items.length) {
      alert("Your cart is empty.");
      return;
    }

    // Only send minimal data
var skinny = items.map(function (i) { return { id: i.id, qty: i.qty }; });

// Read promo from the single field (optional)
var couponEl = document.querySelector('[data-coupon]');
var promoCode = couponEl ? couponEl.value.trim() : '';

// Optional country selector (only include if your API uses it)
// var countryEl = document.querySelector('[data-country]');
// var country = countryEl ? String(countryEl.value).toUpperCase() : undefined;

// Prevent double sessions
checkoutBtn.disabled = true;

try {
  const payload = {
    items: skinny,
    promoCode: promoCode,
    // ...(country ? { country } : {}),
  };

  const res = await fetch('/api/create-checkout-session', {
    method: 'POST',
    headers: { 'content-type': 'application/json' },
    body: JSON.stringify(payload),
  });

  // Read raw first to avoid JSON.parse crash if server returns HTML
  const raw = await res.text();
  let data = null; try { data = raw ? JSON.parse(raw) : null; } catch {}

  if (!res.ok || !data || !data.url) {
    throw new Error((data && (data.error || data.message)) || `Checkout failed (HTTP ${res.status}).`);
  }

  window.location.href = data.url; // Stripe Checkout
} catch (err) {
  console.error('[checkout] error:', err);
  alert('Sorry—checkout could not start: ' + (err && err.message ? err.message : 'Unknown error'));
} finally {
  checkoutBtn.disabled = false;
}


</script>
