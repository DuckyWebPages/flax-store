---
// FILE: src/layouts/BaseLayout.astro
/* Base layout with fixed header, global styles, and cart drawer */
---
<!doctype html>
<html lang="en">
  <head>
  <meta charset="utf-8" />
  <title><slot name="title" />Flax Lignan Health</title>

  <!-- Preconnects improve font loading -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&family=Source+Sans+3:wght@600;700&display=swap" rel="stylesheet">

  <link rel="preload" as="image" href="/images/flh-logo-33.png?v=6" />
  <link rel="preload" as="image" href="/images/backgroundw.jpg" />


    <style>
      :root{
        --font-body:'Inter',system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;
        --font-head:'Source Sans 3','Inter',system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;
        --ink:#0f172a; --ink-muted:#64748b;
        --header-h: 88px;
      }
      *{ box-sizing:border-box; }

     body {
  margin: 0;
  font-family: var(--font-body);
  color: var(--ink);
  background: #ffffff url("/images/backgroundw.jpg") center top / cover no-repeat fixed;
}
h1 {
  font-size: 2rem;    /* or whatever size you want */
  margin: 0 0 1rem;   /* top=0, bottom=1rem */
}

      /* Fixed slim header */
      .site-header-wrap{
        position:fixed; top:0; left:0; right:0; z-index:9999;
        background:#ffffff; border-bottom:1px solid #e5e7eb;
        box-shadow:0 2px 6px rgba(0,0,0,.12);
        height:var(--header-h);
      }
      .site-header{
        max-width:1100px; margin:0 auto; height:var(--header-h);
        padding:0 16px; display:flex; align-items:center; justify-content:space-between;
      }

      /* Brand */
      .brand{ display:inline-flex; align-items:center; line-height:0; }
      .nav-logo{ height:64px; width:auto; display:block; }
      @media (min-width:1024px){ .nav-logo{ height:72px; } }

      nav.main-nav{ display:flex; gap:24px; align-items:center; }
      .nav-link{
        color:var(--ink); font-weight:600; text-decoration:none;
        padding:6px 8px; border-radius:6px;
      }
      .nav-link:hover{ background:#f3f4f6; }
      .nav-link[aria-current="page"]{ text-decoration:underline; }

      /* Page spacing under slim header */
      main,footer{ max-width:1100px; margin:0 auto; }
      main{ padding: calc(var(--header-h) + 16px) 16px 56px; }
      footer{
        padding:16px; color:var(--ink-muted);
        background:transparent; border-radius:0; /* no white box */
      }

      h1,h2,h3,h4,.site-title,.products-title{
        font-family:var(--font-head); letter-spacing:-.01em; line-height:1.15;
      }
      h1,.site-title,h2,.products-title{ font-weight:700; }
      h3,h4{ font-weight:600; }

      /* Global CTA */
      .btn-cta{
        background:#111827; color:#fff; border:0; border-radius:9999px;
        padding:10px 16px; min-width:160px; font-weight:700; line-height:1;
        display:inline-flex; align-items:center; justify-content:center;
        text-decoration:none; box-shadow:0 6px 18px rgba(0,0,0,.18);
        cursor:pointer; transition:transform .08s ease, opacity .15s ease;
      }
      .btn-cta:hover{ opacity:.92; transform:translateY(-1px); }
      .btn-cta:focus-visible{ outline:2px solid #111827; outline-offset:2px; }

      /* Cart Drawer */
.cart-overlay {
  position: fixed; inset: 0; background: rgba(0,0,0,.35); backdrop-filter: blur(2px);
  opacity: 0; pointer-events: none; transition: opacity .25s ease; z-index: 60;
}
.cart-overlay.is-open { opacity: 1; pointer-events: auto; }

.cart-drawer { position: fixed; inset: 0; z-index: 70; pointer-events: none; }

.cart-panel {
  position: absolute; top: 0; right: 0; height: 100%; width: min(420px, 92vw);
  background: #fff; box-shadow: -8px 0 24px rgba(0,0,0,.15);
  display: grid; grid-template-rows: auto 1fr auto; gap: 12px;
  transform: translateX(105%); /* closed by default */
  transition: transform .28s cubic-bezier(.2,.8,.2,1);
  pointer-events: auto;
}

.cart-drawer.is-open .cart-panel { transform: translateX(0); }

.cart-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16px 18px; border-bottom: 1px solid #eee;
  position: relative;

}
.cart-header h3 { font-size: 1.1rem; letter-spacing: .02em; }


      .ship-progress { padding: 10px 18px; }
      .ship-bar { height: 8px; background: #f1f1f1; border-radius: 999px; overflow: hidden; }
      .ship-bar span { display: block; height: 100%; width: 0%; background: #111; transform-origin: left; transition: width .35s ease; }
      .ship-note { margin-top: 6px; font-size: .9rem; color: #444; }

      .cart-items { list-style: none; margin: 0; padding: 8px 12px 0 12px; overflow: auto; }
    /* One column; no thumbnail */
.cart-item { display: grid; grid-template-columns: 1fr; gap: 12px; padding: 12px; border-bottom: 1px solid #f1f1f1; }
/* (Optional) remove if present */
.ci-thumb { display: none; }

      .ci-main { display: grid; gap: 8px; }
      .ci-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
      .ci-title { font-size: .98rem; margin: 0; }
      
/* kill Firefox’s inner gray padding */
/* Icon button reset */
.icon-btn{
  appearance:none; -webkit-appearance:none; -moz-appearance:none;
  background: transparent;
  border: 0;
  padding: 6px;
  border-radius: 8px;
  cursor: pointer;
  color: #666;
}
.icon-btn:hover{ background:#f5f5f5; color:#000; }
/* kill Firefox’s inner gray padding */
.icon-btn::-moz-focus-inner{ border:0; padding:0; }


      .qty { display: inline-flex; align-items: center; gap: 6px; border: 1px solid #e6e6e6; border-radius: 10px; padding: 4px; }
      .qty-btn { width: 28px; height: 28px; border: none; background: #f4f4f4; border-radius: 8px; cursor: pointer; }
      .qty-btn:active { transform: translateY(1px); }
      .qty-input { width: 42px; text-align: center; border: none; outline: none; font-size: .95rem; }
      .ci-price { font-weight: 600; }

      .cart-footer { padding: 12px 18px 18px; border-top: 1px solid #eee; position: sticky; bottom: 0; background: #fff; }
      .tot-row { display: flex; align-items: center; justify-content: space-between; margin: 8px 0; }
      .tot-row.small { font-size: .9rem; color: #555; }
      .coupon { display: grid; grid-template-columns: 1fr auto; gap: 8px; margin: 12px 0; }
      .coupon .btn { padding: 10px 14px; border-radius: 12px; border: 1px solid #ddd; background: #f9f9f9; cursor: pointer; }
      .btn-cta.btn-checkout { width: 100%; margin-top: 6px; padding: 14px 18px; }

      .trust { display: flex; gap: 12px; align-items: center; margin-top: 10px; font-size: .9rem; color: #444; }
      .trust .lock { display: inline-flex; gap: 6px; align-items: center; }

      .cart-toast {
        position: fixed; left: 50%; top: 20px; transform: translateX(-50%) translateY(-16px);
        background: #111; color: #fff; padding: 10px 14px; border-radius: 999px; box-shadow: 0 8px 24px rgba(0,0,0,.2);
        opacity: 0; pointer-events: none; transition: transform .25s ease, opacity .25s ease; z-index: 80;
      }
      .cart-toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

      /* Cart icon in nav */
      .cart-icon{ width:22px; height:22px; object-fit:contain; display:block; }
      .sr-only{
        position:absolute !important; width:1px; height:1px; padding:0; margin:-1px;
        overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0;
      }
     

      /* --- Cart polish (safe, CSS-only) --------------------------------------- */
/* Accent color (keeps existing if already set) */
:root { --accent: var(--accent, #0b7a53); }

/* Header */
.cart-header {
  background: linear-gradient(180deg, #fff, #fafafa);
}
.cart-header h3 {
  display: flex; align-items: center; gap: 8px;
  font-size: 1.05rem; letter-spacing: .02em;
}


/* Items list (keep your list/grid mechanics; just card look) */
.cart-items { padding: 14px; display: grid; gap: 12px; }
.cart-item {
  border: 1px solid #ececec; border-radius: 14px;
  padding: 12px; background: #fff;
  box-shadow: 0 6px 18px rgba(0,0,0,.05);
  transition: box-shadow .15s ease, transform .06s ease;
}
.cart-item:hover { box-shadow: 0 10px 24px rgba(0,0,0,.07); }

.ci-title { margin: 0; font-weight: 700; font-size: 1rem; }
.ci-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; }



/* Qty controls */
.qty {
  display: inline-flex; align-items: center; gap: 6px;
  background: #fbfbfb; border: 1px solid #e6e6e6; border-radius: 999px; padding: 4px 6px;
}
.qty-btn {
  width: 30px; height: 30px; border: none; border-radius: 999px;
  background: #fff; box-shadow: 0 1px 0 rgba(0,0,0,.04);
  cursor: pointer; font-weight: 700;
  transition: transform .05s ease, background .12s ease, box-shadow .12s ease;
}
.qty-btn:hover { background: #f3f4f6; }
.qty-btn:active { transform: translateY(1px); }
.qty-input {
  width: 42px; text-align: center; border: none; background: transparent; outline: none; font-size: .95rem;
}
.ci-price { font-weight: 700; font-size: 1rem; }

/* Footer + checkout */
.cart-footer { border-top: 1px solid #eee; background: #fff; }
.tot-row span { color: #6b7280; }
.tot-row strong { font-size: 1.05rem; }

/* Checkout button (hard-coded colors, stronger specificity) */
.btn-cta.btn-checkout {
  width: 100%;
  padding: 14px 18px;
  font-size: 1rem;
  font-weight: 700;
  border-radius: 12px;
  border: 0;
  background: linear-gradient(180deg, #0b7a53, #096746) !important; /* no CSS var */
  color: #ffffff !important;
  box-shadow: 0 10px 20px rgba(11,122,83,.22);
  text-shadow: 0 1px 0 rgba(0,0,0,.15);
}
.btn-cta.btn-checkout:hover {
  opacity: 1;
  transform: translateY(-1px);
  box-shadow: 0 12px 24px rgba(11,122,83,.28);
}
.btn-cta.btn-checkout:disabled {
  background: #e5e7eb !important;
  color: #374151 !important;     /* readable gray */
  box-shadow: none;
  cursor: not-allowed;
  text-shadow: none;
}
/* === Cart UI polish (safe, CSS-only) === */

/* Nav cart bubble */
.nav-cart { position: relative; }
.cart-badge {
  position: absolute;
  top: -6px; right: -6px;
  min-width: 18px; height: 18px; padding: 0 5px;
  display: inline-flex; align-items: center; justify-content: center;
  font: 700 12px/18px var(--font-body, system-ui);
  color: #fff; background: #0b7a53; border-radius: 999px;
  box-shadow: 0 2px 6px rgba(0,0,0,.2);
}
.cart-badge[hidden] { display: none !important; }

/* Drawer header count badge (if you show a number next to "Cart") */
.cart-count-badge {
  display: inline-flex; align-items: center; justify-content: center;
  min-width: 22px; height: 22px; padding: 0 6px;
  font: 700 12px/1 var(--font-body, system-ui);
  color: #fff; background: #0b7a53; border-radius: 999px;
  box-shadow: 0 2px 8px rgba(11,122,83,.25);
}



/* FORCE the white round close (X) */
aside.cart-drawer .cart-panel header.cart-header > button.icon-btn[data-cart-close]{
  position: absolute;
  top: 12px;
  right: 12px;
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  border-radius: 9999px;
  border: 1px solid #d9d9d9 !important;
  background: #ffffff !important;
  color: #111; /* drives SVG via currentColor */
  box-shadow: 0 1px 2px rgba(0,0,0,.06);
  transition: background .2s ease, border-color .2s ease, box-shadow .2s ease;
  outline: none;
}
aside.cart-drawer .cart-panel header.cart-header > button.icon-btn[data-cart-close]:hover{
  background:#f5f5f5 !important;
  border-color:#cfcfcf !important;
  box-shadow:0 2px 6px rgba(0,0,0,.08);
}
aside.cart-drawer .cart-panel header.cart-header > button.icon-btn[data-cart-close] svg{
  width:18px; height:18px; display:block;
}
aside.cart-drawer .cart-panel header.cart-header > button.icon-btn[data-cart-close] svg,
aside.cart-drawer .cart-panel header.cart-header > button.icon-btn[data-cart-close] svg *{
  stroke: currentColor;
  fill: none;
  stroke-width: 2;
  stroke-linecap: round;
}

/* === 3D look for small round buttons === */

/* Top-right drawer close (X) */
aside.cart-drawer .cart-panel header.cart-header > button.icon-btn[data-cart-close]{
  background: linear-gradient(#fff, #f3f3f3);
  border: 1px solid #d1d5db;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.7),
    inset 0 -1px 0 rgba(0,0,0,.03),
    0 2px 4px rgba(0,0,0,.12);
}
aside.cart-drawer .cart-panel header.cart-header > button.icon-btn[data-cart-close]:hover{
  background: linear-gradient(#fff, #eeeeee);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.8),
    inset 0 -1px 0 rgba(0,0,0,.04),
    0 3px 6px rgba(0,0,0,.16);
}
aside.cart-drawer .cart-panel header.cart-header > button.icon-btn[data-cart-close]:active{
  transform: translateY(1px);
  box-shadow:
    inset 0 1px 2px rgba(0,0,0,.08),
    0 1px 2px rgba(0,0,0,.12);
}

/* Line-item remove (X) */
.cart-items .btn-remove{
  background: linear-gradient(#fff, #f3f3f3);
  border: 1px solid #d1d5db;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.7),
    inset 0 -1px 0 rgba(0,0,0,.03),
    0 2px 4px rgba(0,0,0,.12);
}
.cart-items .btn-remove:hover{
  background: linear-gradient(#fff, #eeeeee);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.8),
    inset 0 -1px 0 rgba(0,0,0,.04),
    0 3px 6px rgba(0,0,0,.16);
}
.cart-items .btn-remove:active{
  transform: translateY(1px);
  box-shadow:
    inset 0 1px 2px rgba(0,0,0,.08),
    0 1px 2px rgba(0,0,0,.12);
}

/* Qty +/- */
.qty-btn{
  background: linear-gradient(#ffffff, #f4f4f4);
  border: 1px solid #d1d5db;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.7),
    inset 0 -1px 0 rgba(0,0,0,.03),
    0 2px 4px rgba(0,0,0,.12);
}
.qty-btn:hover{
  background: linear-gradient(#fff, #eeeeee);
}
.qty-btn:active{
  transform: translateY(1px);
  box-shadow:
    inset 0 1px 2px rgba(0,0,0,.08),
    0 1px 2px rgba(0,0,0,.12);
}

/* Checkout button – slightly deeper 3D */
.btn-cta.btn-checkout{
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.18),
    0 8px 18px rgba(11,122,83,.28);
}
.btn-cta.btn-checkout:active{
  transform: translateY(1px);
  box-shadow:
    inset 0 1px 2px rgba(0,0,0,.12),
    0 6px 14px rgba(11,122,83,.24);
}

/* === Make the cart count badges narrower === */

/* Header nav bubble (top-right of cart icon) */
.cart-badge{
  min-width: 16px;   /* was 18 */
  height: 16px;      /* was 18 */
  padding: 0 4px;    /* was 0 5px */
  font: 700 11px/16px var(--font-body, system-ui); /* slightly smaller */
}

/* Drawer header "Cart" count badge */
.cart-count-badge{
  min-width: 18px;   /* was 22 */
  height: 18px;      /* was 22 */
  padding: 0 5px;    /* was 0 6px */
  font: 700 11px/1 var(--font-body, system-ui);
}

/* === FORCE stylized buttons inside the cart drawer === */
aside.cart-drawer .btn-cta.btn-checkout{
  background: linear-gradient(180deg, #0b7a53, #096746) !important;
  color: #fff !important;
  border: 0 !important;
  border-radius: 12px !important;
  padding: 14px 18px !important;
  font-weight: 700 !important;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.18),
    0 8px 18px rgba(11,122,83,.28) !important;
}
aside.cart-drawer .btn-cta.btn-checkout:hover{
  transform: translateY(-1px);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.18),
    0 12px 24px rgba(11,122,83,.32) !important;
}

/* Style all small action buttons in the cart (qty, remove, close) */
aside.cart-drawer .qty-btn,
aside.cart-drawer .cart-items .btn-remove,
aside.cart-drawer header.cart-header > button.icon-btn[data-cart-close]{
  background: linear-gradient(#ffffff, #f4f4f4) !important;
  border: 1px solid #d1d5db !important;
  border-radius: 9999px !important;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.7),
    inset 0 -1px 0 rgba(0,0,0,.03),
    0 2px 4px rgba(0,0,0,.12) !important;
}
aside.cart-drawer .qty-btn:hover,
aside.cart-drawer .cart-items .btn-remove:hover,
aside.cart-drawer header.cart-header > button.icon-btn[data-cart-close]:hover{
  background: linear-gradient(#fff, #eeeeee) !important;
}

/* === Make the cart count badges narrower === */

/* Header nav bubble (top-right of cart icon) */
nav.main-nav .nav-cart .cart-badge{
  min-width: 16px !important;
  height: 16px !important;
  padding: 0 4px !important;
  font: 700 11px/16px var(--font-body, system-ui) !important;
}

/* Drawer header "Cart" count badge */
aside.cart-drawer .cart-header .cart-count-badge{
  min-width: 18px !important;
  height: 18px !important;
  padding: 0 5px !important;
  font: 700 11px/1 var(--font-body, system-ui) !important;
}

/* Optional: slightly tighter coupon Apply button to match look */
aside.cart-drawer .coupon .btn{
  border-radius: 12px !important;
  padding: 10px 14px !important;
}

/* === Compact pill-shaped quantity controls === */
aside.cart-drawer .qty{
  border-radius: 9999px !important;
  padding: 3px 6px !important;
  gap: 4px !important;
  background: #fbfbfb !important;
  border: 1px solid #e5e7eb !important;
}
aside.cart-drawer .qty-btn{
  width: 26px !important;
  height: 26px !important;
  border-radius: 9999px !important;
}
aside.cart-drawer .qty-input{
  width: 36px !important;
  font-size: .9rem !important;
  background: transparent !important;
  border: 0 !important;
  outline: none !important;
}

/* Make the line-item remove button a neat round icon */
aside.cart-drawer .cart-items .btn-remove{
  width: 28px !important;
  height: 28px !important;
  display: grid !important;
  place-items: center !important;
  border-radius: 9999px !important;
}
aside.cart-drawer .cart-items .btn-remove svg{
  width: 16px !important; height: 16px !important;
}


* Keep the green gradient ALWAYS (even when disabled) */
aside.cart-drawer .btn-cta.btn-checkout,
aside.cart-drawer [data-checkout]{
  background: linear-gradient(180deg, #0b7a53, #096746) !important;
  color: #fff !important;
  border: 0 !important;
  border-radius: 12px !important;
  padding: 14px 18px !important;
  font-weight: 700 !important;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.18),
    0 8px 18px rgba(11,122,83,.28) !important;
}

aside.cart-drawer .btn-cta.btn-checkout:hover,
aside.cart-drawer [data-checkout]:hover{
  transform: translateY(-1px);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.18),
    0 12px 24px rgba(11,122,83,.32) !important;
}

/* Softer disabled look: keep gradient, just fade it */
aside.cart-drawer .btn-cta.btn-checkout:disabled,
aside.cart-drawer [data-checkout]:disabled{
  opacity: .7 !important;
  filter: saturate(.9) brightness(.98);
  cursor: not-allowed !important;
}

/* Style the coupon Apply button too */
aside.cart-drawer .coupon .btn{
  border-radius: 12px !important;
  padding: 10px 14px !important;
  border: 0 !important;
  background: linear-gradient(180deg, #e5f4ee, #d7efe7) !important;
  color: #0b7a53 !important;
  font-weight: 700 !important;
}
aside.cart-drawer .coupon .btn:hover{
  filter: brightness(.98);
}

