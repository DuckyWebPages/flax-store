---
// FILE: src/layouts/BaseLayout.astro
/* Base layout with fixed header, global styles, and cart drawer */
---
<!doctype html>
<html lang="en">
  <head>
   <link rel="stylesheet" href="/src/styles/store.css" />
<link rel="stylesheet" href="/src/styles/global.css" />

    <meta charset="utf-8" />
    <title><slot name="title" />Flax Lignan Health</title>

    <!-- Preconnects improve font loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&family=Source+Sans+3:wght@600;700&display=swap" rel="stylesheet">

    <link rel="preload" as="image" href="/images/flh-logo-33.png?v=6" />
    <link rel="preload" as="image" href="/images/backgroundw.jpg" />

    <style>
      :root{
        --font-body:'Inter',system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;
        --font-head:'Source Sans 3','Inter',system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;
        --ink:#0f172a; --ink-muted:#64748b;
        --header-h: 88px;
        --accent: var(--accent, #0b7a53);
      }
      *{ box-sizing:border-box; }

      body {
        margin: 0;
        font-family: var(--font-body);
        color: var(--ink);
        background: #ffffff url("/images/backgroundw.jpg") center top / cover no-repeat fixed;
      }
      h1 { font-size: 2rem; margin: 0 0 1rem; }

      /* Fixed slim header */
      .site-header-wrap{
        position:fixed; top:0; left:0; right:0; z-index:9999;
        background:#ffffff; border-bottom:1px solid #e5e7eb;
        box-shadow:0 2px 6px rgba(0,0,0,.12);
        height:var(--header-h);
      }
      .site-header{
        max-width:1100px; margin:0 auto; height:var(--header-h);
        padding:0 16px; display:flex; align-items:center; justify-content:space-between;
      }

      /* Brand */
      .brand{ display:inline-flex; align-items:center; line-height:0; }
      .nav-logo{ height:64px; width:auto; display:block; }
      @media (min-width:1024px){ .nav-logo{ height:72px; } }

      nav.main-nav{ display:flex; gap:24px; align-items:center; }
      .nav-link{
        color:var(--ink); font-weight:600; text-decoration:none;
        padding:6px 8px; border-radius:6px;
      }
      .nav-link:hover{ background:#f3f4f6; }
      .nav-link[aria-current="page"]{ text-decoration:underline; }

      /* Page spacing under slim header */
      main,footer{ max-width:1100px; margin:0 auto; }
      main{ padding: calc(var(--header-h) + 16px) 16px 56px; }
      footer{
        padding:16px; color:var(--ink-muted);
        background:transparent; border-radius:0;
      }

      h1,h2,h3,h4,.site-title,.products-title{
        font-family:var(--font-head); letter-spacing:-.01em; line-height:1.15;
      }
      h1,.site-title,h2,.products-title{ font-weight:700; }
      h3,h4{ font-weight:600; }

      /* Global CTA */
      .btn-cta{
        background:#111827; color:#fff; border:0; border-radius:9999px;
        padding:10px 16px; min-width:160px; font-weight:700; line-height:1;
        display:inline-flex; align-items:center; justify-content:center;
        text-decoration:none; box-shadow:0 6px 18px rgba(0,0,0,.18);
        cursor:pointer; transition:transform .08s ease, opacity .15s ease;
      }
      .btn-cta:hover{ opacity:.92; transform:translateY(-1px); }
      .btn-cta:focus-visible{ outline:2px solid #111827; outline-offset:2px; }

      /* Cart Drawer (overlay + container + panel) */
      .cart-overlay {
        position: fixed; inset: 0; background: rgba(0,0,0,.35); backdrop-filter: blur(2px);
        opacity: 0; pointer-events: none; transition: opacity .25s ease; z-index: 60;
      }
      .cart-overlay.is-open { opacity: 1; pointer-events: auto; }

      .cart-drawer { position: fixed; inset: 0; z-index: 70; pointer-events: none; }
      .cart-panel {
        position: absolute; top: 0; right: 0; height: 100%; width: min(420px, 92vw);
        background: #fff; box-shadow: -8px 0 24px rgba(0,0,0,.15);
        display: grid; grid-template-rows: auto 1fr auto; gap: 12px;
        transform: translateX(105%); /* closed by default */
        transition: transform .28s cubic-bezier(.2,.8,.2,1);
        pointer-events: auto;
      }
      .cart-drawer.is-open .cart-panel { transform: translateX(0); }

      .cart-header {
        display: flex; align-items: center; justify-content: space-between;
        padding: 16px 18px; border-bottom: 1px solid #eee;
        background: linear-gradient(180deg, #fff, #fafafa);
      }
      .cart-header h3 { font-size: 1.1rem; letter-spacing: .02em; margin:0; display:flex; gap:8px; align-items:center; }

      .ship-progress { padding: 10px 18px; }
      .ship-bar { height: 8px; background: #f1f1f1; border-radius: 999px; overflow: hidden; }
      .ship-bar span { display: block; height: 100%; width: 0%; background: #111; transform-origin: left; transition: width .35s ease; }
      .ship-note { margin-top: 6px; font-size: .9rem; color: #444; }

      /* Items list + rows */
      .cart-items { list-style: none; margin: 0; padding: 14px; display:grid; gap:12px; overflow:auto; }
      .cart-item {
        display:grid; grid-template-columns:68px 1fr; gap:12px; align-items:center;
        border: 1px solid #ececec; border-radius: 14px; padding: 12px; background: #fff;
        box-shadow: 0 6px 18px rgba(0,0,0,.05); transition: box-shadow .15s ease, transform .06s ease;
      }
      .cart-item:hover { box-shadow: 0 10px 24px rgba(0,0,0,.07); }
      .ci-thumb { width:64px; height:64px; border-radius:10px; object-fit:cover; background:#f6f6f6; display:block; }
      .ci-main { display: grid; gap: 8px; }
      .ci-row { display:flex; align-items:center; justify-content:space-between; gap:12px; }
      .ci-title { font-size: 1rem; margin: 0; font-weight: 700; }
      .ci-price { font-weight: 700; font-size: 1rem; }

      /* Qty / remove buttons */
      .qty { display:inline-flex; align-items:center; gap:6px; padding:4px 6px; border:1px solid #e5e7eb; border-radius:9999px; background:#fbfbfb; box-shadow:inset 0 1px 0 rgba(255,255,255,.6); }
      .qty-btn { width:28px; height:28px; border:1px solid #d1d5db; border-radius:9999px; background:linear-gradient(#ffffff, #f4f4f4); box-shadow: inset 0 1px 0 rgba(255,255,255,.7), inset 0 -1px 0 rgba(0,0,0,.03), 0 2px 4px rgba(0,0,0,.12); cursor:pointer; font-weight:700; transition:transform .05s ease, background .12s ease, box-shadow .12s ease; }
      .qty-btn:hover { background:linear-gradient(#fff, #eeeeee); }
      .qty-btn:active { transform: translateY(1px); }
      .qty-input { width:38px; text-align:center; border:0; outline:none; background:transparent; font-size:.95rem; padding:0; }

      .btn-remove,
      .icon-btn{
        width:30px; height:30px; display:grid; place-items:center;
        border-radius:9999px; border:1px solid #d1d5db;
        background:linear-gradient(#ffffff, #f4f4f4);
        box-shadow: inset 0 1px 0 rgba(255,255,255,.7), inset 0 -1px 0 rgba(0,0,0,.03), 0 2px 4px rgba(0,0,0,.12);
        transition:transform .06s ease, box-shadow .15s ease, background .15s ease;
        color:#111;
        cursor:pointer;
      }
      .btn-remove:hover, .icon-btn:hover { background:linear-gradient(#fff, #eeeeee); }
      .btn-remove:active, .icon-btn:active { transform:translateY(1px); }
      .btn-remove svg, .icon-btn svg { width:16px; height:16px; display:block; stroke:currentColor; fill:none; stroke-width:2; stroke-linecap:round; }

      /* Footer + checkout */
      .cart-footer { padding: 12px 18px 18px; border-top: 1px solid #eee; background: #fff; position: sticky; bottom: 0; }
      .tot-row { display:flex; align-items:center; justify-content:space-between; margin:8px 0; }
      .tot-row.small { font-size: .9rem; color: #555; }
      .coupon { display:grid; grid-template-columns: 1fr auto; gap: 8px; margin: 12px 0; }
      .coupon .btn { padding: 10px 14px; border-radius: 12px; border: 0; background: linear-gradient(180deg, #e5f4ee, #d7efe7); color: #0b7a53; font-weight:700; cursor:pointer; }
      .btn-cta.btn-checkout {
        width: 100%; margin-top: 6px; padding: 14px 18px;
        background: linear-gradient(180deg, #0b7a53, #096746) !important; color: #fff !important;
        border: 0 !important; border-radius: 12px !important; font-weight: 700;
        box-shadow: inset 0 1px 0 rgba(255,255,255,.18), 0 8px 18px rgba(11,122,83,.28);
      }
      .btn-cta.btn-checkout:hover { transform: translateY(-1px); box-shadow: inset 0 1px 0 rgba(255,255,255,.18), 0 12px 24px rgba(11,122,83,.32); }
      .btn-cta.btn-checkout:disabled { opacity:.7; filter: saturate(.9) brightness(.98); cursor: not-allowed; }

      /* Cart badges */
      .nav-cart { position: relative; }
      .cart-badge {
        position: absolute; top: -6px; right: -6px; min-width: 16px; height: 16px; padding: 0 4px;
        display: inline-flex; align-items: center; justify-content: center;
        font: 700 11px/16px var(--font-body, system-ui); color: #fff; background: #0b7a53; border-radius: 999px;
        box-shadow: 0 2px 6px rgba(0,0,0,.2);
      }
      .cart-badge[hidden] { display: none !important; }
      .cart-count-badge { min-width: 18px; height: 18px; padding: 0 5px; display:inline-flex; align-items:center; justify-content:center; font:700 11px/1 var(--font-body); color:#fff; background:#0b7a53; border-radius:999px; box-shadow:0 2px 8px rgba(11,122,83,.25); }

      @media (max-width:480px){
        .cart-item{ grid-template-columns:56px 1fr; }
        .ci-thumb{ width:56px; height:56px; }
      }
      /* Force the cart icon to stay tiny, even if globals say img { width:100% } */
.main-nav .nav-cart .cart-icon{
  width: 22px !important;
  height: 22px !important;
  aspect-ratio: 1 / 1;
  object-fit: contain;
  display: block;
}
.main-nav .nav-cart{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6px 8px;
  line-height: 0;
}
.main-nav .nav-cart .cart-icon{
  width: 22px !important;
  height: 22px !important;
  aspect-ratio: 1 / 1;
  object-fit: contain;
  display: block;
}
.main-nav .nav-cart{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6px 8px;
  line-height: 0;
}

    </style>
  </head>

  <body>
    <div class="site-header-wrap">
      <div class="site-header">
        <!-- Logo left -->
        <a href="/" class="brand" aria-label="Flax Lignan Health home">
          <img
            src="/images/flh-logo-33.png?v=6"
            alt="Flax Lignan Health"
            class="nav-logo"
            decoding="async"
            loading="eager"
            fetchpriority="high"
          />
        </a>

        <!-- Links right -->
        <nav class="main-nav" aria-label="Main">
          <a href="/" class="nav-link" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Home</a>
          <a href="/products" class="nav-link" aria-current={Astro.url.pathname.startsWith('/products') ? 'page' : undefined}>Products</a>
          <a href="/blog/" class="nav-link" aria-current={Astro.url.pathname.startsWith('/blog') ? 'page' : undefined}>Blog</a>
          <a href="/contact" class="nav-link" aria-current={Astro.url.pathname === '/contact' ? 'page' : undefined}>Contact Us</a>

          <!-- Cart icon -->
          <button class="nav-link nav-cart" data-cart-open aria-label="Open cart">
            <img src="/images/shoppingcart.jpg" alt="" class="cart-icon" width="22" height="22" loading="lazy" decoding="async" />
            <span class="cart-badge" data-cart-count-nav hidden>0</span>
            <span class="sr-only">Cart</span>
          </button>
        </nav>
      </div>
    </div>

    <main><slot /></main>

    <footer>© {new Date().getFullYear()} Flax Lignan Health</footer>

    <!-- =======================
         Cart Drawer
         ======================= -->
    <div class="cart-overlay" data-cart-overlay hidden></div>
    <aside class="cart-drawer" data-cart-drawer hidden aria-hidden="true" aria-label="Shopping cart">
      <div class="cart-panel">
        <header class="cart-header">
          <h3>Cart <span class="cart-count-badge" data-cart-count>0</span></h3>
          <button class="icon-btn" data-cart-close aria-label="Close cart">
            <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M18 6 6 18M6 6l12 12" fill="none" stroke="currentColor" stroke-width="2"/>
            </svg>
          </button>
        </header>

        <!-- Line items -->
        <ul class="cart-items" data-cart-items></ul>

        <!-- Footer totals -->
        <footer class="cart-footer">
          <div class="tot-row"><span>Subtotal</span><strong data-subtotal>$0.00</strong></div>
          <div class="tot-row small">Taxes & shipping calculated at checkout.</div>

          <div class="coupon">
            <input type="text" placeholder="Promo code" data-coupon />
            <button class="btn" data-apply-coupon>Apply</button>
          </div>

          <button class="btn-cta btn-checkout" data-checkout disabled>Checkout</button>
          <div class="trust">…</div>
        </footer>
      </div>
    </aside>

    <!-- Toast -->
    <div class="cart-toast" data-cart-toast hidden>Added to cart</div>

    <!-- Cart store + drawer wiring -->
    <script is:inline>
    (function () {
      var KEY = "flax_cart_v1";

      function read(){ try{ return JSON.parse(localStorage.getItem(KEY) || "[]"); } catch(e){ return []; } }
      function write(items){ localStorage.setItem(KEY, JSON.stringify(items)); }
      function fmt(c){ return (c/100).toLocaleString("en-US",{style:"currency",currency:"USD"}); }

      var Cart = {
        all: function(){ return read(); },
        count: function(){ return read().reduce(function(n,i){ return n + i.qty; }, 0); },
        totalCents: function(){ return read().reduce(function(n,i){ return n + i.qty * i.unitCents; }, 0); },
        add: function(item, qty){
          qty = Number(qty || 1);
          var items = read();
          var idx = items.findIndex(function(x){ return x.id === item.id; });
          if (idx >= 0) items[idx].qty += qty;
          else items.push({ id:item.id, name:item.name, unitCents:item.unitCents, image:item.image || "", qty:qty });
          write(items);
          window.dispatchEvent(new CustomEvent("cart:updated"));
        },
        setQty: function(id, qty){
          qty = Number(qty || 0);
          var items = read().map(function(i){ return i.id === id ? Object.assign({}, i, { qty: qty }) : i; })
                            .filter(function(i){ return i.qty > 0; });
          write(items);
          window.dispatchEvent(new CustomEvent("cart:updated"));
        },
        remove: function(id){
          write(read().filter(function(i){ return i.id !== id; }));
          window.dispatchEvent(new CustomEvent("cart:updated"));
        },
        clear: function(){
          write([]);
          window.dispatchEvent(new CustomEvent("cart:updated"));
        }
      };
      window.Cart = Cart; // for console debugging

      // Elements
      var drawer  = document.querySelector("[data-cart-drawer]");
      var overlay = document.querySelector("[data-cart-overlay]");
      var listEl  = document.querySelector("[data-cart-items]");
      var subEl   = document.querySelector("[data-subtotal]");
      var drawerBadge = document.querySelector("[data-cart-count]");
      var navBadge    = document.querySelector("[data-cart-count-nav]");
      var checkoutBtn = document.querySelector("[data-checkout]");

      function openDrawer(){
        if (!drawer || !overlay) return;
        drawer.classList.add("is-open");
        overlay.classList.add("is-open");
        drawer.hidden = false; overlay.hidden = false;
        drawer.setAttribute("aria-hidden","false");
      }
      function closeDrawer(){
        if (!drawer || !overlay) return;
        drawer.classList.remove("is-open");
        overlay.classList.remove("is-open");
        drawer.hidden = true; overlay.hidden = true;
        drawer.setAttribute("aria-hidden","true");
      }

      function render(){
        var items = Cart.all();

        // Items
        if (listEl) {
          if (!items.length) {
            listEl.innerHTML = '<li class="cart-item" style="border:0;padding:18px;">Your cart is empty.</li>';
          } else {
            listEl.innerHTML = items.map(function(i){
              return ''+
              '<li class="cart-item" data-id="'+i.id+'">'+
                (i.image ? '<img class="ci-thumb" src="'+i.image+'" alt="" loading="lazy" decoding="async">' : '<span class="ci-thumb" aria-hidden="true"></span>')+
                '<div class="ci-main">'+
                  '<div class="ci-row">'+
                    '<p class="ci-title">'+i.name+'</p>'+
                    '<button class="btn-remove" data-remove="'+i.id+'" aria-label="Remove item">'+
                      '<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>'+
                    '</button>'+
                  '</div>'+
                  '<div class="ci-row">'+
                    '<div class="qty" aria-label="Quantity">'+
                      '<button class="qty-btn" data-dec="'+i.id+'" aria-label="Decrease">–</button>'+
                      '<input class="qty-input" value="'+i.qty+'" inputmode="numeric" data-qty="'+i.id+'">'+
                      '<button class="qty-btn" data-inc="'+i.id+'" aria-label="Increase">+</button>'+
                    '</div>'+
                    '<div class="ci-price">'+fmt(i.unitCents * i.qty)+'</div>'+
                  '</div>'+
                '</div>'+
              '</li>';
            }).join("");
          }
        }

        // Totals
        if (subEl) subEl.textContent = fmt(Cart.totalCents());

        // Counts/badges
        var count = Cart.count();
        if (drawerBadge) drawerBadge.textContent = String(count);
        if (navBadge) {
          if (count > 0) { navBadge.textContent = String(count); navBadge.removeAttribute("hidden"); }
          else { navBadge.setAttribute("hidden",""); }
        }

        // Checkout enable/disable
        if (checkoutBtn) checkoutBtn.disabled = count === 0;
      }

      // Initial paint
      render();

      // Re-render & open when cart updates
      window.addEventListener("cart:updated", function(){ render(); openDrawer(); });

      // Global click handling (open/close, qty, remove, add-to-cart)
      document.addEventListener("click", function(e){
        var el = e.target instanceof Element ? e.target : null;
        if (!el) return;

        if (el.closest("[data-cart-open]")) { openDrawer(); return; }
        if (el.closest("[data-cart-close]") || el.closest("[data-cart-overlay]")) { closeDrawer(); return; }

        // Qty +
        var inc = el.closest("[data-inc]"); if (inc) {
          var idI = inc.getAttribute("data-inc");
          var currI = (Cart.all().find(function(i){ return i.id===idI; }) || { qty:1 }).qty;
          Cart.setQty(idI, currI + 1); return;
        }
        // Qty –
        var dec = el.closest("[data-dec]"); if (dec) {
          var idD = dec.getAttribute("data-dec");
          var currD = (Cart.all().find(function(i){ return i.id===idD; }) || { qty:1 }).qty;
          Cart.setQty(idD, Math.max(0, currD - 1)); return;
        }
        // Remove
        var rm = el.closest("[data-remove]"); if (rm) {
          var idR = rm.getAttribute("data-remove");
          Cart.remove(idR); return;
        }

        // Add-to-cart (works for any element with .add-to-cart)
        var btn = el.closest(".add-to-cart");
        if (!btn) return;

        e.preventDefault();

        var sku   = btn.getAttribute("data-sku") || "";
        var name  = btn.getAttribute("data-name") || sku || "Item";
        var cents = parseInt(btn.getAttribute("data-price") || "0", 10);   // cents
        var qty   = parseInt(btn.getAttribute("data-qty")   || "1", 10);
        var image = btn.getAttribute("data-image") || ""; // optional

        if (!sku || !Number.isFinite(cents) || !Number.isFinite(qty)) {
          console.warn("[Cart] Missing data on Add to Cart:", { sku, cents, qty });
          alert("Sorry, this item is missing product info.");
          return;
        }

        Cart.add({ id: sku, name: name, unitCents: cents, image: image }, qty);

        // Toast + open drawer
        var toast = document.querySelector("[data-cart-toast]");
        if (toast) {
          toast.removeAttribute("hidden");
          toast.classList.add("show");
          setTimeout(function(){ toast.classList.remove("show"); toast.setAttribute("hidden",""); }, 1200);
        }
        openDrawer();
      });

      // ESC closes drawer
      window.addEventListener("keydown", function (e) {
        if (e.key === "Escape") closeDrawer();
      });

      // Checkout handler (wire to your API when ready)
      if (checkoutBtn) {
        checkoutBtn.addEventListener("click", async function () {
          var items = Cart.all();
          if (!items.length) { alert("Your cart is empty."); return; }

          // Send minimal payload (id + qty). Expand as needed.
          var skinny = items.map(function (i) { return { id: i.id, qty: i.qty }; });

          checkoutBtn.disabled = true;
          try {
            var res = await fetch("/api/create-checkout-session", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ items: skinny })
            });
            var data = await res.json();
            if (data && data.url) { window.location.href = data.url; }
            else { alert("Checkout failed."); }
          } catch (err) {
            console.error(err);
            alert("Checkout error.");
          } finally {
            checkoutBtn.disabled = false;
          }
        });
      }
    })();
    </script>
  </body>
</html>
