---
// FILE: src/layouts/BaseLayout.astro
/* Base layout with fixed header, global styles, and cart drawer */
---
<!doctype html>
<html lang="en">
  <head>
  <meta charset="utf-8" />
  <title><slot name="title" />Flax Lignan Health</title>

  <!-- Preconnects improve font loading -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&family=Source+Sans+3:wght@600;700&display=swap" rel="stylesheet">

  <link rel="preload" as="image" href="/images/flh-logo-33.png?v=6" />
  <link rel="preload" as="image" href="/images/backgroundw.jpg" />



    <style>
      :root{
        --font-body:'Inter',system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;
        --font-head:'Source Sans 3','Inter',system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;
        --ink:#0f172a; --ink-muted:#64748b;
        --header-h: 88px;
      }
      *{ box-sizing:border-box; }

     body {
  margin: 0;
  font-family: var(--font-body);
  color: var(--ink);
  background: #ffffff url("/images/backgroundw.jpg") center top / cover no-repeat fixed;
}
h1 {
  font-size: 2rem;    /* or whatever size you want */
  margin: 0 0 1rem;   /* top=0, bottom=1rem */
}


      /* Fixed slim header */
      .site-header-wrap{
        position:fixed; top:0; left:0; right:0; z-index:9999;
        background:#ffffff; border-bottom:1px solid #e5e7eb;
        box-shadow:0 2px 6px rgba(0,0,0,.12);
        height:var(--header-h);
      }
      .site-header{
        max-width:1100px; margin:0 auto; height:var(--header-h);
        padding:0 16px; display:flex; align-items:center; justify-content:space-between;
      }

      /* Brand */
      .brand{ display:inline-flex; align-items:center; line-height:0; }
      .nav-logo{ height:64px; width:auto; display:block; }
      @media (min-width:1024px){ .nav-logo{ height:72px; } }

      nav.main-nav{ display:flex; gap:24px; align-items:center; }
      .nav-link{
        color:var(--ink); font-weight:600; text-decoration:none;
        padding:6px 8px; border-radius:6px;
      }
      .nav-link:hover{ background:#f3f4f6; }
      .nav-link[aria-current="page"]{ text-decoration:underline; }

      /* Page spacing under slim header */
      main,footer{ max-width:1100px; margin:0 auto; }
      main{ padding: calc(var(--header-h) + 16px) 16px 56px; }
      footer{
        padding:16px; color:var(--ink-muted);
        background:transparent; border-radius:0; /* no white box */
      }

      h1,h2,h3,h4,.site-title,.products-title{
        font-family:var(--font-head); letter-spacing:-.01em; line-height:1.15;
      }
      h1,.site-title,h2,.products-title{ font-weight:700; }
      h3,h4{ font-weight:600; }

      /* Global CTA */
      .btn-cta{
        background:#111827; color:#fff; border:0; border-radius:9999px;
        padding:10px 16px; min-width:160px; font-weight:700; line-height:1;
        display:inline-flex; align-items:center; justify-content:center;
        text-decoration:none; box-shadow:0 6px 18px rgba(0,0,0,.18);
        cursor:pointer; transition:transform .08s ease, opacity .15s ease;
      }
      .btn-cta:hover{ opacity:.92; transform:translateY(-1px); }
      .btn-cta:focus-visible{ outline:2px solid #111827; outline-offset:2px; }

      /* Cart Drawer */
      .cart-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.35); backdrop-filter: blur(2px);
        opacity: 0; pointer-events: none; transition: opacity .25s ease; z-index: 60; }
      .cart-overlay.is-open { opacity: 1; pointer-events: auto; }

      .cart-drawer { position: fixed; inset: 0; z-index: 70; pointer-events: none; }
      .cart-panel {
        position: absolute; top: 0; right: 0; height: 100%; width: min(420px, 92vw);
        background: #fff; box-shadow: -8px 0 24px rgba(0,0,0,.15);
        display: grid; grid-template-rows: auto auto 1fr auto; gap: 12px;
        transform: translateX(105%); transition: transform .28s cubic-bezier(.2,.8,.2,1);
        pointer-events: auto;
      }
      .cart-drawer.is-open .cart-panel { transform: translateX(0); }

      .cart-header { display: flex; align-items: center; justify-content: space-between; padding: 16px 18px; border-bottom: 1px solid #eee; }
      .cart-header h3 { font-size: 1.1rem; letter-spacing: .02em; }

      .ship-progress { padding: 10px 18px; }
      .ship-bar { height: 8px; background: #f1f1f1; border-radius: 999px; overflow: hidden; }
      .ship-bar span { display: block; height: 100%; width: 0%; background: #111; transform-origin: left; transition: width .35s ease; }
      .ship-note { margin-top: 6px; font-size: .9rem; color: #444; }

      .cart-items { list-style: none; margin: 0; padding: 8px 12px 0 12px; overflow: auto; }
    /* One column; no thumbnail */
.cart-item { display: grid; grid-template-columns: 1fr; gap: 12px; padding: 12px; border-bottom: 1px solid #f1f1f1; }
/* (Optional) remove if present */
.ci-thumb { display: none; }

      .ci-main { display: grid; gap: 8px; }
      .ci-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
      .ci-title { font-size: .98rem; margin: 0; }
      .icon-btn { background: none; border: none; padding: 6px; border-radius: 8px; cursor: pointer; color: #666; }
      .icon-btn:hover { background: #f5f5f5; color: #000; }

      .qty { display: inline-flex; align-items: center; gap: 6px; border: 1px solid #e6e6e6; border-radius: 10px; padding: 4px; }
      .qty-btn { width: 28px; height: 28px; border: none; background: #f4f4f4; border-radius: 8px; cursor: pointer; }
      .qty-btn:active { transform: translateY(1px); }
      .qty-input { width: 42px; text-align: center; border: none; outline: none; font-size: .95rem; }
      .ci-price { font-weight: 600; }

      .upsell { padding: 10px 18px 0; }
      .upsell-card { display: grid; grid-template-columns: 64px 1fr; gap: 12px; align-items: center; padding: 10px; border: 1px solid #eee; border-radius: 14px; }
      .upsell-card img { width: 64px; height: 64px; object-fit: cover; border-radius: 10px; }

      .cart-footer { padding: 12px 18px 18px; border-top: 1px solid #eee; position: sticky; bottom: 0; background: #fff; }
      .tot-row { display: flex; align-items: center; justify-content: space-between; margin: 8px 0; }
      .tot-row.small { font-size: .9rem; color: #555; }
      .coupon { display: grid; grid-template-columns: 1fr auto; gap: 8px; margin: 12px 0; }
      .coupon .btn { padding: 10px 14px; border-radius: 12px; border: 1px solid #ddd; background: #f9f9f9; cursor: pointer; }
      .btn-cta.btn-checkout { width: 100%; margin-top: 6px; padding: 14px 18px; }

      .trust { display: flex; gap: 12px; align-items: center; margin-top: 10px; font-size: .9rem; color: #444; }
      .trust .lock { display: inline-flex; gap: 6px; align-items: center; }

      .cart-toast {
        position: fixed; left: 50%; top: 20px; transform: translateX(-50%) translateY(-16px);
        background: #111; color: #fff; padding: 10px 14px; border-radius: 999px; box-shadow: 0 8px 24px rgba(0,0,0,.2);
        opacity: 0; pointer-events: none; transition: transform .25s ease, opacity .25s ease; z-index: 80;
      }
      .cart-toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

      /* Cart icon in nav */
      .cart-icon{ width:22px; height:22px; object-fit:contain; display:block; }
      .sr-only{
        position:absolute !important; width:1px; height:1px; padding:0; margin:-1px;
        overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0;
      }
    </style>
  </head>

  <body>
    <div class="site-header-wrap">
      <div class="site-header">
        <!-- Logo left -->
        <a href="/" class="brand" aria-label="Flax Lignan Health home">
          <img
            src="/images/flh-logo-33.png?v=6"
            alt="Flax Lignan Health"
            class="nav-logo"
            decoding="async"
            loading="eager"
            fetchpriority="high"
          />
        </a>

        <!-- Links right -->
        <nav class="main-nav" aria-label="Main">
          <a href="/" class="nav-link" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Home</a>
          <a href="/products" class="nav-link" aria-current={Astro.url.pathname.startsWith('/products') ? 'page' : undefined}>Products</a>
          <a href="/blog/" class="nav-link" aria-current={Astro.url.pathname.startsWith('/blog') ? 'page' : undefined}>Blog</a>
          <a href="/contact" class="nav-link" aria-current={Astro.url.pathname === '/contact' ? 'page' : undefined}>Contact Us</a>

          <!-- Cart icon -->
          <button class="nav-link nav-cart" data-cart-open aria-label="Open cart">
            <img src="/images/shoppingcart.jpg" alt="" class="cart-icon" />
            <span class="sr-only">Cart</span>
          </button>
        </nav>
      </div>
    </div>

    <main><slot /></main>

    <footer>© {new Date().getFullYear()} Flax Lignan Health</footer>

    <!-- =======================
     Cart Drawer
     ======================= -->
<div class="cart-overlay" data-cart-overlay hidden></div>
<aside class="cart-drawer" data-cart-drawer hidden aria-hidden="true" aria-label="Shopping cart">
  <div class="cart-panel">
    <header class="cart-header">
      <h3>Cart</h3>
      <button class="icon-btn" data-cart-close aria-label="Close cart">
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12" fill="none" stroke="currentColor" stroke-width="2"/>
        </svg>
      </button>
    </header>

    

    <!-- Line items -->
    <ul class="cart-items" data-cart-items></ul>

    <!-- Upsell (corrected bundle price) -->
    <div class="upsell">
      <div class="upsell-card">
        <img src="/images/flax-hull-bundle-small.jpg" alt="Flax Hull Lignan Bundle" />
        <div>
          <p class="u-title">Bundle & Save 10%</p>
          <button class="btn-cta add-to-cart"
            data-sku="fhl-bundle"
            data-name="Flax Hull Lignan Bundle (3 Jars)"
            data-price="11250"
            data-image="/images/flax-hull-bundle-small.jpg"
            data-qty="1">Add Bundle</button>
        </div>
      </div>
    </div>

    <!-- Footer totals -->
    <footer class="cart-footer">
      <div class="tot-row"><span>Subtotal</span><strong data-subtotal>$0.00</strong></div>
      <div class="tot-row small">Taxes & shipping calculated at checkout.</div>
      <div class="coupon">
        <input type="text" placeholder="Promo code" data-coupon />
        <button class="btn" data-apply-coupon>Apply</button>
      </div>
      <button class="btn-cta btn-checkout" data-checkout>Checkout</button>
      <div class="trust">
        <span class="lock">
          <svg width="16" height="16" viewBox="0 0 24 24">
            <path d="M6 10h12v10H6zM8 10V7a4 4 0 1 1 8 0v3" fill="none" stroke="currentColor" stroke-width="2"/>
          </svg>
          Secure checkout
        </span>
      </div>
    </footer>
  </div>
</aside>
<!-- Toast -->
<div class="cart-toast" data-cart-toast hidden>Added to cart</div>

<!-- Cart + Drawer + Renderer (single block, no imports) -->
<script is:inline>
(function () {
  // ===== Inline Cart (no imports) =====
  var KEY = "flax_cart_v1";
  function read(){ try{ return JSON.parse(localStorage.getItem(KEY) || "[]"); } catch(e){ return []; } }
  function write(items){ localStorage.setItem(KEY, JSON.stringify(items)); }

  var Cart = {
    all: function(){ return read(); },
    count: function(){ return read().reduce(function(n,i){ return n + i.qty; }, 0); },
    totalCents: function(){ return read().reduce(function(n,i){ return n + i.qty * i.unitCents; }, 0); },
    add: function(item, qty){
      qty = Number(qty || 1);
      var items = read();
      var idx = items.findIndex(function(x){ return x.id === item.id; });
      if (idx >= 0) items[idx].qty += qty;
      else items.push({ id:item.id, name:item.name, unitCents:item.unitCents, image:item.image, qty:qty });
      write(items);
      window.dispatchEvent(new CustomEvent("cart:updated"));
    },
    setQty: function(id, qty){
      qty = Number(qty || 0);
      var items = read().map(function(i){ return i.id === id ? Object.assign({}, i, { qty: qty }) : i; })
                        .filter(function(i){ return i.qty > 0; });
      write(items);
      window.dispatchEvent(new CustomEvent("cart:updated"));
    },
    remove: function(id){
      write(read().filter(function(i){ return i.id !== id; }));
      window.dispatchEvent(new CustomEvent("cart:updated"));
    },
    clear: function(){
      write([]);
      window.dispatchEvent(new CustomEvent("cart:updated"));
    }
  };
  window.Cart = Cart; // expose for Console

  // ===== Drawer elements =====
  var drawer  = document.querySelector("[data-cart-drawer]");
  var overlay = document.querySelector("[data-cart-overlay]");
  var listEl  = document.querySelector("[data-cart-items]");
  var subEl   = document.querySelector("[data-subtotal]");

  function openDrawer(){
    if (!drawer || !overlay) return;
    drawer.classList.add("is-open");
    overlay.classList.add("is-open");
    drawer.hidden = false; overlay.hidden = false;
    drawer.setAttribute("aria-hidden","false");
  }
  function closeDrawer(){
    if (!drawer || !overlay) return;
    drawer.classList.remove("is-open");
    overlay.classList.remove("is-open");
    drawer.hidden = true; overlay.hidden = true;
    drawer.setAttribute("aria-hidden","true");
  }

  function fmt(cents){ return (cents/100).toLocaleString("en-US",{style:"currency",currency:"USD"}); }

  function render(){
    var items = Cart.all();

    if (listEl) {
      if (!items.length) {
        listEl.innerHTML = '<li class="cart-item" style="border:0;padding:18px;">Your cart is empty.</li>';
      } else {
        listEl.innerHTML = items.map(function(i){
          return ''+
          '<li class="cart-item" data-id="'+i.id+'">'+
            '<div class="ci-main">'+
              '<div class="ci-row">'+
                '<p class="ci-title">'+i.name+'</p>'+
                '<button class="icon-btn" data-remove="'+i.id+'" aria-label="Remove">'+
                  '<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">'+
                    '<path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2"/>'+
                  '</svg>'+
                '</button>'+
              '</div>'+
              '<div class="ci-row">'+
                '<div class="qty" aria-label="Quantity">'+
                  '<button class="qty-btn" data-dec="'+i.id+'" aria-label="Decrease">–</button>'+
                  '<input class="qty-input" value="'+i.qty+'" inputmode="numeric" data-qty="'+i.id+'">'+
                  '<button class="qty-btn" data-inc="'+i.id+'" aria-label="Increase">+</button>'+
                '</div>'+
                '<div class="ci-price">'+fmt(i.unitCents * i.qty)+'</div>'+
              '</div>'+
            '</div>'+
          '</li>';
        }).join("");
      }
    }
    if (subEl) subEl.textContent = fmt(Cart.totalCents());
  }

  // Initial paint
  render();

  // Open & render on cart change
  window.addEventListener("cart:updated", function(){ render(); openDrawer(); });

  // Click handling (open/close, qty, remove, add-to-cart)
  document.addEventListener("click", function(e){
    var el = e.target instanceof Element ? e.target : null;
    if (!el) return;

    if (el.closest("[data-cart-open]")) { openDrawer(); return; }
    if (el.closest("[data-cart-close]") || el.closest("[data-cart-overlay]")) { closeDrawer(); return; }

    // Qty +
    var inc = el.closest("[data-inc]"); if (inc) {
      var idI = inc.getAttribute("data-inc");
      var currI = (Cart.all().find(function(i){ return i.id===idI; }) || { qty:1 }).qty;
      Cart.setQty(idI, currI + 1); return;
    }
    // Qty –
    var dec = el.closest("[data-dec]"); if (dec) {
      var idD = dec.getAttribute("data-dec");
      var currD = (Cart.all().find(function(i){ return i.id===idD; }) || { qty:1 }).qty;
      Cart.setQty(idD, Math.max(0, currD - 1)); return;
    }
    // Remove
    var rm = el.closest("[data-remove]"); if (rm) {
      var idR = rm.getAttribute("data-remove");
      Cart.remove(idR); return;
    }

    // Add-to-cart
    var btn = el.closest(".add-to-cart");
    if (!btn) return;

    var sku   = btn.getAttribute("data-sku") || "";
    var name  = btn.getAttribute("data-name") || sku;
    var cents = Number(btn.getAttribute("data-price") || "0");
    var image = btn.getAttribute("data-image") || "";
    var qty   = Number(btn.getAttribute("data-qty") || "1");

    if (!sku || !Number.isFinite(cents) || !Number.isFinite(qty)) {
      console.warn("[Cart] Bad button data", { sku:sku, cents:cents, qty:qty });
      return;
    }

    Cart.add({ id: sku, name: name, unitCents: cents, image: image }, qty);

    // Toast + open drawer
    var toast = document.querySelector("[data-cart-toast]");
    if (toast) {
      toast.removeAttribute("hidden");
      toast.classList.add("show");
      setTimeout(function(){ toast.classList.remove("show"); toast.setAttribute("hidden",""); }, 1200);
    }
    openDrawer();
  });

  // ESC closes drawer
  window.addEventListener("keydown", function(e){ if (e.key === "Escape") closeDrawer(); });
  // --- Checkout handler (temporary) ---
  var checkoutBtn = document.querySelector("[data-checkout]");
  if (checkoutBtn) {
    checkoutBtn.addEventListener("click", function () {
      var items = Cart.all();
      if (!items.length) {
        alert("Your cart is empty.");
        return;
      }
      // TEMP: navigate to a local /checkout page with items in the URL.
      // We'll replace this with real Stripe/PayPal later.
      var payload = encodeURIComponent(JSON.stringify(items.map(function(i){
        return { id: i.id, qty: i.qty };
      })));
      window.location.href = "/checkout?items=" + payload;
    });
  }

})();
</script>
