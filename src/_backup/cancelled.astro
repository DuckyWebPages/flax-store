---
import BaseLayout from "@/layouts/BaseLayout.astro";
---
<BaseLayout>
  <main style="max-width:680px;margin:40px auto;padding:0 16px;text-align:center;">
    <h1>Redirecting…</h1>
    <p>If you are not redirected, <a href="/cartcancel">click here</a>.</p>
  </main>
  <script>
    if (typeof window !== "undefined") {
      window.location.replace("/cartcancel");
    }
  </script>
</BaseLayout>
