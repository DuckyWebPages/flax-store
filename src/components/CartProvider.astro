// src/components/CartProvider.tsx
import React from "react";

export type CartItem = {
  id: string;           // cart SKU, e.g. "fhl-single"
  name: string;
  unitCents: number;
  image?: string;
};

type StoredItem = CartItem & { qty: number };

type Ctx = {
  items: StoredItem[];
  totalCents: number;
  add: (item: CartItem, qty?: number) => void;
  setQty: (id: string, qty: number) => void;
  remove: (id: string) => void;
  clear: () => void;
  open: boolean;
  setOpen: (v: boolean) => void;
};

const KEY = "flax_cart_v1";

function read(): StoredItem[] {
  try { return JSON.parse(localStorage.getItem(KEY) || "[]"); } catch { return []; }
}
function write(items: StoredItem[]) {
  localStorage.setItem(KEY, JSON.stringify(items));
  window.dispatchEvent(new CustomEvent("cart:updated"));
}

const CartContext = React.createContext<Ctx | null>(null);

export function CartProvider({ children }: { children: React.ReactNode }) {
  const [items, setItems] = React.useState<StoredItem[]>([]);
  const [open, setOpen] = React.useState(false);

  React.useEffect(() => { setItems(read()); }, []);

  React.useEffect(() => {
    const onUpdate = () => setItems(read());
    window.addEventListener("cart:updated", onUpdate);
    return () => window.removeEventListener("cart:updated", onUpdate);
  }, []);

  const totalCents = items.reduce((n, i) => n + i.qty * i.unitCents, 0);

  const add: Ctx["add"] = (item, qty = 1) => {
    const next = read();
    const idx = next.findIndex(x => x.id === item.id);
    if (idx >= 0) next[idx].qty += qty;
    else next.push({ ...item, qty });
    write(next);
    setOpen(true);
  };

  const setQty: Ctx["setQty"] = (id, qty) => {
    const next = read().map(i => i.id === id ? { ...i, qty } : i).filter(i => i.qty > 0);
    write(next);
  };

  const remove: Ctx["remove"] = (id) => write(read().filter(i => i.id !== id));
  const clear: Ctx["clear"] = () => write([]);

  const value: Ctx = { items, totalCents, add, setQty, remove, clear, open, setOpen };
  return <CartContext.Provider value={value}>{children}</CartContext.Provider>;
}

export function useCart() {
  const ctx = React.useContext(CartContext);
  if (!ctx) throw new Error("useCart must be used within CartProvider");
  return ctx;
}
