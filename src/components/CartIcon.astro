---
export interface Props {
  showLabel?: boolean; // set to true if you want the "Cart" text next to the icon
}
const { showLabel = false } = Astro.props;
---
<button
  class="nav-link cart-icon-btn"
  data-cart-open
  aria-label="Open cart (0 items)"
>
  <!-- Cart icon -->
  <svg class="ci" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M3 3h2l2.2 12.4a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.6L21 7H6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    <circle cx="10" cy="20" r="1.6"/><circle cx="18" cy="20" r="1.6"/>
  </svg>
  {showLabel && <span class="label">Cart</span>}
  <span class="badge" data-cart-count>0</span>

  <style>
    .cart-icon-btn{ position:relative; display:inline-flex; align-items:center; gap:8px; }
    .ci{ display:block; }
    .label{ font-weight:600; }
    .badge{
      position:absolute; top:-6px; right:-6px; min-width:18px; height:18px;
      padding:0 5px; border-radius:999px; background:#111; color:#fff; font-size:12px;
      display:inline-flex; align-items:center; justify-content:center; line-height:1;
      transform:translate(0,0); transition:transform .12s ease;
    }
    .cart-icon-btn:active .badge{ transform:translate(0,1px); }
  </style>

    <script is:inline>
    // Lightweight client script for live count + accessibility label
    (function(){
      const btn = document.currentScript.closest('button');
      const badge = btn.querySelector('[data-cart-count]');
      let count = 0;

      function render(n){
        count = Math.max(0, Number(n) || 0);
        badge.textContent = String(count);
        btn.setAttribute('aria-label', `Open cart (${count} item${count===1?'':'s'})`);
        // Hide badge when zero? Uncomment next line if desired:
        // badge.style.display = count>0 ? '' : 'none';
      }

      // Primary: listen for your cart system’s count broadcast
      window.addEventListener('cart:count', (e)=> render(e.detail?.count));

      // Fallbacks: if your cart doesn’t emit cart:count yet, bump on add/remove
      document.addEventListener('click', (e)=>{
        const add = e.target.closest('.add-to-cart');
        if(add){ render(count + 1); }
      });
      window.addEventListener('cart:remove', (e)=>{
        // If your remove event has {sku, qty}, decrease accordingly; default -1
        const delta = e.detail?.qty ? -Math.abs(e.detail.qty) : -1;
        render(count + delta);
      });

      // Optional: when drawer opens, you might recompute from storage/backend
      window.addEventListener('cart:open', ()=>{
        // If you keep the cart in localStorage, hydrate from there:
        try{
          const raw = localStorage.getItem('cart');
          if(raw){
            const cart = JSON.parse(raw);
            const c = Array.isArray(cart?.items) ? cart.items.reduce((a,it)=>a + (Number(it.qty)||0), 0) : 0;
            render(c);
          }
        }catch{}
      });

      // Initial render (try to hydrate once on load)
      try{
        const raw = localStorage.getItem('cart');
        if(raw){
          const cart = JSON.parse(raw);
          const c = Array.isArray(cart?.items) ? cart.items.reduce((a,it)=>a + (Number(it.qty)||0), 0) : 0;
          render(c);
        }
      }catch{}
    })();
  </script>
</button>
